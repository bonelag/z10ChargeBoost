#!/system/bin/sh
#
# vivo / iQOO 充电加速（跨平台：天玑 + 骁龙）
# 纯 userspace 实现，不修改任何分区 / 内核 / DT。
#
#  机型分流：
#    · 骁龙（iQOO13 V2408A / Neo10Pro+ V2463A）
#        主逻辑 = PMIC voter 判决层注入（force_active + force_val）
#        不使用 sysfs 申请层（fchg_fcc_ma），避免协议重协商掉档。
#    · 天玑（X200 Pro V2405A）
#        主逻辑 = sysfs 申请层（fchg_fcc_ma，本机无 voter 通道）
#        叠加防降流安全封顶。
#
#  用法：
#    vfcs_boost {start|stop|status|once|table|power|profile|factory
#                getjson|setcal|cells|probe|restore}
#
NODE="/sys/class/vfcs_class/fchg_fcc_ma"
LOG="/data/adb/v2352a_charge_boost.log"
PIDFILE="/data/adb/v2352a_charge_boost.pid"
PROFILE_FILE="/data/adb/v2352a_charge_boost.profile"

VOT_ORIG="/data/adb/v2352a_charge_boost.vot_orig"

LOCKDIR="/data/adb/v2352a_charge_boost.lock"

CACHE_FILE="/data/adb/v2352a_charge_boost.status.json"
CACHE_TMP="$CACHE_FILE.tmp"

# 「临时解除加速」标记（照 120w 模块的 paused 机制）。
#   存在 = 临时停手：守护把干预全部撤掉后空转（不退出、不写任何节点），
#   拔掉标记即立刻恢复。跨重启有效 —— service.sh / 看门狗都会尊重它。
#   与"恢复原厂"的区别：恢复原厂写 ACTIVE=3，是彻底停手且不再自动回来。
PAUSE_FLAG="/data/adb/v2352a_charge_boost.paused"

# ---------------- 参数 ----------------
TEMP_MIN=150
SOC_MIN=5
# ============================================================
#  ★★ v3536：停止介入电量（SOC_STOP）—— 可调 ★★
# ------------------------------------------------------------
#  【原来是什么】这里写死 SOC_MAX=90，模块在电量 >90% 时收手。
#  用户反馈希望能自己决定充到多少就让模块停手，所以改成可配置项：
#    · 可在 WebUI「高级 → 温控」页用滑动条调（40~100%）
#    · 存进 profile 的 SOC_STOP，守护热重载后立即生效
#    · 100 = 一直管到满（不设上限），交给系统按自己的策略收尾
#
#  【为什么本机语义是「不再写节点」而不是「降流」】
#    本机在 SOC 高档由 vivo cms 自己做降额（USER_FCC_EVENT），
#    模块在这个区间继续钉 14100 反而会和系统打架。
#    所以超过 SOC_STOP 时模块只是【撒手不写】，把控制权交回系统 ——
#    这不是限速，是让系统按它自己的曲线收尾。
#    实测：SOC 94% 时模块收手，充电仍继续（由系统按 9034mA 自然降额）。
#
#  【上下限为什么是 40~100】
#    · 低于 40 意味着刚过半就撒手，等于模块基本没用（但仍允许，用户自由）
#    · 100 表示一直管到满；满电后系统自己会转涓流，模块的申请值届时
#      也会被 cms 的 USER_FCC_EVENT 压住，不会硬冲
# ============================================================
SOC_MAX=90
# ★ v3541：出厂默认停止线（只读常量，用于判断用户有没有改过）。
#   why_inactive 靠它区分「用户自己设的停止线」与「出厂保护上限」，
#   两种情况该说的文案完全不同。改 SOC_MAX 默认值时这里要同步。
SOC_DEFAULT_MAX=90
#   有效区间的下界（低于此值模块也不管，交给涓流）。一般不用改。
SOC_STOP_MIN=40
SOC_STOP_MAX=100
# ★ v3525：SOC 分段回归原版五段平铺（70/80/86/89 是旧的分段边界）

TB_WARN=650
TB_CAP_A=700
TB_CAP_B=750
TB_RELEASE=790
TB_RECOVER=600

TC_WARN=405
TC_CAP_A=410
TC_CAP_B=420
TC_RELEASE=430
TC_RECOVER=390

# 电池侧阈值的出厂副本：温控开关切换时用来复原。
#   为什么需要副本：therm_sync 会把 TC_* 推到 9999 来"关掉"这一路，
#   再次开启时必须能恢复原值；直接硬编码会导致两处常量不一致。
TC_WARN_F=405
TC_CAP_A_F=410
TC_CAP_B_F=420
TC_RELEASE_F=430
TC_RECOVER_F=390

TEMP_RECOVER_SEC=20

CAP_A=9720
CAP_B=5765

TEMP_WARN=$TB_WARN
TEMP_CAP_A=$TB_CAP_A
TEMP_CAP_B=$TB_CAP_B
TEMP_RELEASE=$TB_RELEASE
TEMP_RECOVER=$TB_RECOVER

TEMP_HIST_N=3

SOC_T1=70
SOC_T2=80
SOC_T3=86
SOC_T4=89

# 分段电流：五段【默认全平 14100】
#   为什么全平：降流是【系统】的策略，不是模块的职责。
#     fchg_fcc_ma 只是"申请额度"，实际电流由系统按 SOC/温度二次裁定。
#     模块自己先按 SOC 降一档，等于把系统的降流提前了（双重降流）。
#     所以默认五段都给同一个上限，只申请、不替系统做降流决策。
#  ★ v3515 方案 B：默认值【不再写死数字】，而是运行时从本机 DT 派生。
#
#     · 默认（CAL_OC=0）：五段 = 本机 DT 值 14100
#     · 超频（CAL_OC=1） ：五段 = 15600
#     · 两者都由下面的 I_FALLBACK 兜底，再由 load_profile → apply_defaults
#       在启动时按 cal_max() 覆盖成实际值。
#
#   【为什么把写死的 15600 拿掉】
#     15600 是上游通用版针对其他机型（X200 Pro / K80 Ultra）的常量，不是本机标定。
#     写死在变量初值里会让"本机 DT 14100"永远读不到，
#     表现为段位表默认值凭空高出 1500mA，且无法与用户主动选择区分。
#   【I_FALLBACK 只是初值占位】真正的默认值由 apply_defaults 用 cal_max() 填，
#     这里给 14100 是为了在"profile 文件存在且用户设过值"时不误伤。
#   用户仍可在 WebUI 段位表里改低（省电 / 控温）。
I_FALLBACK=14100
#   ★ v3530：分段值统一改为本机 DT 标定 14100（与总闸一致）
#
#   【为什么】注入时是 _vot_ib = min(cur_set, vot_calc())，
#   即 min(分段值, 总闸×温度降额)。两者必须同源，否则永远一方压另一方。
#   本机 calDt = 14100，于是分段也设 14100：
#     实际注入 = min(14100, 14100×降额) = 14100×降额 ✔
#
#   【仍然保留分段机制】用户若把某一段设低（如 8000），min() 会取更低值，
#   用于"低电量段也想慢充"的场景。
I_LOW=14100
I_MID=14100
I_PEAK=14100
I_MID2=14100
I_LOW2=14100

# ★ v3525 对齐原版（x200pro_charge_boost_v3.5.11）的注入模型：
#   原版五段全平 11500，但【总闸 IBAT_DEFAULT=9000】才是真正的注入基准，
#   实际注入值 = min(分段电流, 总闸 × 温度降额)。
#
#   原版注释原文（v3.5.8）：
#     "v3.5.7 曾把总闸抬到 11500，而注入值本身就是『总闸×温度降额』，
#      等于把注入电流整体抬高 28%（实测效果反而不如 v3.5.3）——
#      电流越高越容易触发系统的降流/协议重协商反击。"
#
#   【本机实测佐证 2026-10-21】同一分钟内单变量：
#     fa=0 无注入      -> 电池 2.19A / 输入 9.0W
#     8190（原版公式） -> 电池 5.57~5.79A / 输入 27.0W  最稳
#     9000（总闸原值） -> 电池 5.60~5.68A / 输入 26.8W  稳
#     15600（旧硬编码）-> 电池 5.69~5.75A / 输入 27.8W  略抖
#   三者功率接近，但原版值电池电流最稳、温度最低 ——
#   印证原版注释：推高没有收益，只会招来系统反击。

# 阶梯格式版本：配置文件里存的是旧版阶梯（按 SOC 预降、激进档 15600 起）时，
#   自动作废并回落到新默认，避免"改了代码默认值但机器上仍跑旧值"。
# ---- 功率封顶 ----
#  ★ v3514：默认【关闭本层】（POWER_CAP_W=0），避免成为空转的死代码。
#
#  【为什么关掉】本层算法：允许电流 = POWER_CAP_W × 1000000 / 电池电压(mV)。
#    本机 vfloat=4450mV，于是：
#        80W → 17977mA
#        69W → 15505mA
#        62W → 13932mA
#    而软件上限 cal_max() = 15600mA。
#    POWER_CAP_W=80 时本层算出 17977 > 15600，【永远轮不到它生效】——
#    clamp 链里是一条空转规则，只会让人误以为"80W 在保护你"。
#
#  【现在谁在管电流】四者取最小：
#    ① 电量分段值 I_LOW..I_LOW2（默认 15600）
#    ② 电流总闸 IBAT_DEFAULT（15600）
#    ③ 软件上限 cal_max()（15600）
#    ④ 温度降额：由 therm_fold_n() 整档下跳 + therm_cap() 硬封顶实现
#       实际动作是 14100 -> 11720 -> 9720 / 5765，【不是】百分比曲线。
#       （历史注释曾写 97/91/81/72/63%，代码从未实现过，已作废。）
#    温度保护完全不受影响，高温照样逐级降流。
#
#  【想重新启用】把 POWER_CAP_W 设成小于 69 的数（如 60），
#    本层立刻生效，日志里会出现"功率封顶"记录。设 0 = 关闭（默认）。
#  【血泪】早期版本误用输入侧电压(chg_voltage/20V) 折算，
#    结果被缩小 4~5 倍、被下限夹住，表现为"电流锁死在 4000mA"。
POWER_CAP_W=0
POWER_CAP_MIN=4000

LADDER_VER=2
LADDER_MIGRATE=1
#   电流总闸默认值（mA）。注入值 = min(分段电流, 总闸×温度降额)。
#   ★ v3.5.8 曾把默认改回 9000。原因：v3.5.7 把它抬到 11500 后，
#   注入值本身就是"总闸×温度降额"，等于整体抬高 28%，实测反而不如
#   v3.5.3 —— 电流越高越容易触发系统的降流/协议重协商反击。
#
#   ★★ v3515 方案 B：总闸默认值改为【运行时跟随 cal_max()】★★
#
#     · 默认（CAL_OC=0）：总闸 = 本机 DT 14100
#     · 超频（CAL_OC=1） ：总闸 = 15600
#   这里写 14100 只是初值占位，真正生效值由 load_profile 里的
#   IBAT_VER 迁移/对齐逻辑按 cal_max() 填充。
#
#   【为什么不再写死 15600】理由同上：15600 是上游通用版对 X200 Pro / K80 Ultra
#   的常量，不是本机标定。写死会让"总闸默认值"凭空高出 1500mA。
#   温度降额照常生效：高温时按整档下跳（14100 -> 11720 -> 9720 / 5765），
#   不是百分比曲线（历史注释的 100/97/91/81/72/63% 从未实现，已作废）。
#   想收窄：改小这个值即可（WebUI 里也能改）。
#   ★ v3530：改回本机 DT 标定 14100。
#     【依据】本机 /sys/class/cms_class/vfloat_voltage = 4450mV，
#     calDt = 14100，且 DCHG_FCC 的硬件默认额度就是
#     FCHG_DEFAULT_EVENT v=14100 —— 14100 是【本机自己声明的额度】，
#     不是外来常量。9000 是其他机型（X200 Pro）设定的值，对本机只用到 64%。
#     理论换算：14100 × 4.45V = 62.7W 电池侧。
IBAT_DEFAULT=14100
#   ★ 上一版（v3.5.7）用过的总闸默认值。仅用于识别"那一版自动抬上去的
#   值"，不参与任何注入计算。
IBAT_PREV_DEFAULT=11500
#   总闸默认值版本。
#     v1：默认 9000 → 11500，旧配置【只抬不降】。
#     v2：默认 9000。规则改为【只回退，不主动改用户的设置】。
#     v3：默认 14100（本机 DT 上限）。
#     v5：默认回归原版 9000（v3525）。【放弃跟随 cal_max()】
#         理由（原版注释 + 本机实测双证）：
#           · 注入值本身就是"总闸×温度降额"，跟随 cal_max() 意味着
#             永远顶在硬件最大电流上跑 —— 原版注释明言这会触发系统的
#             降流/协议重协商反击；本机实测也验证了 8190/9000/15600
#             三者功率几乎相同，但 9000 最稳、温度最低。
#           · 所以总闸不该等于上限，它是一个"申请额度"。
#         迁移规则：
#         ① IBAT_VER<=4 且值 ∈ {14100,15600} → 判定为历史版本顶到上限的
#            自动值，回退到新默认 9000
#         ② 其余值（含用户手动改过的、如 11500/8000）→ 一律保留，不动
#         ③ 无标记 → 用新默认
#
#     v6（v3530）：默认改回【本机 DT 标定 14100】。
#         理由：
#           · 14100 不是外来常量 —— 本机 calDt=14100，且充电 IC 的
#             默认额度就是 FCHG_DEFAULT_EVENT v=14100。用满它是合法的。
#           · 9000 是其他机型（X200 Pro）的值，对本机只用到 64%（40W/62.7W）。
#           · v5 说的"推高会招来系统反击"是实测结论，但那个实测的前提
#             是充电器只给 9V 档 —— 输入侧被锁死，所以看不出差异。
#             若充电器能给 11V/7A，14100 才有意义。两种情形都覆盖。
#         迁移规则（与 v5 相反）：
#         ① IBAT_VER<=5 且值恰为 9000 → 判定为 v5 的旧默认，抬到 14100
#         ② 其余值（用户手改过的，如 11500/8000/6400）→ 一律保留，不动
#         ③ 无标记 → 用新默认 14100
IBAT_VER=6
IBAT_MIGRATE=0
PROFILE_LOADING=0
MIGRATING=0

SAFE_SOC_T1=55
SAFE_SOC_T2=65
SAFE_LOW=6400
SAFE_MID=6000
SAFE_HIGH=5800
SAFE_DROP_STEP=400
SAFE_LOCK_SEC=30

# 实测有效的电流台阶列表（WebUI "可用档位参考"）。
#   ★ v3515：15600 从"默认推荐"降级为"超频档"—— 它属于跨机型通用常量，
#   本机 DT 标定是 14100。列表里保留它，是因为超频档下它确实可写；
#   但 WebUI 会把它标成"超频"而非默认值。
# ★ v3539：去掉 15600。
#   15600 是其他机型（X200 Pro / K80 Ultra）的常量，本机（V2352A）DT 标定是
#   14100。列表里的 15600 只会带来两个坏处：
#     · 本机点它一定越界（输入框 max=14100），点了就标红，纯干扰
#     · 每行 7 个药丸在窄屏上必然折两行，把表格撑得很高
#   超频档（CAL_OC=1）时 cal_max() 会自动算出 15600，输入框上限跟着放宽，
#   用户直接手填即可 —— 这个参考药丸不再是唯一的入口，去掉不损失能力。
VALID_CURRENTS="4765 5765 7720 9720 11720 14100"

# ★ v3513 上限口径重构（本机适配）
#
# 【问题】上一版把 cal_max() 直接绑到 DT 的 vivo,fchg-curr-max-ma（本机 14100），
#   于是：
#     · 段位表 / 总闸 / 封顶的输入上限全被压到 14100
#     · 用户在段位框里填 15600 立刻被标红「超出 0~14100」
#     · CAL_MAX=15600 这个常量变成死代码，永远读不到
#   但实测（2026-10-21，DCHG_FCC/force_val）：
#     echo 15600 > force_val  -> readback 15600   ✅ 通道接受
#     echo 20000 > force_val  -> readback 20000   ✅ 通道不裁剪
#   也就是说 14100 是【驱动 DT 声明的默认档位】，不是硬件拒绝写入的硬墙；
#   判决层是强制通道，写多少就生效多少。原版对 X200 Pro / K80 Ultra
#   用的 15600 在那些机器上可用，说明这个"软件上限"本来就该由用户说了算。
#
# 【v3515 方案 B：默认本机值 + 可选超频档】
#
#   ★★ 重要更正（2026-10-21 实测）★★
#   15600 这个数字【不是本机的】，它是上游通用版针对 X200 Pro / K80 Ultra 写死的常量。
#   本机（iQOO Z9 Turbo / V2352A）DT 实测：
#       /sys/firmware/devicetree/base/soc/vfcs/vivo,fchg-curr-max-ma
#       原始字节 0 0 55 20 = 14100
#   上一版把 cal_max 抬到 max(14100, 15600) = 15600，
#   等于让外来值覆盖了本机标定 —— 本次改为：
#
#     · 默认  cal_max = 本机 DT 值（14100）        ← 保守，有实测依据
#     · 可选  cal_max = max(DT, CAL_OC_MAX)       ← 仅当 CAL_OC=1 时
#
#   【超频档是什么】pmic-votable 的 DCHG_FCC 是强制通道，实测写入 15600
#   回读 15600、写入 20000 回读 20000，通道本身不做裁剪。
#   但"通道收下这个数" ≠ "充电 IC 真按这个数交付"：
#     · DT 标 14100 是厂商标定的设计上限
#     · 实际能否跑高还取决于充电器协议、电池电压天花板、驱动内部限流
#   所以 CAL_OC 默认关闭，界面上明确标红「超出本机 DT 标定，风险自负」。
#
#   【想要 80W 就必须开它】14100mA × 4.45V = 62.7W 电池侧 ≈ 70W 输入侧；
#   15600mA × 4.45V = 69.4W 电池侧 ≈ 77W 输入侧（按 90% 效率）。
CAL_OC=0                 # 超频档开关：0=只用本机 DT 值，1=允许到 CAL_OC_MAX
CAL_OC_MAX=15600         # 超频档允许的最高电流（跨机型通用常量，非本机标定）
# ★ v3515：兜底值也改成本机 14100（原来是 15600）。
#   兜底只在「DT 完全读不到」时触发；此时没有任何本机依据，
#   取本机标定值 14100 比取外来 15600 更保守。
#   实测验证：DT 为空时 cal_max() = 14100；超频档下仍可到 15600。
CAL_MAX=14100            # 兼容保留：DT 完全读不到时的最后兜底值
# 绝对上限保护线：任何情况下都不允许超过它。
#   20000 是 PMIC 判决层能接受的最大量级（实测 20000 可写入），
#   再高就纯属误填，没有物理意义。
CAL_ABS_HARD=20000
CAL_MAX_CACHE=""
CAL_DT_MAX_CACHE=""

# ---- 温控参数（WebUI 可调，不再写死）----
#   THERM_EN    : 温控总开关（1=启用 0=关闭）
#   THERM_START : 开始降流的板级温度（0.1C）—— 达到后按阶梯降档
#   THERM_STOP  : 停止干预的板级温度（0.1C）—— 达到后完全交回系统
#   中间档由 THERM_START/THERM_STOP 线性派生，保证单调。
THERM_EN=1
THERM_START=650          # 65.0C 开始降流
THERM_STOP=790           # 79.0C 停止干预

# ---- 防掉档安全封顶（WebUI 可调）----
#   SAFE_EN     : 防降流/防掉档总开关
#   SAFE_CAP    : 叠加在 SOC 表之上的电流天花板（0=不用本层）
SAFE_EN=1
SAFE_CAP=0               # 0 = 按机型默认反推（见 load_safe_table）

# ---- 设备类别（运行期探测，见 dev_class）----
#   qcom = 骁龙（注入判决层为主逻辑）
#   mtk  = 天玑（sysfs 申请层 + 防降流）
DEV_CLASS=""
DEV_MODEL=""

# DT 声明的电流上限（只读参考值，不做钳制用）
#   本机实测三条：
#     vivo,fchg-curr-max-ma      14100  普通闪充
#     vivo,pps-fchg-curr-max-ma  10000  PPS
#     vivo,ufcs-fchg-curr-max-ma  8000  UFCS
#   cal_max() 取的是第一条（普通闪充通道），这是实际注入时走的通道。
cal_dt_max() {
	local v
	[ -n "$CAL_DT_MAX_CACHE" ] && { echo "$CAL_DT_MAX_CACHE"; return 0; }

	v=$(dt_cur_max 2>/dev/null)
	case "$v" in
		''|*[!0-9]*) v="" ;;
		*)
			if [ "$v" -lt "$CAL_DANGER" ] || [ "$v" -gt "$CAL_ABS_HARD" ]; then
				v=""
			fi
			;;
	esac

	# 【关键】读不到 DT 就返回空，绝不拿 CAL_MAX 顶替 ——
	#   否则 cal_max() 里的 max(dt, CAL_MAX) 会变成 max(CAL_MAX, CAL_MAX)，
	#   永远无法分辨"DT 真的说了 15600"和"读不到所以编了一个"。
	#   调用方（cal_max）已经各自处理了空值。
	CAL_DT_MAX_CACHE="$v"
	echo "$v"
}

cal_max() {
	local v dt
	[ -n "$CAL_MAX_CACHE" ] && { echo "$CAL_MAX_CACHE"; return 0; }

	# ★ v3515 方案 B：默认只信本机 DT，超频档需显式 CAL_OC=1
	#
	#   分三种情形：
	#     ① DT 可读 + CAL_OC=0  → v = DT            （本机 14100，默认）
	#     ② DT 可读 + CAL_OC=1  → v = max(DT, OC)   （本机 15600，超频）
	#     ③ DT 读不到           → v = CAL_MAX       （兜底，极少发生）
	#
	#   注意 dt_cur_max 内部只做「能读就返回」的粗过滤，这里再统一夹一次，
	#   保证无论如何都不会把越界的脏值喂给下游的 clamp。
	dt=$(cal_dt_max 2>/dev/null)
	case "$dt" in ''|*[!0-9]*) dt="" ;; esac

	if [ -n "$dt" ]; then
		v="$dt"

		# 超频档：只有明确打开才允许越过本机 DT 标定
		if [ "$CAL_OC" = "1" ]; then
			local _oc="$CAL_OC_MAX"
			case "$_oc" in ''|*[!0-9]*) _oc="" ;; esac
			if [ -n "$_oc" ] && [ "$_oc" -gt "$v" ]; then
				v="$_oc"
			fi
		fi
	else
		# 读不到 DT：不编造，用 CAL_MAX 兜底并记录（WebUI 会显示 calDt=null）
		v="$CAL_MAX"
		case "$v" in ''|*[!0-9]*) v=14100 ;; esac
	fi

	# 绝对保护线：任何情形都不允许超过
	[ "$v" -gt "$CAL_ABS_HARD" ] && v="$CAL_ABS_HARD"
	# 脏值保护（比危险阈值还小说明读错了）
	case "$v" in
		''|*[!0-9]*) v="$CAL_MAX" ;;
		*) [ "$v" -lt "$CAL_DANGER" ] && v="$CAL_MAX" ;;
	esac

	CAL_MAX_CACHE="$v"
	echo "$v"
}

cal_max_refresh() {
	CAL_MAX_CACHE=""
	CAL_DT_MAX_CACHE=""
	cal_max >/dev/null 2>&1
}

CAL_DANGER=3000

ACTIVE=1
PROFILE_NAME="激进"
PROF_FP=""

SEG_LOW_NAME="超档";  SEG_MID_NAME="高档"
SEG_PEAK_NAME="峰值"; SEG_MID2_NAME="中档"
SEG_LOW2_NAME="低档"

RESTORE_MA=9720

restore_ma() {
	local cap=$RESTORE_MA
	local m
	m=$(cal_max 2>/dev/null)
	case "$m" in ''|*[!0-9]*) m="" ;; esac
	if [ -n "$m" ] && [ "$m" -gt 0 ] && [ "$cap" -gt "$m" ]; then

		if [ "$m" -lt "$CAL_DANGER" ]; then
			:
		else
			cap="$m"
		fi
	fi
	echo "$cap"
}

ORIG_FILE="/data/adb/v2352a_charge_boost.orig"

DT_BASE=""

DT_CUR_MAX_NODE="/sys/firmware/devicetree/base/vfcs/vivo,fchg-curr-max-ma"
DT_CUR_MAX_NODES="
/sys/firmware/devicetree/base/vfcs/vivo,fchg-curr-max-ma
/sys/firmware/devicetree/base/soc/vfcs/vivo,fchg-curr-max-ma
/sys/firmware/devicetree/base/vivo,fchg-curr-max-ma
"

# ★ v3569：BASELINE_SEGS 写死常量已删（SOC 边界不再硬编码，
#   原厂档(3)直接 exit 0 不干预，这段永远用不到）
BASELINE_SEGS_AUTO=""

ORIG_FILE="/data/adb/v2352a_charge_boost.orig"
MOD_WROTE=0

INTERVAL=2
# ★ v3543：未插电时的轮询间隔。
#   【为什么需要】原来不管插不插电都是 2 秒一轮，而每轮要 do_once + refresh_cache，
#     实测一轮约 1.6 秒 CPU 时间 —— 也就是说守护进程在【没插电】时也常年
#     占着 70%~80% 的 CPU，用户侧感受就是"放着不动手机也发烫、掉电快"。
#     但未插电时模块本来就什么都做不了（do_once 读到 online=0 立刻 return 4），
#     唯一需要及时感知的是"插上线"这个事件，2 秒和 10 秒的差别用户根本感受不到
#     （Android 系统自己检测到插电也要一两秒才更新状态栏）。
#   【取值】10 秒。插电后第一轮就会切回 INTERVAL(2s) 全速介入，
#     拔电后同样切回 10 秒。省下的是 80% 的空转 CPU。
# ★★★ v3567：深度休眠间隔 ★★★
#   有了零 fork 的插电判定后，未插电时每轮只做 1 次内建 read，
#   所以间隔可以放到很大而不影响响应速度（插电最多 10 秒被发现（短路径零 fork，成本约等于 0），
#   系统状态栏本身也要一两秒才更新，用户体感不出来）。
# ★★★ v3569：统一间隔常量 ★★★
#   INTERVAL      正在干预时的节奏（必须快，60W 大电流需要及时响应热点）
#   INTERVAL_IDLE 未插电 / SOC 超范围时的节奏 —— 此时模块无事可做。
#                 用户要求 10s → 20s。经过 v3568 的零 fork 改造后，
#                 每轮只有 1 次内建 read + 1 次 sleep，
#                 单轮成本约 31ms（sleep 的 fork+exec），20s 折合 0.155%。
INTERVAL_IDLE=20
# ★ v3572：status.json 缓存刷新间隔（单位：主循环轮数）
#   插电时 INTERVAL=2 秒，CACHE_EVERY=5 即 10 秒一次。
#   原来是 1（每轮），单 emit_json 就要 1160ms，
#   是插电时 43% CPU 的主要来源。
CACHE_EVERY=5
CACHE_TICK=0
INTERVAL_DEEP=20

# ★ 返回当前应该睡多久（写全局变量，零 fork）
SLEEP_NOW=2
interval_now() {
	case "$1" in
		4|5) SLEEP_NOW="$INTERVAL_IDLE" ;;   # 未插电 / SOC 超范围
		*)   SLEEP_NOW="$INTERVAL" ;;
	esac
	return 0
}
STABLE_N=2
CHG_CONFIRM=3
IBAT_MIN=300000
# v3.5.11：电流读数绝对上限（µA）。任何单位解释下都不可能超过 6A
# （覆盖到 6.5A 的私有协议机型），用于消解 mA/µA 的歧义区。
IBAT_ABS_MAX=6000000
WRITE_VERIFY=1
CHG_OK_CNT=0

THERM_STATE=0
THERM_TB_HIST=""
THERM_TC_HIST=""
THERM_TB_MED=0
THERM_TC_MED=0

THERM_TEMP_HIST=""
THERM_TEMP_MED=0
THERM_RECOVER_T=0
THERM_LAST_LOG=""

LOG_MAX_BYTES=262144   # 256KB。超过就改名保留一份 .1（不删除，避免多一次 fork）
LOG_SZ_CHECKED=0       # 同一进程内最多检查一次大小：stat 每 2 秒跑一次太浪费

# ★ v3517：日志总开关（1=记录 0=不记录）
#   由 profile 里的 LOG_EN 驱动，可在 WebUI 一键切换。
#   关闭后 log() 立刻 return，连一次 echo 重定向都不做。
LOG_EN=1

# ★ v3519：实时读取 profile 里某一项布尔开关（0/1）的真实值。
#   【为什么需要这个函数】
#     守护进程把 CAL_OC / LOG_EN 这类开关缓存在内存变量里，只在
#     load_profile 时刷新。而 load_profile 有重入保护（PROFILE_LOADING=1
#     时直接 return），do_once 执行期间可能长期处于"已置位"状态 ——
#     此时任何 load_profile 都是空操作，内存值会停在旧值，于是：
#       · emit_json 把旧值写进 status.json → 前端轮询读到旧值 → 界面弹回
#       · log() 用旧的内存值判断 → 关了日志还在写，开了反而不写
#
#   【修法】凡是"开关类"状态，一律不看内存，直接读 profile 现读。
#     代价：一次读 20 行小文件 + 一次循环，约 1~2ms，
#     相对每轮几百毫秒的 do_once 完全可忽略。
#     收益：磁盘是唯一权威来源，从根本上消灭"内存与磁盘不一致"的窗口。
#
#   用法：_prof_flag CAL_OC 1   → 输出 1 或默认值
# ★ v3543：一次性把 profile 里所有「0/1 开关」读进全局变量。
#   【为什么】emit_json 里原来有 2 次 $( _prof_flag CAL_OC ) / $( _prof_flag LOG_EN )，
#     每次 fork 一个子 shell（要把 6000 行脚本再解析一遍），实测各 ~40ms。
#     这里改成同 shell 内的一遍 while read，几个值一起拿到，零 fork。
PLF_CAL_OC="0"
PLF_LOG_EN="1"
PLF_SAFE_EN="1"
PLF_THERM_EN="1"
prof_live_flags() {
	PLF_CAL_OC="0"; PLF_LOG_EN="1"; PLF_SAFE_EN="1"; PLF_THERM_EN="1"
	[ -f "$PROFILE_FILE" ] || return 0
	local _k _v
	while IFS='=' read -r _k _v; do
		case "$_v" in 0|1) ;; *) continue ;; esac
		case "$_k" in
			CAL_OC)   PLF_CAL_OC="$_v" ;;
			LOG_EN)   PLF_LOG_EN="$_v" ;;
			SAFE_EN)  PLF_SAFE_EN="$_v" ;;
			THERM_EN) PLF_THERM_EN="$_v" ;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null
	return 0
}

_prof_flag() {
	local _pf_key="$1" _pf_def="${2:-0}" _pf_k _pf_v
	if [ -f "$PROFILE_FILE" ]; then
		while IFS='=' read -r _pf_k _pf_v; do
			[ "$_pf_k" = "$_pf_key" ] || continue
			case "$_pf_v" in
				0|1) echo "$_pf_v"; return 0 ;;
			esac
			break
		done < "$PROFILE_FILE" 2>/dev/null
	fi
	echo "$_pf_def"
}

log() {
	# ★ v3517：日志总开关。
	#   LOG_EN=0 时直接返回，不写任何文件、不做轮转检查 —— 完全不产生 IO。
	#   默认 1（开启）：调试期需要日志定位问题，关掉反而难排查。
	#   用户可在 WebUI「首页」最下方的调试卡里一键关闭。
	#   注意：这个开关只影响 log() 的落盘，不影响 debugdump / logdump
	#   这类【用户主动触发】的诊断输出 —— 那些是一次性命令，不算后台日志。
	#
	#   【权威来源】LOG_EN 一律以 profile 为准，每次调用都现读，不用内存缓存。
	#     原 v3517 实现只在【首次】log() 时读一次 profile（LOG_EN_LOADED
	#     标记），之后终身不再读 —— 守护进程启动后你在 WebUI 关掉日志，
	#     log() 完全感知不到，照样往磁盘写；反过来打开也不生效。
	#     现读代价约 1~2ms，而 log() 本身最多每轮写一行，完全可接受。
	local _log_en_live
	_log_en_live=$(_prof_flag LOG_EN 1)
	[ "$_log_en_live" = "0" ] && return 0

	# ---- v3.5.11：日志轮转 ----
	#   旧版只有 >> 追加，守护每 2 秒最多写一行，长期不卸载的话
	#   /data/adb 下的日志会无上限增长（用户往往几个月才卸一次）。
	#   这里做最轻量的一次性轮转：超 256KB 就把当前文件挪成 .1。
	#   只保留一份，不做按天分桶 —— 那需要外部命令，代价不值当。
	if [ "$LOG_SZ_CHECKED" != "1" ]; then
		LOG_SZ_CHECKED=1
		# ★ v3515：文件不存在时 `wc -c < "$LOG"` 会往 stderr 吐
		#   "can't open ...: No such file or directory"，插进 debugdump 输出里很难看。
		#   先判存在再读，避免这条噪音。
		if [ -f "$LOG" ]; then
			_sz=$(wc -c < "$LOG" 2>/dev/null)
			case "$_sz" in
				''|*[!0-9]*) ;;
				*)
					if [ "$_sz" -gt "$LOG_MAX_BYTES" ]; then
						mv -f "$LOG" "$LOG.1" 2>/dev/null
					fi
					;;
			esac
			unset _sz
		fi
	fi
	# ★ 调试版：/data/adb 下若因权限或首次运行尚无写权限，
	#   `>> "$LOG"` 会把 "can't open ...: No such file or directory"
	#   打到 stderr —— 在 debugdump 里会插进输出中间，很碍眼。
	#   这里补 2>/dev/null 静默掉，日志本身该写还是写。
	echo "$(date '+%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
}

# ---------------- 读取系统状态 ----------------
# ★ v3543：无 fork 文件读取。
#   【为什么要有它】本机实测：$(cat file) 单次 13.9ms，read -r var < file 单次 0.7ms
#     —— 差 20 倍。原因不是磁盘慢（sysfs 全在内存），而是每个 $(...) 都要
#     fork 一个子进程再 exec cat，固定开销远大于真正读取。
#     守护进程每 2 秒跑一轮，一轮里 read_* 系列累计几十次 $(cat)，
#     折算 emit_json 单次 1417ms / 22MB / 1.1 万次 syscall，常驻 CPU 70%。
#     用户感受：没插电、手机却一直发烫。
#   【用法】rf FILE VAR [默认值]
#     读成功把结果放进 VAR（调用前请先 local），失败或非预期格式放默认值。
#     它不 fork、不写 stdout，只是同 shell 内的赋值。
rf() {
	local _rf_f="$1" _rf_v="$2" _rf_d="$3" _rf_t=""
	if [ -r "$_rf_f" ]; then
		read -r _rf_t < "$_rf_f" 2>/dev/null
	fi
	case "$_rf_t" in
		''|*[!0-9-]*) eval "$_rf_v=\"\$_rf_d\"" ;;
		*) eval "$_rf_v=\"\$_rf_t\"" ;;
	esac
}

# ★ v3543：无 fork 的纯文本读取（允许任意字符），用于 status/name 类节点。
#   与 rf 的区别：rf 只接受数字，本函数原样返回去掉首尾空白的文本。
rfs() {
	local _rfs_f="$1" _rfs_v="$2" _rfs_d="$3" _rfs_t=""
	if [ -r "$_rfs_f" ]; then
		read -r _rfs_t < "$_rfs_f" 2>/dev/null
	fi
	if [ -z "$_rfs_t" ]; then
		eval "$_rfs_v=\"\$_rfs_d\""
	else
		eval "$_rfs_v=\"\$_rfs_t\""
	fi
}

read_soc() {
	# ★ v3543：read 内建替代 $(cat)，避免 fork（13.9ms → 0.7ms）。
	local v=""
	read -r v < /sys/class/power_supply/battery/capacity 2>/dev/null
	case "$v" in
		''|*[!0-9]*) echo "" ;;
		*) echo "$v" ;;
	esac
}

f10s() {
	case "$1" in ''|*[!0-9]*) echo "—" ;; *)
		echo "$(($1 / 10)).$(($1 % 10))" ;;
	esac
}

f10() {
	echo "$(($1 / 10)).$(($1 % 10))"
}

_norm_temp() {
	local v="$1"
	case "$v" in
		''|*[!0-9-]*) echo ""; return ;;
	esac

	[ "$v" -le 0 ] && { echo ""; return; }
	if [ "$v" -gt 10000 ]; then
		echo "$((v / 100))"
	elif [ "$v" -gt 1000 ]; then
		echo "$((v / 10))"
	elif [ "$v" -gt 200 ]; then
		echo "$v"
	else
		echo "$((v * 10))"
	fi
}

BOARD_ZONE_CACHE=""
BOARD_ZONE_STATE=""
BOARD_ZONE_TRIES=0
BOARD_ZONE_MAXTRY=5

BOARD_CMS_TEMP_NODES="
/sys/class/cms_class/primary_board_temp
/sys/class/power_supply/battery/primary_board_temp
/sys/class/cms_class/board_temp
/sys/class/power_supply/battery/board_temp
"

BOARD_TYPE_EXACT="bat_board1_ntc bat_board_ntc board_ntc charger_ntc chg_ic_therm chg_therm board_therm primary_board_temp parallel_board_temp"

BOARD_TYPE_FUZZY="bat_board board_temp board_therm sub_board_therm ap_therm btb chg_ic_therm charger_ntc chg_therm quiet_therm usb-therm usb_conn"

_board_zone_by_type() {
	local z t k p

	for p in $BOARD_CMS_TEMP_NODES; do
		[ -r "$p" ] || continue

		[ -n "$(_norm_temp "$(cat "$p" 2>/dev/null)")" ] || continue
		echo "$p"; return 0
	done

	# ---- ② 精确匹配 ----
	for k in $BOARD_TYPE_EXACT; do
		for z in /sys/class/thermal/thermal_zone*; do
			[ -d "$z" ] || continue
			t=$(cat "$z/type" 2>/dev/null)
			[ "$t" = "$k" ] || continue
			[ -r "$z/temp" ] || continue

			[ -n "$(_norm_temp "$(cat "$z/temp" 2>/dev/null)")" ] || continue
			echo "$z/temp"; return 0
		done
	done

	# ---- ③ 模糊子串匹配 ----
	for k in $BOARD_TYPE_FUZZY; do
		for z in /sys/class/thermal/thermal_zone*; do
			[ -d "$z" ] || continue
			t=$(cat "$z/type" 2>/dev/null)
			case "$t" in
				*"$k"*) ;;
				*) continue ;;
			esac
			[ -r "$z/temp" ] || continue
			[ -n "$(_norm_temp "$(cat "$z/temp" 2>/dev/null)")" ] || continue
			echo "$z/temp"; return 0
		done
	done

	for z in thermal_zone50 thermal_zone45 thermal_zone43; do
		p="/sys/class/thermal/$z/temp"
		[ -r "$p" ] || continue
		t=$(cat "/sys/class/thermal/$z/type" 2>/dev/null)
		[ -n "$t" ] || continue

		case "$t" in
			*bat_board*|*board_ntc*|*board_therm*|*btb*|*charger_ntc*|*chg_ic*|*chg_therm*)
				;;
			*)

				continue
				;;
		esac

		[ -n "$(_norm_temp "$(cat "$p" 2>/dev/null)")" ] || continue
		echo "$p"; return 0
	done

	return 1
}

_board_zone_ensure() {
	[ "$BOARD_ZONE_STATE" = "ok" ] && return 0

	if [ "$BOARD_ZONE_STATE" = "fail" ]; then
		[ "$BOARD_ZONE_TRIES" -ge "$BOARD_ZONE_MAXTRY" ] && return 1
		BOARD_ZONE_TRIES=$((BOARD_ZONE_TRIES + 1))
	else
		BOARD_ZONE_TRIES=$((BOARD_ZONE_TRIES + 1))
	fi

	local p
	p=$(_board_zone_by_type)
	if [ -n "$p" ]; then
		BOARD_ZONE_CACHE="$p"
		BOARD_ZONE_STATE="ok"
		return 0
	fi
	BOARD_ZONE_STATE="fail"
	return 1
}

read_temp_board() {
	local f v r

	if _board_zone_ensure; then
		# ★ v3543：read 内建。
		v=""; read -r v < "$BOARD_ZONE_CACHE" 2>/dev/null
		r=$(_norm_temp "$v")
		[ -n "$r" ] && { echo "$r"; return; }

		BOARD_ZONE_STATE=""
		BOARD_ZONE_CACHE=""
	fi

	for f in \
		/sys/class/thermal/thermal_zone50/temp \
		/sys/class/thermal/thermal_zone45/temp \
		/sys/class/thermal/thermal_zone43/temp
	do
		v=$(cat "$f" 2>/dev/null)
		r=$(_norm_temp "$v")
		[ -n "$r" ] && { echo "$r"; return; }
	done
	echo ""
}

read_temp_batt() {
	local f v r
	for f in \
		/sys/class/power_supply/battery/temp \
		/sys/class/power_supply/battery/temperature \
		/sys/class/power_supply/bq_bms/temp
	do
		v=$(cat "$f" 2>/dev/null)
		r=$(_norm_temp "$v")
		[ -n "$r" ] && { echo "$r"; return; }
	done
	echo ""
}

read_temp() {
	local tb tc
	# ★★ v3552：同 emit_json，read_temp 内部已读 board+batt，不再重复 fork。
	tb=$(read_temp_board)
	tc=$(read_temp_batt)
	if [ -n "$tb" ] && [ -n "$tc" ]; then
		[ "$tb" -lt "$tc" ] && temp="$tb" || temp="$tc"
	elif [ -n "$tb" ]; then
		temp="$tb"
	else
		temp="$tc"
	fi

	if [ -n "$tb" ] && [ -n "$tc" ]; then
		[ "$tb" -lt "$tc" ] && echo "$tb" || echo "$tc"
	elif [ -n "$tb" ]; then
		echo "$tb"
	else
		echo "$tc"
	fi
}

read_temp_desc() {
	local tb tc
	# ★★ v3552：同 emit_json，read_temp 内部已读 board+batt，不再重复 fork。
	tb=$(read_temp_board)
	tc=$(read_temp_batt)
	if [ -n "$tb" ] && [ -n "$tc" ]; then
		[ "$tb" -lt "$tc" ] && temp="$tb" || temp="$tc"
	elif [ -n "$tb" ]; then
		temp="$tb"
	else
		temp="$tc"
	fi
	printf "板级 %s / 电池 %s" \
		"$([ -n "$tb" ] && echo "$(($tb/10)).$(($tb%10))C" || echo "—")" \
		"$([ -n "$tc" ] && echo "$(($tc/10)).$(($tc%10))C" || echo "—")"
}

_tname_of() {
	local p=$1 zn t
	case "$p" in
		'') echo "（未探测到）"; return ;;
		*/thermal/thermal_zone*/temp)

			zn=${p#*/thermal/}
			zn=${zn%%/*}
			t=$(cat "/sys/class/thermal/$zn/type" 2>/dev/null)
			[ -n "$t" ] && { echo "$zn($t)"; return; }
			echo "$zn"
			;;
		*/cms_class/*)

			zn=${p#*/cms_class/}
			echo "cms_class/$zn（厂商主口径）"
			;;
		*/power_supply/battery/*)
			zn=${p#*/power_supply/battery/}
			echo "battery/$zn"
			;;
		*) echo "$p" ;;
	esac
}

read_temp_source() {
	local f v

	if _board_zone_ensure && [ -n "$BOARD_ZONE_CACHE" ]; then
		v=$(cat "$BOARD_ZONE_CACHE" 2>/dev/null)
		case "$v" in
			''|*[!0-9-]*) ;;
			*) [ "$v" -gt 0 ] && { echo "$BOARD_ZONE_CACHE"; return; } ;;
		esac
	fi

	for f in \
		/sys/class/power_supply/battery/temp \
		/sys/class/power_supply/battery/temperature
	do
		v=$(cat "$f" 2>/dev/null)
		case "$v" in
			''|*[!0-9-]*) continue ;;
		esac
		[ "$v" -le 0 ] && continue
		echo "$f"
		return
	done
	echo "（读不到任何温度节点）"
}

read_ibat() {
	local f v a vb_mv=$1 _as_mA _uA _mw
	for f in \
		/sys/class/power_supply/battery/current_now \
		/sys/class/power_supply/bms/current_now
	do
		v=$(cat "$f" 2>/dev/null)
		case "$v" in
			''|*[!0-9-]*) continue ;;
		esac
		# ---- 单位判据（v3.5.11）----
		#   旧版原样返回，隐含假设 current_now 一定是 µA。而下游
		#   IBAT_MIN=300000 是按 µA 定的门槛：报 mA 的机型读到 3000
		#   永远 < 300000 -> 静默 return 4，模块全程不干预且【无任何日志】
		#   （用户看到的现象是“装了没反应”）。
		#   口径与 read_batt_current 统一：把值归一到 µA；负值（放电）
		#   同样要归一，所以先取绝对值再判。
		#
		#   ★★ 但“<100000 就当 mA”这条线在 10000~99999 之间【有歧义】：
		#   9720 若是 µA = 9.7mA（空闲）；若当 mA 处理就变成 9720000µA
		#   = 9.72A（看着像在快充）—— 方向完全反了，会让空闲状态被判成
		#   “正在大电流充电”，直接突破 IBAT_MIN 门禁。判据按可信度排三条：
		#     1) 绝对上限：任何解释下都不可能超过 IBAT_ABS_MAX（6A，覆盖
		#        到 6.5A 私有协议机型）。换算后越界 -> 只能是 µA。
		#     2) 功率交叉验证（需 vbat）：换算后功率须落在 100mW~300000mW。
		#     3) 两者都证明不了是 mA 时，**默认按 µA**（保守：宁可少干预
		#        一次，也别在空闲时误判成大电流）。
		#   ★ 调用方必须【先读 vbat 再读 ibat】，否则第2 条拿不到值。
		a=$v
		case "$a" in -*) a=$((-a)) ;; esac
		if [ "$a" -gt 0 ] && [ "$a" -lt 100000 ]; then
			_as_mA=$a
			# 换算后超过绝对上限 -> 只可能是 µA
			if [ "$_as_mA" -gt $((IBAT_ABS_MAX / 1000)) ]; then
				_as_mA=0
			fi
			if [ "$_as_mA" -gt 0 ] && [ -n "$vb_mv" ]; then
				case "$vb_mv" in
				''|*[!0-9]*) ;;
				*)
					_uA=$((_as_mA * 1000))
					_mw=$((vb_mv * _uA / 1000000))
					# 换算后功率离谱 -> 说明这是 µA，不是 mA
					if [ "$_mw" -ge 100 ] && [ "$_mw" -le 300000 ]; then
						v=$((v * 1000))
					fi
					;;
				esac
			fi
		fi

		echo "$v"
		return
	done
	echo ""
}

read_batt_current() {

	local vb_mv=$1 f v cand_a mw

	# ---- 候选按优先级排列：越可能是"总电流"的越靠前 ----
	for f in \
		/sys/class/cms_class/fastchg_current_now \
		/sys/class/cms_class/masterbq27426_current_now \
		/sys/class/power_supply/battery/current_now \
		/sys/class/power_supply/bms/current_now \
		/sys/class/cms_class/avg_current_now
	do
		[ -r "$f" ] || continue
		v=$(cat "$f" 2>/dev/null)
		case "$v" in ''|*[!0-9-]*) continue ;; esac
		cand_a=$v

		case "$cand_a" in -*) cand_a=$((-cand_a)) ;; esac
		[ "$cand_a" -le 0 ] && continue
		if [ "$cand_a" -lt 100000 ]; then

			cand_a=$((cand_a * 1000))
		fi

		if [ -n "$vb_mv" ]; then
			case "$vb_mv" in ''|*[!0-9]*) ;; *)

				mw=$((vb_mv * cand_a / 1000000))
				if [ "$mw" -lt 100 ] || [ "$mw" -gt 300000 ]; then
					continue
				fi
				;;
			esac
		fi

		echo "$cand_a"
		return
	done

	echo ""
}

# ★★★ v3572：零 fork 快速探测 ★★★
#  【为什么需要】
#    实测 do_once 单次 880ms、emit_json 单次 1160ms，其中绝大部分
#    不是“读 sysfs”，而是 fork。mksh 里每一处 $(函数调用) 都会 fork
#    一个子 shell，实测单次约 31ms：
#      do_once 里 19 处 $() ≈ 589ms
#      emit_json 里 25 处 $() ≈ 775ms
#    而 read_soc / _vbat_raw 内部已经改用 read 内建了（不走 fork），
#    唯独【调用点的 $( ) 本身】还在 fork —— 属于“优化了一半”。
#  【做法】
#    把热路径上最常用的几个只读值合并成一次探测，全部用 read 内建
#    （shell 自带，不产生任何子进程），结果写进 PF_* 全局变量，
#    调用方直接取用，不再 $( )。
#  【安全性】
#    probe_fast 只读 sysfs，不写任何节点，不改任何状态，
#    纯只读替换，语义与原来逐个 $( ) 调用完全一致。
probe_fast() {
	local _v _d _f
	PF_ONLINE=""; PF_SOC=""; PF_VBAT_RAW=""

	# ---- online（等价 read_charger_online 的快路径 + status 兜底）----
	#   原函数返回：1=在充 / 0=没在充 / ""=完全找不到节点
	local _found=0
	for _d in \
		/sys/class/power_supply/usb \
		/sys/class/power_supply/ac \
		/sys/class/power_supply/dc \
		/sys/class/power_supply/mains \
		/sys/class/power_supply/wireless
	do
		for _f in online present; do
			[ -e "$_d/$_f" ] || continue
			_v=""; read -r _v < "$_d/$_f" 2>/dev/null
			case "$_v" in ''|*[!0-9]*) continue ;; esac
			_found=1
			[ "$_v" -eq 1 ] && { PF_ONLINE=1; break 2; }
		done
	done

	if [ "$_found" = "0" ] || [ "$PF_ONLINE" != "1" ]; then
		# status 兜底（usb/ac/dc/mains）
		for _d in \
			/sys/class/power_supply/usb \
			/sys/class/power_supply/ac \
			/sys/class/power_supply/dc \
			/sys/class/power_supply/mains
		do
			[ -e "$_d/status" ] || continue
			_v=""; read -r _v < "$_d/status" 2>/dev/null
			case "$_v" in
				Charging|Full) _found=1; PF_ONLINE=1; break ;;
				*) _found=1 ;;
			esac
		done
	fi

	if [ "$PF_ONLINE" != "1" ]; then
		_v=""; read -r _v < /sys/class/power_supply/battery/status 2>/dev/null
		case "$_v" in
			Charging|Full) _found=1; PF_ONLINE=1 ;;
			Discharging)   _found=1; PF_ONLINE=0 ;;
			"Not charging") _found=1; PF_ONLINE=0 ;;
		esac
	fi
	# ★★ v3573-fix：保留原版的【三态】语义 ★★
	#   原版 read_charger_online 返回值有三种：1 / 0 / ""（节点都读不到）。
	#   不能把 "" 归成 0！do_once 里是这样用的：
	#     if [ "$_ol" = "0" ]; then ... return 4; fi      <- "" 不会进来
	#     if [ "$online" != "1" ]; then CHG_OK_CNT++ ...   <- "" 会进来，
	#        要连续 CHG_CONFIRM(3) 轮确认才继续干预。
	#   如果把 "" 归成 0，do_once 会直接 return 4，模块完全不干预，
	#   用户看到的就是“功率上不去”。这正是本次 bug 的根源。
	[ -z "$PF_ONLINE" ] && [ "$_found" = "1" ] && PF_ONLINE=0
	# _found=0 时 PF_ONLINE 保持为空，与原版 echo "" 一致

	# ---- soc ----
	_v=""; read -r _v < /sys/class/power_supply/battery/capacity 2>/dev/null
	case "$_v" in ''|*[!0-9]*) PF_SOC="" ;; *) PF_SOC="$_v" ;; esac

	# ---- vbat 原始值（mV 或 µV，由 read_vbat 决定口径）----
	for _f in \
		/sys/class/power_supply/battery/voltage_now \
		/sys/class/power_supply/bms/voltage_now
	do
		_v=""; read -r _v < "$_f" 2>/dev/null
		case "$_v" in ''|*[!0-9-]*) continue ;; esac
		PF_VBAT_RAW="$_v"
		break
	done

	return 0
}

read_charger_online() {
	local d f v found=0

	for d in \
		/sys/class/power_supply/usb \
		/sys/class/power_supply/ac \
		/sys/class/power_supply/dc \
		/sys/class/power_supply/mains \
		/sys/class/power_supply/wireless
	do
		for f in online present; do
			[ -e "$d/$f" ] || continue
			# ★ v3543：read 内建。
			v=""; read -r v < "$d/$f" 2>/dev/null
			case "$v" in
				''|*[!0-9]*) continue ;;
			esac
			found=1
			[ "$v" -eq 1 ] && { echo 1; return; }
		done
	done

	for d in \
		/sys/class/power_supply/usb \
		/sys/class/power_supply/ac \
		/sys/class/power_supply/dc \
		/sys/class/power_supply/mains
	do
		[ -e "$d/status" ] || continue
		# ★ v3543：read 内建。
		v=""; read -r v < "$d/status" 2>/dev/null
		case "$v" in
			Charging|Full) found=1; echo 1; return ;;
			Discharging|Not\ charging|Unknown|"")
				: ;;
			*) : ;;
		esac
		found=1
	done

	# ★ v3543：read 内建。
	local _st=""; read -r _st < /sys/class/power_supply/battery/status 2>/dev/null
	v="$_st"
	case "$v" in
		Charging|Full) found=1; echo 1; return ;;
		Discharging) found=1; echo 0; return ;;
		"Not charging") found=1; echo 0; return ;;
	esac

	if [ "$found" -eq 0 ]; then
		echo ""
	else
		echo 0
	fi
}

# ★★★ v3567：零 fork 的插电快速判定 ★★★
#   【为什么需要】未插电时主循环原来要跑完整个 do_once 才从返回码 rc=4
#     知道"没插电"，而 do_once 一轮要读十几个 sysfs、遍历 DT 表、算五段
#     电流，实测 ~1.6 秒 CPU；知道没插电之后还每 3 轮 fork 一次
#     refresh_cache（emit_json，又 ~900ms）。结果就是手机明明没插电，
#     守护照样常驻几个点的 CPU，用户感受是"放着不动也掉电"。
#   【做法】只读 battery/status 一个节点，用 shell 内建 read，零 fork。
#     结果写进全局变量 ONLINE_FAST，避免 $(...) 再 fork 一次。
#   【精度】battery/status 是内核 power_supply 直接上报的，
#     与 read_charger_online 最后的兜底判定用的是同一个节点，不会误判。
ONLINE_FAST=0
read_online_fast() {
	local _s=""
	read -r _s < /sys/class/power_supply/battery/status 2>/dev/null
	case "$_s" in
		Charging|Full) ONLINE_FAST=1 ;;
		*)             ONLINE_FAST=0 ;;
	esac
	return 0
}


# 最近一次门禁判定读到的【工作电压】(uV)。只作诊断：门禁拒绝(rc=8)时
#   把它写进日志，用户才能分辨是"电压读不到"还是"电压已到但节点不过"。
#   旧版 rc=8 完全不入日志，用户看到的是"这次什么记录都没有"。
PROTO_UV_LAST=""

HIGHV_FLAG_FILE="/data/adb/v2352a_charge_boost.highv"
HIGHV_SEEN=""
if [ -f "$HIGHV_FLAG_FILE" ]; then
	_v=$(cat "$HIGHV_FLAG_FILE" 2>/dev/null)
	case "$_v" in
		1) HIGHV_SEEN=1 ;;
		*) HIGHV_SEEN="" ;;
	esac
	unset _v
fi

_proto_supply_uv() {
	local p v
	# ★ V2352A 本机适配：候选顺序重排 + 值域护栏。
	#   本机实测：/sys/class/power_supply/battery/charger_voltage = 5
	#            /sys/class/power_supply/battery/chg_voltage     = 5
	#   这两个节点在本机【不是电压】，而是"当前充电协议编号/档位枚举"
	#   （5 = 某个协议态）。原实现把它读成 5V → 乘 1000 → 判成 5000000µV
	#   → protocol_ready 的"已建立工作电压"判定被这个假 5V 打动，
	#   协议门禁在根本没协商好的时候就放行，注入于是抢跑。
	#   本机真正可靠的电压来源：
	#     /sys/class/power_supply/usb/voltage_now = 9194000（µV，实测）
	#   所以把 usb/voltage_now 提到最前，并对「只有个位数」的值直接判空。
	for p in \
		/sys/class/power_supply/usb/voltage_now \
		/sys/class/power_supply/battery/charger_voltage \
		/sys/class/power_supply/battery/chg_voltage \
		/sys/class/cms_class/chg_voltage
	do
		[ -e "$p" ] || continue
		v=$(cat "$p" 2>/dev/null)
		case "$v" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$v" -gt 0 ] || continue

		# 值域护栏：个位数/两位数必然是枚举值，不是电压（mV 也不会这么小）
		[ "$v" -lt 1000 ] && continue

		if [ "$v" -lt 100000 ]; then
			v=$((v * 1000))
		fi
		echo "$v"
		return
	done
	echo ""
}

_proto_usb_uv() {
	_proto_supply_uv
}

# --- 状态变量（跨轮保存）---
SAFE_LOW_ACTIVE=""
SAFE_LOG_SIG=""
HV_PREV=""
HV_NONHV_STREAK=0
SAFE_LOCK_TICKS=0
SAFE_DROP_TOTAL=0
DROP_SESSION=0

load_safe_table() {
	local m
	m=$(getprop ro.product.vendor.model 2>/dev/null)
	DEV_MODEL="$m"

	# 设备类别：以 voter 通道可用性为准（架构差异，不是机型名猜测）。
	#   骁龙 SM8750（V2408A/V2463A）实测 pmic-votable 完整可用 -> qcom
	#   天玑 MT6991（V2405A）实测为空目录 -> mtk
	#
	# ★ v3.5.11：先确保 debugfs 已挂载再判定。
	#   _vot_any_ready 只看 /sys/kernel/debug/pmic-votable 是否存在，
	#   而开机早期 debugfs 可能还没挂上 —— 那一刻所有机型都会被判成 mtk，
	#   骁龙机于是走它【极力规避】的 sysfs 申请路径（等于用降级方案）。
	#   votable_ready() 内部本来就有挂载动作，这里复用同一句，
	#   保证两条判定路径口径一致（这是"三份拷贝漂移"的典型点）。
	#   【注意】此处写死路径而不是 $VOT_ROOT：VOT_ROOT 的赋值在文件
	#   更下方，而 load_safe_table 理论上可被提前调用，用字面量最稳。
	if [ ! -d /sys/kernel/debug/pmic-votable ]; then
		mount -t debugfs none /sys/kernel/debug 2>/dev/null
	fi
	if _vot_any_ready; then
		DEV_CLASS="qcom"
	else
		DEV_CLASS="mtk"
	fi

	# 安全上限：SAFE_CAP>0 时用户自定义统一上限；=0 时不做静态封顶
	# （仅保留反应式防掉压，见 apply_safe_ceiling）。
	if [ "$SAFE_CAP" -gt 0 ] 2>/dev/null; then
		SAFE_LOW=$SAFE_CAP; SAFE_MID=$SAFE_CAP; SAFE_HIGH=$SAFE_CAP
		SAFE_LOW_ACTIVE="${m:-未知}/自定义${SAFE_CAP}"
	else
		SAFE_LOW=0; SAFE_MID=0; SAFE_HIGH=0
		SAFE_LOW_ACTIVE="${m:-未知}/反应式"
	fi
	# 只在结果真的变化时打日志：本函数会在每次配置热重载后重跑，
	# 若每轮都打会把日志刷满，掩盖真正的状态变化。
	local _sig="$DEV_CLASS|$SAFE_LOW|$SAFE_CAP|$THERM_EN"
	if [ "$_sig" != "$SAFE_LOG_SIG" ]; then
		SAFE_LOG_SIG="$_sig"
		log "设备类别=$DEV_CLASS 机型=${m:-未知} 静态上限=${SAFE_LOW:-(无)} 温控=${THERM_EN}"
	fi
	return 0
}

safe_cap_by_soc() {
	local soc=$1
	# 静态上限未启用（SAFE_EN=0）-> 输出 0 表示不封顶
	[ "$SAFE_EN" = "1" ] || { echo 0; return; }
	# 阈值兜底：未初始化时按 55/65 处理，避免整数比较报错
	case "$SAFE_SOC_T1" in ''|*[!0-9]*) SAFE_SOC_T1=55 ;; esac
	case "$SAFE_SOC_T2" in ''|*[!0-9]*) SAFE_SOC_T2=65 ;; esac
	case "$SAFE_LOW"  in ''|*[!0-9]*) SAFE_LOW=0  ;; esac
	case "$SAFE_MID"  in ''|*[!0-9]*) SAFE_MID=0  ;; esac
	case "$SAFE_HIGH" in ''|*[!0-9]*) SAFE_HIGH=0 ;; esac
	case "$soc" in
		''|*[!0-9]*) echo "$SAFE_HIGH"; return ;;
	esac
	if [ "$soc" -lt "$SAFE_SOC_T1" ]; then
		echo "$SAFE_LOW"
	elif [ "$soc" -lt "$SAFE_SOC_T2" ]; then
		echo "$SAFE_MID"
	else
		echo "$SAFE_HIGH"
	fi
}

# ============================================================
#  ★★ v3562：防掉档功能已整体移除 ★★
# ------------------------------------------------------------
#  【为什么删】它做三件事，全部是拿"用户可见的系统状态"去换加速：
#     ① 写 5 个 persist.vivo.* 属性（关充电上限 / 关智能充电 / 开旁路充电…）
#     ② 写 cms 场景节点（factory_mode / calling / weixin … 全置 0）
#     ③ 每 30 轮重复压一遍，防厂商写回
#  ①② 有个致命副作用：persist. 属性是持久化的，重启不恢复。只要在
#  "已压制"状态下守护被杀、或拔线时那一轮恰好没走到还原分支，值就
#  永久停在坏状态 —— 用户设置里的「充电上限」直接消失，重启也不回来。
#  实测日志：压制 17 次、还原 15 次，那 2 次差异就是两粒不可逆的坏种子。
#  而它的收益在本机几乎为零：本机 voter 通道（DCHG_FCC）本身就足够，
#  不靠压制 vivo 属性也能拿到全部电流。
#  【保留什么】静态封顶（apply_safe_ceiling / safe_cap_by_soc / SAFE_EN /
#  SAFE_CAP）是独立功能，与防掉档无关，全部保留。
#  【兼容占位】下面留两个空函数，因为调用点较多（do_once / pause / restore），
#  留占位比逐个删调用点更安全 —— 删调用点容易漏一处，留空函数绝不会出问题。
# ============================================================
# ★ v3569：safe_guard_sync / safe_guard_restore 原本是 v3562 移除防掉档后
#   留下的两个空函数占位。它们内部只有 return 0，不产生任何副作用，
#   却是"防掉档还存在"的误导性痕迹。这里彻底删除，调用点一并清掉。
#   （v3562 已确认防掉档逻辑走 apply_safe_ceiling 静态封顶，与此无关。）

# ---- 对目标电流施加静态上限 ----
# 参数: $1=候选电流  $2=SOC
# 说明: 只做静态封顶（用户可自定义 SAFE_CAP），不再做反应式降级。
apply_safe_ceiling() {
	local cur=$1 soc=$2 base safe
	[ "$SAFE_EN" = "1" ] || { echo "$cur"; return; }

	base=$(safe_cap_by_soc "$soc")
	case "$base" in ''|*[!0-9]*) base=0 ;; esac

	if [ "$base" -gt 0 ]; then
		safe=$base
		[ "$safe" -lt 1000 ] && safe=1000
		if [ "$cur" -gt "$safe" ]; then
			[ "$LOG_PREV_CAP" = "$cur:$safe" ] || {
				LOG_PREV_CAP="$cur:$safe"
				log "静态封顶: $cur -> $safe (SOC=${soc}%)"
			}
			cur="$safe"
		fi
	fi
	echo "$cur"
}

# ============================================================
#  会话复位：把"拔线 -> 重新插线"当作会话边界
# ------------------------------------------------------------
#  【为什么需要】
#    守护靠一个 2 秒主循环持续干预，但它的"记忆"是【跨充电会话】的：
#    下面这些变量一旦被上一次会话推到某个值，就一直保留到进程重启为止
#    （未充电时主循环在 `online=0 -> return 4` 那一步就返回了，
#      根本走不到 update_therm / safe_guard_sync 的更新分支）。
#    结果：上一次充电末期留下的状态，会把这一次会话的干预挡在门外。
#    用户看到的现象就是"充完电第二次插线不加速，必须先点一次恢复原厂
#    （= 重开守护）再重选档位才会加速" —— 因为【重启是唯一会清空它们
#    的操作】，这就是那个"隐藏的开关"。
#
#  【为什么复位是安全的】
#    · 不动任何温度阈值（1.x 的那些 40.5/41/42/43、65/70/75/79 全不变）。
#    · 温度仍按【当前值】重新评估：当前温度高 -> 该撒手照样撒手。
#      复位后第一轮 update_therm 会拿实时温度重算，保护强度不变；
#      只是不再"继承上一次会话的档位记忆"。
#    · 协议门禁重新武装后也不会 0V 抢跑：8V 分支本身就要求 uv>=8000000。
#
#  【等价关系】复位后的一轮，行为与"守护刚重启"一致 ——
#    这正是用户已实测有效的那个操作，所以必然能修好。
# ============================================================
session_reset() {
	# ---- 协议门禁：本会话重新武装 ----
	#   HIGHV_SEEN 记的是"本次会话是否已见过高压"，跨会话残留没有意义。
	HIGHV_SEEN=""
	PROTO_NODE_MISSING=""
	PROTO_WARNED=""

	# ---- 温度状态机：让本轮按【当前温度】重新评估 ----
	#   清空档位与历史队列；下一轮 do_once 会重新 push 实时温度。
	THERM_STATE=0
	THERM_RECOVER_T=0
	THERM_TB_HIST=""
	THERM_TC_HIST=""
	THERM_TB_MED=""
	THERM_TC_MED=""

	# ---- 原值备份：不碰 MOD_WROTE / ORIG_FILE ----
	#   原值只该备份一次，重置它反而会把模块写过的值当成原厂值存下来。
	return 0
}

protocol_ready() {
	# ------------------------------------------------------------

	local uv

	uv=$(_proto_supply_uv)

	PROTO_UV_LAST="$uv"
	if [ -n "$uv" ]; then

		if [ "$uv" -ge 12000000 ]; then
			HIGHV_SEEN=1

			[ -n "$HIGHV_FLAG_FILE" ] && \
				printf '1' > "$HIGHV_FLAG_FILE" 2>/dev/null
			return 0
		fi

		if [ "$uv" -ge 8000000 ] && [ "$HIGHV_SEEN" != "1" ]; then
			return 0
		fi
	fi

	#   实测（V2405DA 诊断）：节点真名是 `debug_chg_protocol_support`，
	#   而旧代码只读 `chg_protocol_support` -> 读不到 -> ps 为空 ->
	#   protocol_ready 永远返回失败 -> 守护每轮 return 8 -> 注入从未发生。
	#   （开关能打开是因为它只探测 voter 通道，与本节点无关。）
	#   `main_sm` 是状态机文本（main_sm:0 INIT），协议就绪后应出现更多状态，
	#   拿不到具体状态时以 chg_protocol_support 为准。
	local ps _pf
	for _pf in /sys/class/vfcs_class/debug_chg_protocol_support \
	           /sys/class/vfcs_class/chg_protocol_support \
	           /sys/class/cms_class/chg_protocol_support; do
		ps=$(cat "$_pf" 2>/dev/null)
		case "$ps" in
			''|*[!0-9a-fA-FxX]*) continue ;;
			*) PROTO_NODE_MISSING=0; break ;;
		esac
	done
	[ -n "$ps" ] || PROTO_NODE_MISSING=1

	ps=$(printf '%s' "$ps" | tr -d ' \t\r\n')

	case "$ps" in
		0x*) ps=${ps#0x} ;;
		0X*) ps=${ps#0X} ;;
	esac

	case "$ps" in
		''|*[!0-9a-fA-F]*) : ;;
		?????????*) : ;;
		*)

			case "$ps" in
				0|00|000|0000|00000|000000|0000000|00000000) : ;;
				*)
					return 0
					;;
			esac
			;;
	esac

	# ---- 协议节点完全不存在时的降级 ----
	# 【为什么不能直接 return 1】判决层注入(force_active)本身是【持续生效】的
	#   强制通道，不是一次性写完就完。若因为读不到一个 debug 节点就永不就绪，
	#   守护会每轮 return 8，注入一次都不会发生 —— 那还不如不装。
	#   120w 模块的主循环同样没有任何协议门禁，无条件每 2 秒注入一次。
	# 这里放宽为：节点读不到时，只要已经见过工作电压就放行
	#（说明充电链路已建立），并做一次提示。
	# 这里放宽为：节点读不到时，只要【已经建立工作电压】就放行。
	# 电压门槛取 5V（5000000mV）—— 低于此说明充电链路还没起来，
	# 此时放行等于在协议协商前就抢跑，反而会钉死 IC。
	case "$uv" in
		''|*[!0-9]*) : ;;
		*)
			[ "$uv" -ge 5000000 ] || return 1
			[ "$PROTO_WARNED" = "1" ] || {
				PROTO_WARNED=1
				log "提示: 本机无 chg_protocol_support 节点，协议门禁降级为按工作电压(>=5V)放行"
			}
			return 0
			;;
	esac

	return 1
}

_vbat_raw() {
	local f v
	for f in \
		/sys/class/power_supply/battery/voltage_now \
		/sys/class/power_supply/bms/voltage_now
	do
		# ★ v3543：read 内建，去 fork。
		v=""; read -r v < "$f" 2>/dev/null
		case "$v" in
			''|*[!0-9-]*) continue ;;
		esac
		echo "$v"
		return
	done
	echo ""
}

read_cells() {
	local vb raw c1 ratio

	vb=$(read_vbat 2>/dev/null)
	case "$vb" in ''|*[!0-9]*) echo 1; return 0 ;; esac
	[ "$vb" -lt 2000 ] && { echo 1; return 0; }

	c1=""
	for raw in \
		/sys/class/cms_class/cell1_voltage \
		/sys/class/power_supply/battery/voltage_cell1
	do
		[ -r "$raw" ] || continue
		# ★ v3543：read 内建。
		c1=""; read -r c1 < "$raw" 2>/dev/null
		case "$c1" in ''|*[!0-9]*) c1="" ; continue ;; esac

		[ "${#c1}" -ge 6 ] && c1=$((c1 / 1000))
		[ "$c1" -gt 0 ] && break
		c1=""
	done
	[ -n "$c1" ] || { echo 1; return 0; }

	ratio=$((vb * 100 / c1))

	if [ "$ratio" -ge 170 ] && [ "$ratio" -le 230 ]; then
		echo 2
		return 0
	fi

	if [ "$ratio" -ge 85 ] && [ "$ratio" -le 115 ]; then
		echo 1
		return 0
	fi

	echo 1
	return 0
}

read_vbat() {
	local raw ref digits
	raw=$(_vbat_raw)
	[ -n "$raw" ] || { echo ""; return; }
	[ "$raw" -lt 0 ] && raw=$((-raw))
	[ "$raw" -eq 0 ] && { echo ""; return; }

	# ---- 位数即口径：4 位(1000..9999) 必然是 mV；6~7 位必然是 µV ----
	digits=${#raw}
	if [ "$digits" -le 5 ]; then

		echo "$raw"
		return
	fi
	if [ "$digits" -ge 6 ]; then

		echo $((raw / 1000))
		return
	fi

	echo $((raw / 1000))
}

# ★ v3541：分段边界钳制到停止线之内。
# ------------------------------------------------------------
# 【要解决的冲突】T1..T4 是固定的 70/80/86/89，而 SOC_MAX 现在可调到 40~100。
#   一旦用户把停止线拉到低于 T4（比如 85），就会出现：
#     · 后端 target_current() 在 >SOC_MAX 时直接返回 0，
#       于是 mid2(86~89)、low2(89~85) 两段【永远命中不到】——
#       用户在这两段里填的值完全无效，纯属摆设
#     · 前端 segLabel 算出来的区间会倒挂成 "89~85%"，看起来像乱码
#     · 用户以为改了有生效，实际一点作用都没有
#
# 【修法】在 load_profile 之后调用本函数，把 T1..T4 按「不得超过 SOC_MAX」
#   往内收。规则：任何 Ti >= SOC_MAX 就压到 SOC_MAX - 1（保证该段至少还有
#   1% 的命中区间，而不是变成一个空段）。
#   这样五段的标签永远单调递增、永远落在 [SOC_MIN, SOC_MAX] 内，
#   不会出现倒挂，也不会出现"看得见但摸不着"的死段。
#
# 【为什么是"压到 SOC_MAX-1"而不是直接等于 SOC_MAX】
#   target_current 的分段判断用的是 `<`（soc < T1 取 low），
#   若 T1 == SOC_MAX，则 soc 恰好等于 SOC_MAX 时会落进 high 段，
#   但同一时刻 target_current 又会因为 soc > SOC_MAX 之外… 边界值上
#   会有一个"差 1%"的缝合问题。压到 SOC_MAX-1 可以完全避开。
#
# ★ v3541 二次修正：上面的「逐个 -1 挤压」在停止线很低时会把后四段
#   压成 1% 宽的窄条（停止线=40 时是 36/37/38/39，每段只有 1%），
#   既没有实用价值，标签看起来也像乱码。
#
#   改成【按比例缩放】：把原始边界（70/80/86/89）视为
#   [SOC_MIN, SOC_DEFAULT_MAX] 上的四个锚点，按当前 SOC_MAX
#   等比例映射到 [SOC_MIN, SOC_MAX]。
#   这样无论停止线是 40 还是 100，五段的宽度比例都保持一致，
#   用户看到的永远是"五个比例协调的段"，而不是"一段很宽 + 四段各 1%"。
#
#   例：原始锚点在 5~90 上，映射到 5~40：
#     T1 70 -> 5 + (70-5)/(90-5)*(40-5) ≈ 31
#     T2 80 -> 5 + 75/85*35 ≈ 35
#   得到一组等比收缩的边界，而不是挤成一堆。
soc_bounds_clamp() {
	case "$SOC_MAX" in ''|*[!0-9]*) SOC_MAX=$SOC_DEFAULT_MAX ;; esac

	local _lo=$SOC_MIN _hi=$SOC_MAX _dhi=$SOC_DEFAULT_MAX

	# SOC_MAX 没被改动（== 默认 90）或比默认还大（100）时，
	#   原始边界 70/80/86/89 本来就在区间内，原样使用，不做任何缩放。
	#   （SOC_MAX=100 时也不放大 —— 保持原标定的分段位置更符合直觉。）
	if [ "$_hi" -ge "$_dhi" ]; then
		return 0
	fi

	# 区间太窄（放不下五段、每段不足 1%）时，退化为等分五段。
	local _span=$((_hi - _lo))
	if [ "$_span" -lt 5 ]; then
		local _step=1
		SOC_T1=$((_lo + 1))
		SOC_T2=$((_lo + 2))
		SOC_T3=$((_lo + 3))
		SOC_T4=$((_lo + 4))
		[ "$SOC_T4" -ge "$_hi" ] && SOC_T4=$((_hi - 1))
		[ "$SOC_T3" -ge "$SOC_T4" ] && SOC_T3=$((SOC_T4 - 1))
		[ "$SOC_T2" -ge "$SOC_T3" ] && SOC_T2=$((SOC_T3 - 1))
		[ "$SOC_T1" -ge "$SOC_T2" ] && SOC_T1=$((SOC_T2 - 1))
		return 0
	fi

	# 等比例映射：newT = lo + (T_orig - lo) * (hi - lo) / (dhi - lo)
	local _dspan=$((_dhi - _lo))
	_soc_map() {
		echo $(( _lo + ($1 - _lo) * _span / _dspan ))
	}
	local _t1 _t2 _t3 _t4
	_t1=$(_soc_map "$SOC_T1")
	_t2=$(_soc_map "$SOC_T2")
	_t3=$(_soc_map "$SOC_T3")
	_t4=$(_soc_map "$SOC_T4")

	# 单调性 + 边界护栏（浮点截断可能让两点相等）
	[ "$_t1" -le "$_lo" ] && _t1=$((_lo + 1))
	[ "$_t2" -le "$_t1" ] && _t2=$((_t1 + 1))
	[ "$_t3" -le "$_t2" ] && _t3=$((_t2 + 1))
	[ "$_t4" -le "$_t3" ] && _t4=$((_t3 + 1))
	# T4 必须 < SOC_MAX，否则最后一段命中不到
	[ "$_t4" -ge "$_hi" ] && _t4=$((_hi - 1))
	# 压回后再修一次单调
	[ "$_t3" -ge "$_t4" ] && _t3=$((_t4 - 1))
	[ "$_t2" -ge "$_t3" ] && _t2=$((_t3 - 1))
	[ "$_t1" -ge "$_t2" ] && _t1=$((_t2 - 1))
	[ "$_t1" -gt "$_lo" ] || _t1=$((_lo + 1))

	SOC_T1=$_t1; SOC_T2=$_t2; SOC_T3=$_t3; SOC_T4=$_t4
	return 0
}

target_current() {
	local soc=$1 v="" _cap=""

	[ "$soc" -lt "$SOC_MIN" ] && { echo 0; return; }
	[ "$soc" -gt "$SOC_MAX" ] && { echo 0; return; }

	if [ "$soc" -lt "$SOC_T1" ]; then
		v="$I_LOW"
	elif [ "$soc" -lt "$SOC_T2" ]; then
		v="$I_MID"
	elif [ "$soc" -lt "$SOC_T3" ]; then
		v="$I_PEAK"
	elif [ "$soc" -lt "$SOC_T4" ]; then
		v="$I_MID2"
	else
		v="$I_LOW2"
	fi

	case "$v" in
		''|*[!0-9]*)

			v=$(restore_ma)
			;;
		*)

			_cap=$(cal_max)
			if [ "$v" -gt "$_cap" ]; then
				[ "$LOG_PREV_MAX" = "$v:$_cap" ] || {
					LOG_PREV_MAX="$v:$_cap"
					log "目标电流 $v 超过本机上限 ${_cap}mA，已钳制到 ${_cap}"
				}
				v="$_cap"
			fi

			# ---- 功率封顶：防"电压塌陷 → 协议重协商"循环 ----
			# 【量纲陷阱，务必注意】
			#   fchg_fcc_ma / USER_IBAT 是【电池侧电流】(mA)，
			#   而 _proto_supply_uv() 读的是【输入侧电压】(chg_voltage / VBUS)。
			#   两者相乘算出的功率是错的：20V 体系会把结果放大 4~5 倍，
			#   折算出的上限极小、被下限夹住 —— 表现为"电流锁死在 4000mA"。
			#   功率必须用【电池侧电压】(vfloat_voltage) 来算：
			#     实测 11% 时 电池 4.43V × 13.19A = 58.4W
			#     60W / 4.43V = 13544mA —— 不会误伤 11500 的正常申请。
			# 【判据】I ≤ POWER_CAP_W × 1000000 / V_batt(mV)
			local _vb _pcap
			_vb=$(cat /sys/class/cms_class/vfloat_voltage 2>/dev/null)
			case "$_vb" in
				''|*[!0-9]*) : ;;
				*)
					# 合理性护栏：vfloat_voltage 是【单芯电压 mV】，
					# 正常范围 3000~5000mV。超出说明读到的是别的东西
					# （比如误读了输入侧电压），此时【不封顶】——
					# 宁可少一层保护，也不能把电流锁死。
					if [ "$_vb" -ge 2500 ] && [ "$_vb" -le 6000 ]; then
						# ★ v3514：POWER_CAP_W=0 表示【关闭本层】，必须直接跳过。
						#   否则 0 × 1000000 / 4450 = 0，
						#   再被下面的 POWER_CAP_MIN(4000) 抬到 4000 →
						#   电流被硬锁在 4000mA（约 18W），
						#   这正是历史上"改完参数充得比原来还慢"的坑。
						#   原代码没有这个判断，只靠 POWER_CAP_W 恒为正来掩盖。
						case "$POWER_CAP_W" in
							''|*[!0-9]*|0) ;;
							*)
								_pcap=$(( POWER_CAP_W * 1000000 / _vb ))
								[ "$_pcap" -lt "$POWER_CAP_MIN" ] && _pcap=$POWER_CAP_MIN
								[ "$_pcap" -gt "$_cap" ] && _pcap="$_cap"
								if [ "$v" -gt "$_pcap" ]; then
									[ "$LOG_PREV_PWR" = "${v}:${_vb}:${_pcap}" ] || {
										LOG_PREV_PWR="${v}:${_vb}:${_pcap}"
										log "电池 ${_vb}mV 下 ${POWER_CAP_W}W 折算上限 ${_pcap}mA，申请 ${v}mA 已钳制"
									}
									v="$_pcap"
								fi
								;;
						esac
					fi
					;;
			esac
			;;
	esac
	echo "$v"
}

_median_of() {
	local sorted n i j key

	sorted=""
	for key in $1; do
		local done_flag=0 out=""
		for i in $sorted; do
			if [ "$done_flag" -eq 0 ] && [ "$key" -le "$i" ]; then
				out="$out $key"; done_flag=1
			fi
			out="$out $i"
		done
		[ "$done_flag" -eq 0 ] && out="$out $key"
		sorted="$out"
	done

	n=0
	for i in $sorted; do n=$((n + 1)); done
	[ "$n" -eq 0 ] && return 0

	local want=$(( (n + 1) / 2 ))
	i=0
	for key in $sorted; do
		i=$((i + 1))
		if [ "$i" -eq "$want" ]; then echo "$key"; return 0; fi
	done
}

_push_hist() {
	local var=$1 t=$2 cur n

	case "$t" in ''|*[!0-9]*) return 1 ;; esac

	eval "cur=\$$var"
	cur="$cur $t"

	n=0
	for t in $cur; do n=$((n + 1)); done
	while [ "$n" -gt "$TEMP_HIST_N" ]; do
		local new=" " first=1
		for t in $cur; do
			if [ "$first" -eq 1 ]; then first=0; continue; fi
			new="$new $t"
		done
		cur=${new# }
		n=$((n - 1))
	done
	eval "$var=\"\$cur\""
	_median_of "$cur"
}

push_temp() {

	if [ "$#" -le 1 ]; then
		push_temp "$1" ""
		return
	fi

	local tb=$1 tc=$2 med

	if [ -n "$tb" ]; then
		med=$(_push_hist THERM_TB_HIST "$tb")
		[ -n "$med" ] && THERM_TB_MED="$med"
	fi
	if [ -n "$tc" ]; then
		med=$(_push_hist THERM_TC_HIST "$tc")
		[ -n "$med" ] && THERM_TC_MED="$med"
	fi
}

# 由 THERM_START / THERM_STOP 派生板级温度阈值（三个 WebUI 参数驱动）。
#   定义：START=开始降流温度，STOP=停止干预温度。
#   中间的"降档A/降档B"按 START..STOP 三等分，保证单调递增。
#   THERM_EN=0 -> 关闭模块自身温控（交回内核保护）。
therm_sync() {
	local s e d dd
	s=$THERM_START; e=$THERM_STOP
	case "$s" in ''|*[!0-9]*) s=650 ;; esac
	case "$e" in ''|*[!0-9]*) e=790 ;; esac
	# 合法性：STOP 必须显著高于 START，否则退回默认，避免除零/倒挂
	[ "$e" -le "$s" ] && { s=650; e=790; }
	THERM_START=$s; THERM_STOP=$e

	if [ "$THERM_EN" != "1" ]; then
		# 关闭：两路阈值都推到极高，状态机恒为 0。
		#   【必须连电池侧一起关】温度状态取"板级/电池两路中更严重的一路"，
		#   只推高板级的话，电池温度到 40.5C 仍会触发预警/降档 ——
		#   界面写着"关闭后保护线全部失效"却仍在降流，就是这个疏漏。
		TB_WARN=9999; TB_CAP_A=9999; TB_CAP_B=9999; TB_RELEASE=9999
		TB_RECOVER=9999
		TC_WARN=9999; TC_CAP_A=9999; TC_CAP_B=9999; TC_RELEASE=9999
		TC_RECOVER=9999
		VT_T1=9999; VT_T2=9999; VT_T3=9999; VT_T4=9999; VT_T5=9999
	else
		# 电池侧恢复出厂阈值（不随用户填的板级线变化）
		TC_WARN=$TC_WARN_F; TC_CAP_A=$TC_CAP_A_F; TC_CAP_B=$TC_CAP_B_F
		TC_RELEASE=$TC_RELEASE_F; TC_RECOVER=$TC_RECOVER_F
		# 板级状态机：START ~ STOP 三等分（降档A/降档B）
		d=$(( (e - s) / 3 ))
		[ "$d" -lt 1 ] && d=1
		TB_WARN=$s
		TB_CAP_A=$(( s + d ))
		TB_CAP_B=$(( s + 2 * d ))
		TB_RELEASE=$e
		# 恢复线：比开始降流低 5.0C
		TB_RECOVER=$(( s - 50 ))
		[ "$TB_RECOVER" -lt 0 ] && TB_RECOVER=0

		# 注入阶梯：START ~ STOP 四等分（T1..T5）
		dd=$(( (e - s) / 4 ))
		[ "$dd" -lt 1 ] && dd=1
		VT_T1=$s
		VT_T2=$(( s + dd ))
		VT_T3=$(( s + 2 * dd ))
		VT_T4=$(( s + 3 * dd ))
		VT_T5=$e
	fi
	# 派生结果回写 VOTE_T*（单一事实来源）
	VOTE_T1=$VT_T1; VOTE_T2=$VT_T2; VOTE_T3=$VT_T3
	VOTE_T4=$VT_T4; VOTE_T5=$VT_T5
	TEMP_WARN=$TB_WARN
	TEMP_CAP_A=$TB_CAP_A
	TEMP_CAP_B=$TB_CAP_B
	TEMP_RELEASE=$TB_RELEASE
	TEMP_RECOVER=$TB_RECOVER
	return 0
}

_ts_board() {
	local t=$1
	if   [ "$t" -ge "$TB_RELEASE" ]; then echo 4
	elif [ "$t" -ge "$TB_CAP_B"   ]; then echo 3
	elif [ "$t" -ge "$TB_CAP_A"   ]; then echo 2
	elif [ "$t" -ge "$TB_WARN"    ]; then echo 1
	else echo 0
	fi
}

_ts_batt() {
	local t=$1
	if   [ "$t" -ge "$TC_RELEASE" ]; then echo 4
	elif [ "$t" -ge "$TC_CAP_B"   ]; then echo 3
	elif [ "$t" -ge "$TC_CAP_A"   ]; then echo 2
	elif [ "$t" -ge "$TC_WARN"    ]; then echo 1
	else echo 0
	fi
}

temp_to_state() {

	if [ "$#" -le 1 ]; then
		_ts_board "$1"
		return
	fi

	local tb=$1 tc=$2 sb sc
	local has_b=1 has_c=1
	case "$tb" in ''|*[!0-9]*) has_b=0 ;; esac
	case "$tc" in ''|*[!0-9]*) has_c=0 ;; esac

	if [ "$has_b" -eq 1 ] && [ "$has_c" -eq 1 ]; then
		sb=$(_ts_board "$tb"); sc=$(_ts_batt "$tc")
		[ "$sb" -ge "$sc" ] && echo "$sb" || echo "$sc"
	elif [ "$has_b" -eq 1 ]; then
		_ts_board "$tb"
	elif [ "$has_c" -eq 1 ]; then
		_ts_batt "$tc"
	else
		echo ""
	fi
}

update_therm() {

	local tmed traw tcmed tcraw want want_raw want_c now_t
	if [ "$#" -ge 4 ]; then
		tmed=$1; traw=$2; tcmed=$3; tcraw=$4
	else
		tmed=$1; traw=$2; tcmed=""; tcraw=""
	fi

	[ -n "$traw" ] || traw="$tmed"
	[ -n "$tcraw" ] || tcraw="$tcmed"

	local ok_b=1 ok_c=1
	case "$tmed"  in ''|*[!0-9]*) ok_b=0 ;; esac
	case "$tcmed" in ''|*[!0-9]*) ok_c=0 ;; esac
	[ "$ok_b" -eq 0 ] && [ "$ok_c" -eq 0 ] && return
	[ "$ok_b" -eq 1 ] && [ "$tmed" -eq 0 ] && ok_b=0
	[ "$ok_c" -eq 1 ] && [ "$tcmed" -eq 0 ] && ok_c=0
	[ "$ok_b" -eq 0 ] && [ "$ok_c" -eq 0 ] && return

	want=$(temp_to_state "$tmed" "$tcmed")
	want_raw=$(temp_to_state "$traw" "$tcraw")

	local want_up="$want"
	[ "$want_raw" -gt "$want_up" ] && want_up="$want_raw"

	if [ "$want_up" -gt "$THERM_STATE" ]; then
		# ---- 升温：立即升档（快）----
		THERM_STATE="$want_up"
		THERM_RECOVER_T=0
	elif [ "$want" -lt "$THERM_STATE" ]; then
		# ---- 降温：需要满足恢复条件才降档（稳）----

		if [ "$want" -eq 0 ]; then

			local rec_ok=1
			if [ "$ok_b" -eq 1 ]; then
				[ "$tmed"  -le "$TB_RECOVER" ] || rec_ok=0
				[ "$traw"  -le "$TB_RECOVER" ] || rec_ok=0
			fi
			if [ "$ok_c" -eq 1 ]; then
				[ "$tcmed" -le "$TC_RECOVER" ] || rec_ok=0
				[ "$tcraw" -le "$TC_RECOVER" ] || rec_ok=0
			fi

			if [ "$rec_ok" -eq 1 ]; then
				now_t=$(date +%s 2>/dev/null)
				case "$now_t" in ''|*[!0-9]*) now_t=0 ;; esac
				if [ "$THERM_RECOVER_T" -eq 0 ]; then
					THERM_RECOVER_T="$now_t"
				elif [ $((now_t - THERM_RECOVER_T)) -ge "$TEMP_RECOVER_SEC" ]; then
					THERM_STATE=0
					THERM_RECOVER_T=0
					THERM_TB_HIST=""
					THERM_TC_HIST=""
				fi
			else
				THERM_RECOVER_T=0
			fi
		else
			THERM_STATE="$want"
			THERM_RECOVER_T=0
		fi
	fi
}

therm_cap() {
	case "$1" in
		2) echo "$CAP_A" ;;
		3) echo "$CAP_B" ;;
	# ★ v3577：删除 state=4 分支 —— 死代码。
	#   do_once 第 3619 行已提前 return 3，THERM_STATE 到不了 4，
	#   该分支不可能执行。删除后行为完全等价。
		*) echo 999999 ;;
	esac
}

therm_name() {
	case "$1" in
		0) echo "正常" ;;
		1) echo "预警" ;;
		2) echo "降档A" ;;
		3) echo "降档B" ;;
		4) echo "撒手" ;;
		'') echo "未充电" ;;
		*) echo "?" ;;
	esac
}

why_inactive() {
	local soc=$1 tb=$2 tc=$3 online=$4 tstate=$5

	[ -e "$NODE" ] || { echo "本机没有 $NODE 节点，模块无法干预"; return; }

	if [ "$online" = "0" ]; then
		echo "未插入充电器，模块不干预"
		return
	fi

	if [ -z "$soc" ]; then
		echo "读不到电量(SOC)，模块无法判断，暂不干预"
		return
	fi

	if [ "$soc" -lt "$SOC_MIN" ]; then
		echo "电量 ${soc}% 低于生效下限 ${SOC_MIN}%，已交回系统涓流充电"
		return
	fi
	if [ "$soc" -gt "$SOC_MAX" ]; then
		# ★ v3541：区分「用户自己设的停止线」与「出厂保护上限」。
		#   SOC_MAX 现在可由 WebUI 滑动条调（40~100），所以不能再一律说
		#   "保护电芯" —— 用户设成 40 时，41% 就收手跟保护电芯毫无关系，
		#   那是他自己的选择。文案必须说清是哪一种，否则会让人误以为
		#   触发了什么保护机制。
		#   【注意】判据是"不等于"而不是"小于"：用户把停止线拉到 100
		#   （管到满）也是改过，不能说成"出厂保护上限"。
		if [ "$SOC_MAX" != "$SOC_DEFAULT_MAX" ]; then
			echo "电量 ${soc}% 已超过你设定的停止介入线 ${SOC_MAX}%，模块已停手（这是你自己设的值，可在「高级→停止介入电量」调整）"
		else
			echo "电量 ${soc}% 已超过生效上限 ${SOC_MAX}%，模块按设计不再干预（保护电芯，可自定义电流不会生效）"
		fi
		return
	fi

	if [ -z "$tb$tc" ]; then
		echo "读不到任何温度传感器，模块保守起见不干预（请检查板级温度节点）"
		return
	fi
	if { [ -n "$tb" ] && [ "$tb" -lt "$TEMP_MIN" ]; } || \
	   { [ -n "$tc" ] && [ "$tc" -lt "$TEMP_MIN" ]; }; then
		echo "温度过低，模块暂不干预（低温大电流易析锂）"
		return
	fi

	if [ "$tstate" = "4" ]; then
		echo "温度过高，已进入撒手态把控制权交回系统，不写节点"
		return
	fi

	echo ""
}

gear_ladder() {
	local sorted="" v
	for v in "$I_LOW" "$I_MID" "$I_PEAK" "$I_MID2" "$I_LOW2"; do
		case "$v" in ''|*[!0-9]*) continue ;; esac
		[ "$v" -eq 0 ] && continue

		local dup=0 x
		for x in $sorted; do
			[ "$x" = "$v" ] && dup=1
		done
		[ "$dup" -eq 1 ] && continue

		local out="" placed=0
		for x in $sorted; do
			if [ "$placed" -eq 0 ] && [ "$v" -gt "$x" ]; then
				out="$out $v"; placed=1
			fi
			out="$out $x"
		done
		[ "$placed" -eq 0 ] && out="$out $v"
		sorted=${out# }
	done
	echo "$sorted"
}

fold_down() {
	local v=$1 n=$2 ladder idx i lowest
	case "$v" in ''|*[!0-9]*) echo "$v"; return ;; esac
	[ "$n" -le 0 ] && { echo "$v"; return; }

	ladder=$(gear_ladder)

	idx=0; i=0; lowest=""
	for x in $ladder; do
		i=$((i + 1))
		lowest="$x"
		if [ "$x" -le "$v" ] && [ "$idx" -eq 0 ]; then
			idx=$i
		fi
	done

	if [ "$idx" -eq 0 ]; then

		local newv=""
		for x in $ladder; do
			if [ "$x" -lt "$v" ]; then newv="$x"; break; fi
		done
		if [ -z "$newv" ]; then
			echo "$v"; return
		fi
		v="$newv"; idx=0

		i=0
		for x in $ladder; do
			i=$((i + 1))
			if [ "$x" = "$v" ]; then idx=$i; break; fi
		done
		[ "$idx" -eq 0 ] && { echo "$v"; return; }
	fi

	local want=$((idx + n))
	i=0
	for x in $ladder; do
		i=$((i + 1))
		[ "$i" -eq "$want" ] && { echo "$x"; return; }
	done

	[ -n "$lowest" ] && echo "$lowest" || echo "$v"
}

therm_fold_n() {
	case "$1" in
		1) echo 1 ;;
		2) echo 2 ;;
		3) echo 3 ;;
		*) echo 0 ;;
	esac
}

valid_current() {
	local v=$1 c
	case "$v" in
		''|*[!0-9]*) return 1 ;;
	esac
	for c in $VALID_CURRENTS; do
		[ "$v" = "$c" ] && return 0
	done
	return 1
}

cur_value_ok() {
	local v=$1 cap
	case "$v" in
		''|*[!0-9]*) return 1 ;;
	esac
	cap=$(cal_max)
	[ "$v" -le "$cap" ] || return 1
	return 0
}

K80_CAP_BASE=15600

scale_by_cap() {
	local v=$1 cap r
	case "$v" in ''|*[!0-9]*) echo ""; return 1 ;; esac
	[ "$v" -le 0 ] && { echo 0; return 0; }

	cap=$(cal_max 2>/dev/null)
	case "$cap" in ''|*[!0-9]*) cap=$K80_CAP_BASE ;; esac
	[ "$cap" -le 0 ] && cap=$K80_CAP_BASE

	[ "$cap" -eq "$K80_CAP_BASE" ] && { echo "$v"; return 0; }

	r=$(( (v * cap + K80_CAP_BASE / 2) / K80_CAP_BASE ))

	[ "$r" -le 0 ] && r=1
	echo "$r"
	return 0
}

clamp_to_cap() {
	local v=$1 cap
	case "$v" in ''|*[!0-9]*) echo ""; return 1 ;; esac
	cap=$(cal_max 2>/dev/null)
	case "$cap" in ''|*[!0-9]*) echo "$v"; return 0 ;; esac
	[ "$cap" -le 0 ] && { echo "$v"; return 0; }
	[ "$v" -gt "$cap" ] && v="$cap"
	echo "$v"
	return 0
}

clamp_profile_defaults() {
	I_LOW=$(clamp_to_cap "$I_LOW")
	I_MID=$(clamp_to_cap "$I_MID")
	I_PEAK=$(clamp_to_cap "$I_PEAK")
	I_MID2=$(clamp_to_cap "$I_MID2")
	I_LOW2=$(clamp_to_cap "$I_LOW2")
	return 0
}

apply_defaults() {

	#   为什么不再按档位铺不同阶梯、也不再按 SOC 预降：
	#     · 降流是【系统】的策略（fchg_fcc_ma 只是"申请额度"），
	#       模块自己先降一档 = 把系统的降流提前了（双重降流）；
	#     · 按档位铺阶梯是旧设计，实测在 9V 体系上会要出
	#       不可持续电流（15600mA @9.5V ≈ 148W）→ 电压塌陷 5V
	#       → 协议重协商 → 功率反复跳变。
	#   现在三个档位都只申请同一个上限，是否真的降流由系统决定；
	#   激进/温和/原厂的区别保留在 ACTIVE（协议门禁、写入时机）上。
	#   ★ v3515 修复（真实 bug）：原实现 scale_by_cap "$(cal_max)" 会【双重缩放】。
	#
	#   【现象】scale_by_cap(v) 的语义是「把 v 从 15600 基准按 cap 比例换算」：
	#       r = v * cap / 15600
	#     而这里传进去的 v 已经是 cal_max 本身了，于是变成：
	#       r = cal_max * cal_max / 15600
	#     cal_max=15600 时恰好等于 15600（自洽），所以一直被掩盖；
	#     cal_max=14100 时算出 12744 —— 比本机 DT 上限少 1356mA。
	#     实测验证（2026-10-21）：
	#       scale(14100,14100) = 12744   ← 错的
	#       scale(15600,15600) = 15600   ← 巧合正确
	#   上一版把 cal_max 抬到 15600 正好掩盖了这个缺陷；
	#   本次默认值回归本机值 14100，它就会立刻现形（表现为「档位表全变成 12744」）。
	#
	#   【修法】默认值就该直接等于上限，不需要任何比例换算。
	#     原来的 scale_by_cap 只在「换到上限更高的机型、要按比例放大基表」时才需要，
	#     而本机三档本来就全平（不按 SOC 预降），没有基表可放大。
	#     因此直接取 cal_max，绕开整个缩放层。
	#   ★ v3516 关键修复：新增「保留用户值」模式
	#
	#   【原缺陷】apply_defaults 无条件把 I_* 五段全部重设成 cal_max()。
	#     它被 write_profile 调用，而 write_profile 又在 load_profile 的
	#     「阶梯迁移收尾」里被调用 —— 于是每次迁移/重载都会把用户
	#     在段位表里手动设的值（比如 9000）整段抹掉，换回上限值。
	#     表现就是用户说的「设置好会自动弹回」。
	#
	#   【修法】加一个全局开关 APPLY_DEFAULTS_KEEP_I：
	#     调用方在「只想重载配置、不想铺默认」时把它置 1，
	#     apply_defaults 就只更新 ACTIVE/档位名，不动 I_*。
	#     write_profile 的迁移收尾路径正是这种场景。
	#   ★ v3529：默认值改为【总闸值 VOTE_IBAT】，不再用 cal_max()。
#
#     【为什么】原来铺的是 cal_max()（14100，硬件上限），而注入时又和
#     总闸（9000）取 min —— 分段永远被压住，等于白铺。现在让分段默认
#     等于总闸，语义统一：注入值 = 总闸 × 温度降额。
#     用户若想要某段更低（慢充），在段位表里单独改即可，min() 会生效。
#
#     【必须现读文件，不能用内存变量】apply_defaults 在 load_profile 里
#     被调用的位置【早于】逐行读 profile 的那段循环，此刻内存里的
#     VOTE_IBAT 还是初值。直接读文件才拿得到用户真实设置。
	_I=""
	if [ -f "$PROFILE_FILE" ]; then
		_I=$(sed -n 's/^VOTE_IBAT=\([0-9][0-9]*\)$/\1/p' "$PROFILE_FILE" 2>/dev/null | head -n 1)
	fi
	case "$_I" in ''|*[!0-9]*) _I="$IBAT_DEFAULT" ;; esac
	case "$_I" in ''|*[!0-9]*) _I=9000 ;; esac
	[ "$_I" -le 0 ] && _I=9000

# 保留用户已设的 I_*（仅切换档位名，不复位电流）
_KEEP_I="$APPLY_DEFAULTS_KEEP_I"

	case "$1" in
		2)
			[ "$_KEEP_I" != "1" ] && { I_LOW=$_I; I_MID=$_I; I_PEAK=$_I; I_MID2=$_I; I_LOW2=$_I; }
			ACTIVE=2; PROFILE_NAME="温和"
			SEG_LOW_NAME="温和低段";  SEG_MID_NAME="温和中段"
			SEG_PEAK_NAME="温和峰值"; SEG_MID2_NAME="温和中高"
			SEG_LOW2_NAME="温和高段"
			;;
		3)
			[ "$_KEEP_I" != "1" ] && { I_LOW=$_I; I_MID=$_I; I_PEAK=$_I; I_MID2=$_I; I_LOW2=$_I; }
			ACTIVE=3; PROFILE_NAME="原厂"
			SEG_LOW_NAME="原厂低段";  SEG_MID_NAME="原厂中段"
			SEG_PEAK_NAME="原厂峰值"; SEG_MID2_NAME="原厂中高"
			SEG_LOW2_NAME="原厂高段"
			;;
		*)
			[ "$_KEEP_I" != "1" ] && { I_LOW=$_I; I_MID=$_I; I_PEAK=$_I; I_MID2=$_I; I_LOW2=$_I; }
			ACTIVE=1; PROFILE_NAME="激进"
			SEG_LOW_NAME="超档";   SEG_MID_NAME="高档"
			SEG_PEAK_NAME="峰值";  SEG_MID2_NAME="中档"
			SEG_LOW2_NAME="低档"
			;;
	esac

}

load_profile() {
	local a=1 k v

	# 【重入保护】write_profile 内部会再调 load_profile。若无此保护，
	#   阶梯迁移会自我递归：load_profile -> write_profile -> load_profile
	#   -> 版本检查判定"仍旧版" -> 再调 write_profile -> ... 永不返回。
	#   表现为 getjson 永不退出、界面卡在"连接中"，重开则白屏。
	[ "$PROFILE_LOADING" = "1" ] && return 0
	PROFILE_LOADING=1

	# ★ v3515：CAL_OC 必须【最先】读出来。
	#   原因：本函数后面 apply_defaults / _cap=$(cal_max) / I_* 钳制
	#   全都依赖 cal_max()，而 cal_max() 依赖 CAL_OC。
	#   若等到末尾的温控段才读 CAL_OC，前半段算出的上限全是旧值 ——
	#   表现为「切了超频档，档位表上限还停在 14100」。
	if [ -f "$PROFILE_FILE" ]; then
		local _ock _ocv
		while IFS='=' read -r _ock _ocv; do
			[ "$_ock" = "CAL_OC" ] || continue
			case "$_ocv" in 0|1) CAL_OC=$_ocv ;; esac
			break
		done < "$PROFILE_FILE" 2>/dev/null
		cal_max_refresh
	fi

	if [ -f "$PROFILE_FILE" ]; then
		while IFS='=' read -r k v; do
			case "$k" in
				ACTIVE)
					case "$v" in
						1|2|3) a="$v" ;;
					esac
					;;
			esac
		done < "$PROFILE_FILE" 2>/dev/null
	fi

	apply_defaults "$a"

	# profile 不存在时也要清标志，否则后续所有 load_profile 都会被重入保护挡掉
	if [ ! -f "$PROFILE_FILE" ]; then
		PROFILE_LOADING=0
		return 0
	fi

	# ---- 阶梯版本迁移 ----
	# 旧配置里存的是"按 SOC 预降"的阶梯（激进档 15600/11720/9720/...），
	# 在 9V 体系上会要出不可持续电流，导致电压塌陷 + 协议反复重协商。
	# 检测到旧版就整段丢弃 I_*，保留温控/防掉档/直控等用户设置。
	local _lv="" _iv="" _k2 _v2
	while IFS='=' read -r _k2 _v2; do
		case "$_k2" in
			LADDER_VER) _lv="$_v2" ;;
			IBAT_VER)   _iv="$_v2" ;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null
	# 迁移进行中时不再重新武装 —— 否则 write_profile 内部的 load_profile
	# 会把 LADDER_MIGRATE 又置 1，形成自我递归。
	if [ "$MIGRATING" != "1" ]; then
		[ "$_lv" = "$LADDER_VER" ] && LADDER_MIGRATE=0 || LADDER_MIGRATE=1
	fi

	local _cap
	_cap=$(cal_max)
	while IFS='=' read -r k v; do

		case "$k" in
			''|\#*) continue ;;
		esac

		case "$v" in
			''|*[!0-9]*) continue ;;
		esac

		if [ "$v" -gt "$_cap" ]; then
			log "档位配置: $k=$v 超过本机上限 ${_cap}mA，已钳制到 ${_cap}"
			v="$_cap"
		fi

		case "$k" in
			I_LOW)  I_LOW=$v  ;;
			I_MID)  I_MID=$v  ;;
			I_PEAK) I_PEAK=$v ;;
			I_MID2) I_MID2=$v ;;
			I_LOW2) I_LOW2=$v ;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null

	while IFS='=' read -r k v; do
		case "$k" in
			''|\#*) continue ;;
		esac
		case "$v" in
			''|*[!0-9]*) continue ;;
		esac
		case "$k" in
			VOTE_MODE) [ "$v" = "1" ] && VOTE_MODE=1 || VOTE_MODE=0 ;;
			VOTE_IBAT)  VOTE_IBAT=$v  ;;
			VOTE_T1)    VOTE_T1=$v    ;;
			VOTE_T2)    VOTE_T2=$v    ;;
			VOTE_T3)    VOTE_T3=$v    ;;
			VOTE_T4)    VOTE_T4=$v    ;;
			VOTE_T5)    VOTE_T5=$v    ;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null

	# ---- 电流总闸默认值迁移（IBAT_VER）----
	#   v1：默认 9000 → 11500（旧配置只抬不降）
	#   v2：默认改回 9000
	#   v3：默认 14100（本机 V2352A 的 DT 电流硬上限）
	#   v4：默认【跟随 cal_max()】—— 本机 DT 14100，超频档 15600
	#   v5（v3525）：默认回归原版 9000，【放弃跟随 cal_max()】
	#     · 原版注释：注入值本身就是"总闸×温度降额"，顶到硬件上限跑
	#       会触发系统的降流/协议重协商反击
	#     · 本机实测：8190 / 9000 / 15600 三者功率几乎相同，
	#       但 9000 最稳、温度最低
	#     迁移规则：
	#       ① v<=5 且值恰为 9000 → 判定为 v5 的旧默认，抬到本机 DT 标定 14100
	#       ② 其余值（用户手改过的，如 11500/8000/6400）→ 一律保留
	#       ③ 无标记 / 非法值 → 用新默认 14100
	#   已是最新版本（_iv == IBAT_VER）的 profile 完全不动。
	_ibtgt="$IBAT_DEFAULT"
	case "$_ibtgt" in ''|*[!0-9]*|0) _ibtgt=14100 ;; esac
	if [ "$MIGRATING" != "1" ]; then
		if [ "$_iv" != "$IBAT_VER" ]; then
			case "$VOTE_IBAT" in
				''|*[!0-9]*)
					VOTE_IBAT="$_ibtgt"
					;;
				*)
					# ① v<=5 且值恰为 9000 -> 那是 v5 的旧默认，抬到 14100
					if [ -n "$_iv" ] && [ "$_iv" -le 5 ]; then
						if [ "$VOTE_IBAT" = "9000" ]; then
							log "总闸 9000mA 是 v5 的旧默认，已抬到本机 DT 标定 ${_ibtgt}mA"
							VOTE_IBAT="$_ibtgt"
						fi
					fi
					# ② 其余（含用户手改）不动
					;;
			esac
			IBAT_MIGRATE=1
		fi
	fi

	# ---------------- 温控 / 防掉档配置（WebUI 可调）----------------
	#   单位说明：THERM_START/STOP 为 0.1C；SAFE_CAP 为 mA（0=机型默认）
	#   这两组允许写 0，所以单列一个循环，不与上面"必须为正"的校验混用。
	while IFS='=' read -r k v; do
		case "$k" in
			''|\#*) continue ;;
		esac
		case "$v" in
			''|*[!0-9]*) continue ;;
		esac
		case "$k" in
			THERM_EN)    case "$v" in 0|1) THERM_EN=$v ;; esac ;;
			THERM_START) THERM_START=$v ;;
			THERM_STOP)  THERM_STOP=$v  ;;
			SAFE_EN)     case "$v" in 0|1) SAFE_EN=$v ;; esac ;;
			SAFE_CAP)    SAFE_CAP=$v    ;;
			CAL_OC)      case "$v" in 0|1) CAL_OC=$v ;; esac ;;
			LOG_EN)      case "$v" in 0|1) LOG_EN=$v ;; esac ;;
			# ★ v3536：停止介入电量。夹在 SOC_STOP_MIN..SOC_STOP_MAX 内，
			#   并且绝不能 <= SOC_MIN（否则模块永远不介入，等于没装）。
			SOC_STOP)
				case "$v" in
					''|*[!0-9]*) ;;
					*)
						[ "$v" -lt "$SOC_STOP_MIN" ] && v=$SOC_STOP_MIN
						[ "$v" -gt "$SOC_STOP_MAX" ] && v=$SOC_STOP_MAX
						[ "$v" -le "$SOC_MIN" ] && v=$((SOC_MIN + 1))
						SOC_MAX=$v
						;;
				esac
				;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null

	# 由三个温控参数派生板级阈值（保证状态机与界面同源）
	therm_sync

	# ★ v3541：把分段边界（T1..T4）钳制到停止线（SOC_MAX）之内。
	#   【为什么必须放在这里】SOC_MAX 从 profile 读进来之后、任何
	#   target_current() / emit_json() 调用之前。load_profile 是所有配置
	#   变更的必经之路（启动 + 各处热重载），放这里能保证：
	#     · 守护进程每轮用到的 T* 都是钳制后的值
	#     · emit_json 发给前端的 bounds 也是钳制后的值（标签不会倒挂）
	#   不这样做的话，用户把停止线调到 85 就会出现 mid2 段显示
	#   "86~89%" 但实际永远命中不到 —— 死段。
	soc_bounds_clamp

	# ★ v3515：CAL_OC 刚从 profile 读进来，必须让 cal_max 缓存失效。
	#   否则本函数前半段（_cap=$(cal_max)、apply_defaults）算出的
	#   都是【上一轮 CAL_OC 的上限】—— 表现为"切了超频档但档位表还是旧上限"。
	cal_max_refresh

	_vt_fix_thresholds

	# 重算安全表（设备类别 + 静态封顶）。
	#   【为什么放在 load_profile 里】
	#   load_profile 是所有"配置变更"的必经之路（启动 + 4 处热重载），
	#   而 SAFE_CAP 只影响 load_safe_table 的输出。若只在守护启动时算一次，
	#   "保存了但没反应"是同一类缺陷。本函数幂等且已做日志去抖。
	load_safe_table

	# ---- 阶梯迁移收尾：把新阶梯落盘 ----
	#   不落盘的话每次热重载都会重置，用户在段位表里改的值存不住。
	#   走 write_profile 全量重写（它会保留已加载的温控/防掉档/直控设置）。
	PROFILE_LOADING=0

	if [ "$LADDER_MIGRATE" = "1" ] || [ "$IBAT_MIGRATE" = "1" ]; then
		local _lm _im
		_lm=$LADDER_MIGRATE
		_im=$IBAT_MIGRATE
		LADDER_MIGRATE=0
		IBAT_MIGRATE=0
		if [ "$_lm" = "1" ]; then
			log "检测到旧版电流阶梯（按 SOC 预降），已升级为统一 ${I_LOW}mA 并停用预降"
		fi
		if [ "$_im" = "1" ]; then
			log "电流总闸默认值已对齐 ${VOTE_IBAT}mA（默认 9000；只回退上一版自动抬高的值，手动改过的不动）"
		fi
		# PROFILE_LOADING 必须先清零，否则 write_profile 内部的 load_profile
		#   会被重入保护挡掉、读不到配置；改用 MIGRATING 阻止自我递归。
		MIGRATING=1
		write_profile "$ACTIVE"
		MIGRATING=0
	fi

	return 0
}

# 默认开启硬件直控：骁龙机型装完即生效（这正是修「18V 掉回 9V」的关键）。
# 天玑机型 pmic-votable 接口不存在，votable_ready 会直接返回，天然跳过。
VOTE_MODE=1
#   ------------------------------------------------------------
#   注入目标：【固定 USER_IBAT + USER_IBUS，不做任何自动改判】。
#   这两路是 120 机型（iQOO13 / Neo10 Pro+）实测定标下来的，
#   换回另外的目标会「稳不住」—— 目标本身是当时为解决稳定性
#   才改过来的，不是顺手改的，所以这里保持不动。
#   「qcom 绝不回退 sysfs 申请层」同样保留（回退会走 USER_FCC_EVENT
#   二次裁定 → 触发协议重协商掉压，那才是 18V 掉回 9V 的成因）。
#   VOTE_TARGETS_KNOWN 只用于【卸载/恢复时扫干净】：把历史上可能
#   被写过的目标一起解除 force_active，避免残留（不参与注入）。
# ★ v3525【回归原版】：注入目标改为【USER_IBAT 单路】，不再带 USER_INPUT。
#
#   【为什么去掉 USER_INPUT】本机实测它的原始投票值是百分比语义：
#       USER_INPUT: NORMAL_CHARGE  en=1 v=100      ← 100 是 100%，不是 100mA
#   虽然 force_val 写 14100 也能被接受、effective 显示 DEBUG_FORCE_CLIENT
#   v=14100，但下游 cms 拿到的是"14100%"，语义已经污染。
#   原版注释也写得很清楚：
#     "注入目标固定 USER_IBAT + USER_IBUS（120 机型实测定标，不做自动改判）"
#     "VOTE_IBAT 是主通道；IBUS 只是输入总线的伴随解除"
#   本机 USER_IBUS 不存在，vot_inject 里 `[ ! -d "$d" ] && continue` 会静默跳过，
#   所以【单写 USER_IBAT】等价于原版在本机的正确形态。
#
#   【为什么不再自动改判】原版 vot_resolve_targets 的注释原文：
#     "唯一的例外：votset 手动钉住。【默认不启用】—— 不用自动判定，
#      因为默认这两路正是当初为解决『稳不住』才选定的，
#      自动改判会把那个问题重新引回来。"
#   之前这版搞自动扫描 + 永不附加 DCHG_FCC，属于自作聪明，已回退。
#
#   【DCHG_FCC 仍留在 KNOWN 里】只用于卸载/恢复时扫干净历史残留的
#   force_active，不参与注入。实测强制它会短路快充协商：
#   main_sm 停在 INIT、fchg_fcc_ma=0、功率 36W -> 26W。
# ★ v3545：注入目标改为 DCHG_FCC 单路（用户决定废弃 USER_IBAT）。
#   【为什么改】本机实测（2026-10-27）：USER_IBAT 是【百分比/倍率】通道——
#     status 里的原始投票是 NORMAL_CHARGE v=135、INTELL_CHARGE v=41，
#     全是 41/120/135 这类倍率数字，不是毫安。往里写 14100 等于写 14100%，
#     荒谬倍率被 Min 聚合直接压到最小的 INTELL_CHARGE v=41，等于【完全没生效】。
#     （这也解释了一直以来的"force_val 莫名其妙变成 153/120/135"——
#      那些是通道释放后回落到系统自己投票的百分比值，不是模块写脏数据。）
#   而 DCHG_FCC 的 status 全是 mA 域量：
#     FCHG_DEFAULT_EVENT v=14100 / ADAPTER_POWER_EVENT v=20000 /
#     CABLE_R_EVENT v=14100 / USER_FCC_EVENT v=2421（随 SOC 变化）
#   实测往 DCHG_FCC 写 6000 → 电池电流立刻从 1.77A 拉到 4.92A；
#     写 14100 → 4.48A；释放 → 掉回 0.72A。因果明确。
VOTE_TARGETS="DCHG_FCC"
VOTE_TARGETS_KNOWN="DCHG_FCC USER_IBAT USER_IBUS USER_INPUT"
VOTE_TARGETS_RESOLVED=""
VOT_SEL_WHY=""
VOT_SEL_LOGGED=0
#   手动钉住目标的逃生口（【默认不启用】，只在你明确指定时才生效）：
#     写 `sh /system/bin/vfcs_boost votset <目标名>` 钉住；
#     写 `votset auto` 清除、回到上面的默认两路。
#   用途：先用 votdiag 看清本机哪个目标「真的有人在投票」，
#   若确认默认两路是死通道，再手动钉一个 —— 由你决定，不自动切换。
VOT_PIN_FILE="/data/adb/v2352a_charge_boost.vot_target"

VOTE_IBAT=$IBAT_DEFAULT
VOTE_T1=340
VOTE_T2=346
VOTE_T3=401
VOTE_T4=450
VOTE_T5=500

# 注入阶梯（由 therm_sync 从 THERM_START/STOP 派生，这里是首轮兜底）
VT_T1=340
VT_T2=346
VT_T3=401
VT_T4=450
VT_T5=500

VOT_ROOT="/sys/kernel/debug/pmic-votable"
VOT_OK=""
PROTO_NODE_MISSING=0
PROTO_WARNED=0
LOG_PREV_CAP=""
LOG_PREV_MAX=""
LOG_PREV_PWR=""
LOG_PREV_SCALE=""
LOG_PREV_THERM=""
VOT_WHY=""
VOT_WROTE=0
VOT_ORIG_MARK=""
# ★ v3523：记录最后一次真正注入的目标值，供拔线释放时写进日志。
#   不能用 ST_CUR —— 它在 do_once 每轮开头就被清成空串，
#   走到 online=0 那段时永远是空，日志会变成"原注入 ?mA"。
VOT_LAST_WANT=""

VOTE_PCT1=97
VOTE_PCT2=91
VOTE_PCT3=81
VOTE_PCT4=72
VOTE_PCT_FLOOR=63
VOTE_FLOOR_MIN=1000

_vot_mark_session() {
	VOT_ORIG_MARK="/data/adb/v2352a_charge_boost.vot_session"
	[ -f "$VOT_ORIG_MARK" ] && return 0
	local _bid
	_bid=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
	{
		echo "boot_id=$_bid"
		echo "wrote=1"
	} > "$VOT_ORIG_MARK" 2>/dev/null
	return 0
}

# ---- 门限校验（保留函数签名；阶梯已由 therm_sync 单一派生）----
# 现在 VOTE_T*/VT_T* 由 therm_sync 从 THERM_START/STOP 推导，天然单调，
# 不再需要在读配置时排序。此函数仅做非空兜底（防止未调 therm_sync 的
# 极端路径下出现空值）。
_vt_fix_thresholds() {
	[ -n "$VT_T1" ] || VT_T1=340
	[ -n "$VT_T2" ] || VT_T2=346
	[ -n "$VT_T3" ] || VT_T3=401
	[ -n "$VT_T4" ] || VT_T4=450
	[ -n "$VT_T5" ] || VT_T5=500
	VOTE_T1=$VT_T1; VOTE_T2=$VT_T2; VOTE_T3=$VT_T3
	VOTE_T4=$VT_T4; VOTE_T5=$VT_T5
	return 0
}

# 读某个 votable 目标的 status 文本（只有 status 一个文件；无则空）
_vot_status_of() {
	[ -f "$VOT_ROOT/$1/status" ] || return 0
	cat "$VOT_ROOT/$1/status" 2>/dev/null
	return 0
}

# 某目标是否【真的有人在投票】。
#   判据：status 里存在一条非调试强制客户端的 `en=1`。
#   为什么排除 DEBUG_FORCE：那是【我们自己】注入用的强制客户端，
#   若把它算作"有人在投票"，就等于自证式假活 —— 一旦某台机上
#   曾经写过一次，往后永远判定为"可用"，错误再也暴露不出来。
#   （实测反例：USER_IBAT 的 38 个事件全是 en=0，effective=none）
#   读不到 status / 格式不认识 -> 返回 1（不算活），交给优先级兜底。
_vot_is_live() {
	local st line ok=0
	st=$(_vot_status_of "$1")
	[ -n "$st" ] || return 1
	while IFS= read -r line; do
		case "$line" in
			*en=1*|*"en = 1"*|*"en= 1"*|*"en =1"*) ;;
			*) continue ;;
		esac
		case "$line" in
			*DEBUG_FORCE*) continue ;;
		esac
		ok=1
		break
	done <<EOF
$st
EOF
	[ "$ok" = "1" ]
}

# ------------------------------------------------------------
#  注入目标解析（自适应；只在首次判定通道就绪时跑一次）
#   ① 先按优先级表收集「存在且可写」的候选
#   ② 优先选其中「真有人在投票」的（status 有非 DEBUG_FORCE 的 en=1）
#   ③ 全都读不到投票信息 -> 按优先级取首个（本机型 DCHG_FCC 优先）
#   ④ 优先级表一个都没有 -> 扫 votable 根目录的电流类目标兜底
#   ⑤ 全都没有 -> 置空（调用方判定通道不可用，交回系统，不写 sysfs）
# 必须在【首次注入之前】完成：一旦注入过，status 里就混进了
# 我们自己的 DEBUG_FORCE 客户端，判据被污染。
# ------------------------------------------------------------
vot_resolve_targets() {
	local d _pin=""

	[ -n "$VOTE_TARGETS_RESOLVED" ] && return 0
	VOTE_TARGETS_RESOLVED=1

	VOT_SEL_WHY="自适应（本机实测）"

	# 唯一的例外：votset 手动钉住。
	if [ -f "$VOT_PIN_FILE" ]; then
		_pin=$(cat "$VOT_PIN_FILE" 2>/dev/null)
	fi
	case "$_pin" in
		''|auto|AUTO) _pin="" ;;
	esac
	if [ -n "$_pin" ]; then
		d="$VOT_ROOT/$_pin"
		if [ -d "$d" ] && [ -f "$d/force_active" ] && [ -f "$d/force_val" ]; then
			VOTE_TARGETS="$_pin"
			VOT_SEL_WHY="你手动钉住（votset $_pin）"
		else
			log "提示: 钉住的目标 $_pin 在本机不存在，已忽略、改走自适应"
		fi
	fi
	[ -n "$_pin" ] && return 0

	# ============================================================
	#  ★★★ V2352A 本机适配：注入目标改为【按本机实测结果】挑选 ★★★
	# ------------------------------------------------------------
	#  原实现写死 "USER_IBAT USER_IBUS"，本机实测有三处不成立：
	#
	#  ① 【USER_IBUS 在本机根本不存在】
	#     本机 /sys/kernel/debug/pmic-votable 下只有：
	#       DCHG_DISABLE  DCHG_FCC  FCHG_POWER_ENABLE  HCHG_DISABLE
	#       PI_POWER_ENABLE  USB_ICL  USER_IBAT  USER_INPUT
	#       VFCS_CHG_DISABLE  keep_soc  usb_conn_protect
	#     没有 USER_IBUS。原版每轮都往一个不存在的路径写，
	#     靠 vot_inject 里的 `[ ! -d "$d" ] && continue` 静默跳过 ——
	#     等于双路注入在本机【实际只有一路】，注释里"对齐 120w 双路"
	#     在本机是不成立的。
	#     本机真正对应当年 IBUS 语义的是 USER_INPUT。
	#
	#  ② 【USER_IBAT / USER_INPUT 在本机是「倍率百分比」通道，不是 mA】
	#     实测把 9000 写进 USER_IBAT/force_val 能被接受，但看它原本
	#     在跑的投票值就一目了然：
	#       USER_IBAT:  NORMAL_CHARGE  en=1 v=120
	#                   INTELL_CHARGE en=1 v=61     effective v=61
	#       USER_INPUT: NORMAL_CHARGE  en=1 v=100    effective v=100
	#     全是 61/100/120 这种【百分比/倍率】，不是电流毫安值。
	#     往里灌 9000 会变成一个荒谬的倍率，被 Min 聚合直接压死充电。
	#
	#  ③ 【DCHG_FCC 才是本机的 mA 通道，且实测可控】
	#     DCHG_FCC 的 status 里全是 mA 域的量：
	#       FCHG_DEFAULT_EVENT  v=14100
	#       ADAPTER_POWER_EVENT v=20000
	#       USER_FCC_EVENT      v=3602（原文 7558，随 SOC 变化）
	#     实机写入验证（已当场撤销）：
	#       echo 14100 > force_val; echo 1 > force_active
	#       -> effective=DEBUG_FORCE_CLIENT type=Min v=14100   ← 立即接管
	#       echo 0 > force_active
	#       -> effective=USER_FCC_EVENT  v=3602               ← 干净交回
	#     这才是本机唯一「写 mA 有意义、且回读立刻生效」的判决层目标。
	#
	#  结论：本机目标序 = DCHG_FCC（mA 主通道）优先，
	#        其次才是历史兼容的 USER_IBAT/USER_INPUT，但后两者在
	#        mA 注入场景下【不参与】（见 VOT_MODE_MA 判定）。
	#        这样其它机型（iQOO13 / Neo10 Pro+ 等 mV+双路架构）
	#        仍走原来的 USER_IBAT + USER_IBUS —— 它们的通道确实存在。
	# ============================================================

	# ★ v3522 实测定论：只选 USER_IBAT / USER_INPUT，【永不自动附加 DCHG_FCC】。
	#
	#   【三路实测证据】
	#     停止守护后逐个写入 14100 并观察 effective：
	#       USER_IBAT  -> 接管成功，释放后 effective=none v=-22  （空闲口）
	#       USER_INPUT -> 接管成功，释放后 effective=none v=-22  （空闲口）
	#       DCHG_FCC   -> 接管成功，释放后 effective=FCHG_DEFAULT_EVENT v=14100
	#     DCHG_FCC 释放后仍有 FCHG_DEFAULT_EVENT 在投票，说明它是【活通道】，
	#     而且投票者里全是快充协商参与者（协议/适配器/线材/线阻/IC限流/模式）。
	#     强制它 = 短路整套协商 -> 实测 main_sm 卡 INIT、功率 36W 掉到 26W。
	#
	#   【规则（v3525 回归原版）】
#     ① 默认就用 VOTE_TARGETS 写死的 USER_IBAT，【不做自动扫描改判】
#        原版注释："不用自动判定，因为默认这两路正是当初为解决
#        『稳不住』才选定的，自动改判会把那个问题重新引回来。"
#     ② 如果 USER_IBAT 在本机不存在（理论不会发生），才做一次最小兜底：
#        扫出存在且可写的 USER_IBAT / USER_IBUS / USER_INPUT，
#        但【DCHG_FCC 永不入选】—— 强制会短路快充协商。
#     ③ DCHG_FCC 只保留在 VOTE_TARGETS_KNOWN 里，供卸载/恢复扫残留
	local _t d
	for _t in $VOTE_TARGETS; do
		d="$VOT_ROOT/$_t"
		if [ -d "$d" ] && [ -f "$d/force_active" ] && [ -f "$d/force_val" ]; then
			return 0
		fi
	done

	# ---- 兜底：写死目标在本机不存在，才扫一次 ----
	# ★ v3545：兜底只认 DCHG_FCC（mA 域）。USER_* 是百分比域，选了也没用。
	local _ok=""
	for _t in DCHG_FCC; do
		d="$VOT_ROOT/$_t"
		[ -d "$d" ] || continue
		[ -f "$d/force_active" ] || continue
		[ -f "$d/force_val" ] || continue
		_ok="$_ok $_t"
	done
	_ok=${_ok# }
	if [ -n "$_ok" ]; then
		VOTE_TARGETS="$_ok"
		VOT_SEL_WHY="默认目标不存在，兜底扫到：$_ok"
		log "提示: 默认目标 $VOTE_TARGETS 在本机不存在，已兜底为：$_ok"
		return 0
	fi

	VOTE_TARGETS=""
	VOT_SEL_WHY="本机无 DCHG_FCC 电流口"
	return 0
}

# ---- 判定当前注入通道的【量纲】----
#   ma   = 目标是 mA 域（DCHG_FCC），直接注入电流值
#   pct  = 目标是百分比/倍率域（USER_IBAT / USER_INPUT），
#          不能灌 mA，只能做「相对缩放」，或者干脆不注入
#   【为什么必须分开】本机 USER_IBAT 的 effective 是 v=61（倍率），
#   往里写 9000 会被 Min 聚合当成 9000 倍处理 —— 见 vot_resolve_targets
#   里的实机证据。混着用就是「装上就充不进电」。
# ★ v3523 修复：域判定不能再「有 DCHG_FCC 就是 mA，否则 pct」。
#
#   【原缺陷】
#     原实现只认 DCHG_FCC 一个名字，其余一律 pct。而 v3522 已把注入目标
#     改成 USER_IBAT + USER_INPUT（不含 DCHG_FCC），于是这个函数永远返回
#     "pct" —— 直接后果：
#       ① vot_inject 的 mA 护栏整段被跳过（<500 脏值不拦、>DT 上限不钳）
#       ② 语义上把 14100mA 当成 14100%（虽然当前调用方没走 vot_pct_of，
#          但这是一颗随时会炸的雷）
#
#   【为什么 USER_IBAT / USER_INPUT 是 mA 域】
#     本机实测（守护停止、逐个写入 14100）：
#       USER_IBAT  -> force_val 回读 14100，effective=DEBUG_FORCE_CLIENT v=14100
#       USER_INPUT -> force_val 回读 14100，effective=DEBUG_FORCE_CLIENT v=14100
#       DCHG_FCC   -> 同上
#     三路都把 14100 当原值接受，单位就是 mA（写 14100% 无意义）。
#     而它们释放后 effective 回到 none（DCHG_FCC 回 FCHG_DEFAULT_EVENT），
#     说明 USER_* 是纯外部注入口、DCHG_FCC 是活通道。
#
#   【现在按名字表判定，可按机型扩展】
vot_mode_of() {
	local t
	for t in $VOTE_TARGETS; do
		case "$t" in
			# mA 域：本机实测三路都按 mA 原值接受
			DCHG_FCC|USER_IBAT|USER_INPUT|USER_IBUS|USB_ICL|DCHG_IBAT)
				echo "ma"; return 0
				;;
		esac
	done
	# 未知目标：保守按 pct 处理（pct 路径不会写坏 mA 通道的已知范围）
	echo "pct"
	return 0
}

# 任一投票目标可用即视为通道就绪（注入时逐个遍历）
_vot_any_ready() {
	local t d
	for t in $VOTE_TARGETS; do
		d="$VOT_ROOT/$t"
		if [ -d "$d" ] && [ -f "$d/force_active" ] && [ -f "$d/force_val" ]; then
			return 0
		fi
	done
	return 1
}

votable_ready() {
	[ "$VOT_OK" = "1" ] && return 0
	[ "$VOT_OK" = "0" ] && return 1

	if [ ! -d "$VOT_ROOT" ]; then

		mount -t debugfs none /sys/kernel/debug 2>/dev/null
	fi
	if [ ! -d "$VOT_ROOT" ]; then
		VOT_WHY="debugfs 未挂载或本机无 pmic-votable（MTK 架构实测为空目录）"
		VOT_OK=0
		return 1
	fi

	# ★ 目标自适应解析：必须在任何一次注入之前完成 ——
	#   注入过之后 status 里会混入我们自己的 DEBUG_FORCE 客户端，
	#   判据被污染，就再也分不清"本来有人投票"和"只有我们在写"。
	vot_resolve_targets

	if [ -z "$VOTE_TARGETS" ] || ! _vot_any_ready; then
		VOT_WHY="pmic-votable 下无 [$VOTE_TARGETS]（缺 force_active/force_val）"
		VOT_OK=0
		return 1
	fi

	VOT_WHY=""
	VOT_OK=1

	if [ "$VOT_SEL_LOGGED" != "1" ]; then
		VOT_SEL_LOGGED=1
		log "注入目标: $VOTE_TARGETS （$VOT_SEL_WHY）"
	fi
	return 0
}

vot_pct_of() {

	echo $(( $2 * $1 / 100 ))
}

vot_temp_cap() {
	local t _base
	t=$1
	_base=$VOTE_IBAT

	case "$_base" in
		''|*[!0-9]*) _base=6400 ;;
	esac
	[ "$_base" -lt "$VOTE_FLOOR_MIN" ] && _base=$VOTE_FLOOR_MIN

	case "$t" in
		''|*[!0-9]*) echo 0; return ;;
	esac

	if [ "$t" -ge "$VOTE_T5" ]; then
		echo $(( _base * VOTE_PCT_FLOOR / 100 ))
	elif [ "$t" -ge "$VOTE_T4" ]; then
		echo $(( _base * VOTE_PCT4 / 100 ))
	elif [ "$t" -ge "$VOTE_T3" ]; then
		echo $(( _base * VOTE_PCT3 / 100 ))
	elif [ "$t" -ge "$VOTE_T2" ]; then
		echo $(( _base * VOTE_PCT2 / 100 ))
	elif [ "$t" -ge "$VOTE_T1" ]; then
		echo $(( _base * VOTE_PCT1 / 100 ))
	else
		echo "$_base"
	fi
}

vot_calc() {
	local t cap _base
	_base=$VOTE_IBAT
	case "$_base" in
		''|*[!0-9]*) _base=6400 ;;
	esac
	t=$(read_temp)
	case "$t" in
		''|*[!0-9-]*)

			cap=$(( _base * VOTE_PCT3 / 100 ))
			;;
		*)
			cap=$(vot_temp_cap "$t")
			;;
	esac

	[ "$cap" -gt "$VOTE_IBAT" ] && cap=$VOTE_IBAT

	[ "$cap" -lt "$VOTE_FLOOR_MIN" ] && cap=$VOTE_FLOOR_MIN
	echo "$cap"
}
# ---- 台账：只记首次，绝不覆盖（仿 bk_record 语义）----

vot_backup() {
	[ -f "$VOT_ORIG" ] && return 0
	local t d fa fv seen=" "
	{
		echo "# PMIC voter 原值台账（只记首次）"
		# 【为什么遍历两份】解析目标可能随机型/版本变化，只记当前目标
		#   会漏掉优先级表里其他目标的原值，卸载时无从还原。去重后全记。
		for t in $VOTE_TARGETS $VOTE_TARGETS_KNOWN; do
			[ -n "$t" ] || continue
			case "$seen" in *" $t "*) continue ;; esac
			seen="$seen$t "
			d="$VOT_ROOT/$t"
			[ -d "$d" ] || continue
			fa=$(cat "$d/force_active" 2>/dev/null)
			fv=$(cat "$d/force_val" 2>/dev/null)
			echo "[$t] force_active=$fa force_val=$fv"
		done
	} > "$VOT_ORIG" 2>/dev/null
}

vot_release() {
	local t d seen=" " _scope
	# ★★ v3565 修复：只释放【自己真正写过的】目标，绝不碰 vivo 自己的通道 ★★
	#
	#   【原缺陷】这里原来遍历 $VOTE_TARGETS $VOTE_TARGETS_KNOWN，
	#     而 VOTE_TARGETS_KNOWN="DCHG_FCC USER_IBAT USER_IBUS USER_INPUT"。
	#     模块实际只注入 VOTE_TARGETS（本机 = DCHG_FCC），
	#     却每次释放都去把 USER_IBAT / USER_INPUT 的 force_active 也写 0。
	#
	#   【本机实测证据】把 USER_IBAT/force_active 写 0 之后等 8 秒：
	#       USER_IBAT   fa=0 -> 8 秒后 fa=1（vivo 自己写回来）
	#       USER_INPUT  fa=0 -> 8 秒后 fa=1（vivo 自己写回来）
	#     force_val 也不是模块写的值：它跟着电量走（135 -> 120），
	#     正是 vivo NORMAL_CHARGE 自己的投票值。
	#     => 这两个通道的 fa=1 是【vivo 的正常状态】，不是模块残留。
	#
	#   【危害】vot_release 有 6 个调用点，其中 do_once 里那处
	#     （rc!=0 且 VOT_WROTE!=0）在主循环正常路径上。
	#     于是模块每次从"干预中"切到"不干预"，都会去抢走
	#     vivo 用来做温控降额的投票通道，vivo 再写回 —— 互相干扰。
	#
	#   【修法】默认只清 VOTE_TARGETS。
	#     VOTE_TARGETS_KNOWN 只在显式全表清扫时用（VOT_SWEEP_ALL=1），
	#     目前只有 restore / uninstall 这类"彻底交回"场景才需要。
	_scope="$VOTE_TARGETS"
	[ "$VOT_SWEEP_ALL" = "1" ] && _scope="$VOTE_TARGETS $VOTE_TARGETS_KNOWN"
	for t in $_scope; do
		[ -n "$t" ] || continue
		case "$seen" in *" $t "*) continue ;; esac
		seen="$seen$t "
		d="$VOT_ROOT/$t"
		[ -f "$d/force_active" ] || continue
		echo 0 > "$d/force_active" 2>/dev/null
		# ★ V2352A 本机适配：force_active=0 之后把 force_val 也归零。
		#   本机实测（DCHG_FCC）：
		#     echo 14100 > force_val; echo 1 > force_active
		#     echo 0 > force_active
		#     -> force_active=0 但 force_val 仍停在 14100
		#   effective 确实回到了 USER_FCC_EVENT，所以【功能上】没残留；
		#   但下一次安装/另一份脚本读 force_val 做「原值台账」时，
		#   会把这个 14100 当成"注入前的原始值"记下来 → 交回时写错。
		#   本机驱动不把它当裁刀，归零是安全的（只有 active=1 才生效）。
		#   百分比域同样处理：归零后 active=0，不参与聚合。
		echo 0 > "$d/force_val" 2>/dev/null
	done
	# ★ v3545：已删除 v3544 的「回读重试」段。
	#   【为什么删】那段代码把「force_val 不是 0 就算脏」当成判据，
	#     但 USER_IBAT / USER_INPUT 是【百分比频道】，释放后内核会把 force_val
	#     回落成系统自己的投票值（135 / 100 这类倍率）。
	#     于是那段会永远判定“不干净”，反复重写 0，
	#     等于持续干扰系统投票。它不仅没修好任何问题，
	#     还会造成新的干扰。
	#   【正确语义】只要 force_active=0 就是已经交回系统；
	#     force_val 停在什么值都无所谓（它不参与投票）。
	VOT_WROTE=0
	return 0
}

# 向【所有可用】的投票目标注入同一个值（120w 的做法：IBAT/IBUS 都写）
# 逐个目标：先写 force_val 再写 force_active=1，最后回读校验；
# 任一目标回读不符即熔断并全部释放（宁可不干预，也不留半生效状态）。
vot_inject() {
	local want=$1 t d cur ok=0

	votable_ready || return 1
	[ "$VOT_OK" = "1" ] || return 1

	# ★ V2352A 本机适配：mA 域注入前加合理性护栏。
	#   本机 DCHG_FCC 的 status 里同域数值是 3602 / 7558 / 14100 / 20000，
	#   DT 声明上限 vivo,fchg-curr-max-ma = 14100。
	#   实测往 force_val 写 14100 立即被接受（DEBUG_FORCE_CLIENT v=14100），
	#   说明通道不做范围裁剪 —— 也就是说【写多少就是多少】，
	#   写超上限不会被驱动挡住。所以这里必须自己拦：
	#     · < 500mA   ：低于任何有意义充电电流，视为脏值，不写
	#                   （历史教训：写 0 会让输入功率从 40W+ 掉到 13W）
	#     · > 本机DT上限 ：压到上限，绝不越过厂商标定
	#   百分比域（USER_*）不走这个护栏，交给 vot_mode_of 分流。
	if [ "$(vot_mode_of)" = "ma" ]; then
		case "$want" in
			''|*[!0-9]*)
				log "voter 注入拒绝: 目标值非法（'$want'）"
				return 1
				;;
		esac
		if [ "$want" -lt 500 ]; then
			log "voter 注入拒绝: 目标值 ${want}mA 低于安全下界 500mA（疑似脏值/未初始化）"
			return 1
		fi
		local _cap
		_cap=$(cal_max 2>/dev/null)
		case "$_cap" in
			''|*[!0-9]*|0) _cap="" ;;
		esac
		if [ -n "$_cap" ] && [ "$want" -gt "$_cap" ]; then
			log "voter 注入钳制: ${want}mA 超过本机 DT 上限 ${_cap}mA，已压到上限"
			want="$_cap"
		fi
	fi

	[ "$VOT_WROTE" = "0" ] && vot_backup

	VOT_WROTE=1
	VOT_LAST_WANT="$want"
	_vot_mark_session

	for t in $VOTE_TARGETS; do
		d="$VOT_ROOT/$t"
		if [ ! -d "$d" ] || [ ! -f "$d/force_active" ] || [ ! -f "$d/force_val" ]; then
			continue
		fi

		# 已经是目标值且已激活 -> 无需重写
		if [ "$(cat "$d/force_val" 2>/dev/null)" = "$want" ] && \
		   [ "$(cat "$d/force_active" 2>/dev/null)" = "1" ]; then
			ok=$((ok + 1))
			continue
		fi

		echo "$want" > "$d/force_val" 2>/dev/null || continue
		echo 1 > "$d/force_active" 2>/dev/null || continue

		cur=$(cat "$d/force_val" 2>/dev/null)
		if [ "$cur" != "$want" ]; then
			log "voter 熔断: 期望 ${want} 实读 ${cur}（$t 不接受该值）已停手"
			vot_release
			return 1
		fi
		ok=$((ok + 1))
	done

	[ "$ok" -gt 0 ] || return 1
	return 0
}

profile_fingerprint() {
	local k v fp=""
	[ -f "$PROFILE_FILE" ] || { echo "__nofile__"; return 0; }

	# ★ v3517 关键修复：指纹必须包含 CAL_OC。
	#
	#   【原缺陷（"超频档会弹回"的真正根因）】
	#     这个指纹是守护进程判断"配置有没有变、要不要热重载"的唯一依据。
	#     它原来只列了 ACTIVE / I_* / VOTE_* / THERM_* / SAFE_*，
	#     【唯独漏了 CAL_OC】。
	#     于是用户切超频档时：
	#       · setoc 改了 profile 里的 CAL_OC
	#       · 但指纹不变 → 守护认为"配置没变" → 不调 load_profile
	#       · 守护内存里的 CAL_OC 还是旧值
	#       · 每 2 秒往 status.json 写一次 → 把旧 CAL_OC 写回去
	#       · 前端轮询读到旧值 → 界面"弹回"
	#     用户点完开关，看着是对的，2 秒后又变回去 —— 就是这个过程。
	#
	#   【修法】把 CAL_OC 加进指纹。它一变，守护立刻热重载，
	#     内存与磁盘从此同步，前端读到的永远是刚设的值。
	while IFS='=' read -r k v; do
		case "$k" in
			ACTIVE|\
			I_LOW|I_MID|I_PEAK|I_MID2|I_LOW2|\
			VOTE_MODE|VOTE_IBAT|VOTE_T1|VOTE_T2|VOTE_T3|VOTE_T4|VOTE_T5|\
			THERM_EN|THERM_START|THERM_STOP|SAFE_EN|SAFE_CAP|\
			CAL_OC|LOG_EN|SOC_STOP)
				fp="$fp$k=$v;"
				;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null
	[ -n "$fp" ] || fp="__empty__"
	echo "$fp"
}

# ★★★ v3568：零 fork 版指纹 ★★★
#   【为什么】profile_fingerprint 原来用 $(...) 调用，每调一次就 fork 一个
#     子 shell；而它的内部又全是内建 read，本可以在当前 shell 里直接算。
#     未插电时主循环每 6 轮调一次，白白 fork。
#   【做法】结果写进全局变量 PROF_FP_NOW，调用方零 fork 取用。
PROF_FP_NOW=""
profile_fingerprint_fast() {
	local k v fp=""
	PROF_FP_NOW=""
	if [ ! -f "$PROFILE_FILE" ]; then
		PROF_FP_NOW="__nofile__"
		return 0
	fi
	while IFS='=' read -r k v; do
		case "$k" in
			ACTIVE|\
			I_LOW|I_MID|I_PEAK|I_MID2|I_LOW2|\
			VOTE_MODE|VOTE_IBAT|VOTE_T1|VOTE_T2|VOTE_T3|VOTE_T4|VOTE_T5|\
			THERM_EN|THERM_START|THERM_STOP|SAFE_EN|SAFE_CAP|\
			CAL_OC|LOG_EN|SOC_STOP)
				fp="$fp$k=$v;"
				;;
		esac
	done < "$PROFILE_FILE" 2>/dev/null
	[ -n "$fp" ] || fp="__empty__"
	PROF_FP_NOW="$fp"
	return 0
}

# ★★★ v3568：心跳 ★★★
#   看门狗原来靠 fork 一个 shell 跑 __alive 判存活（120ms/次）。
#   改成：daemon 每轮用内建重定向 touch 一个空文件，看门狗只看它的 mtime
#   是否比本轮开始时的标记新。整个过程零 fork。
#   注意用内建 `: > file` 而不是 touch 命令，避免多一个子进程。
HEARTBEAT_FILE=/data/adb/v2352a_charge_boost.beat
beat() {
	: > "$HEARTBEAT_FILE" 2>/dev/null
	return 0
}

daemon_running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

list_daemon_pids() {
	local p

	local me=$$ my_ppid gp ppid_list=""

	ppid_of() {
		sed -n 's/^[0-9]* (.*) [A-Z] \([0-9]*\).*/\1/p' /proc/"$1"/stat 2>/dev/null
	}
	my_ppid=$(ppid_of "$$")
	[ -n "$my_ppid" ] && ppid_list="$my_ppid"

	if [ -n "$my_ppid" ] && [ "$my_ppid" != "1" ]; then
		gp=$(ppid_of "$my_ppid")
		[ -n "$gp" ] && [ "$gp" != "1" ] && ppid_list="$ppid_list $gp"
	fi

	while read -r p args; do
		case "$p" in ''|*[!0-9]*) continue ;; esac
		[ "$p" = "$me" ] && continue

		case " $ppid_list " in *" $p "*) continue ;; esac

		case "$args" in
			*vfcs_boost*__daemon*|*vb.sh*__daemon*) ;;
			*) continue ;;
		esac

		case "$args" in
			*grep*|*awk*) continue ;;
		esac

		echo "$p"
	done <<EOF
$(ps -A -o pid,args 2>/dev/null)
EOF
}

sweep_instances() {
	local keep=$1 p n=0
	for p in $(list_daemon_pids); do
		[ -n "$keep" ] && [ "$p" = "$keep" ] && continue
		kill -9 "$p" 2>/dev/null && n=$((n + 1))
	done
	[ "$n" -gt 0 ] && log "实例清扫：强制回收 $n 个遗留守护进程（防止多实例互写节点）"
	return 0
}

try_lock() {
	local dir=$1 tries=${2:-0} i=0 steals=0
	local parent
	parent=$(dirname "$dir" 2>/dev/null)
	[ -n "$parent" ] && [ "$parent" != "." ] && [ "$parent" != "/" ] && \
		mkdir -p "$parent" 2>/dev/null

	while :; do
		if mkdir "$dir" 2>/dev/null; then
			echo $$ > "$dir/pid" 2>/dev/null
			return 0
		fi

		local h
		h=$(cat "$dir/pid" 2>/dev/null)
		case "$h" in ''|*[!0-9]*) h="" ;; esac
		if [ -z "$h" ] || ! kill -0 "$h" 2>/dev/null; then

			steals=$((steals + 1))
			[ "$steals" -gt 5 ] && { LOCK_HOLDER=""; return 1; }
			rm -rf "$dir" 2>/dev/null
			continue
		fi

		[ "$i" -ge "$tries" ] && { LOCK_HOLDER="$h"; return 1; }
		i=$((i + 1))
		sleep 1
	done
}

unlock() {
	local dir=$1 h
	[ -n "$dir" ] || return 0
	h=$(cat "$dir/pid" 2>/dev/null)
	[ "$h" = "$$" ] && rm -rf "$dir" 2>/dev/null
	return 0
}

acquire_run_lock()  { try_lock "$LOCKDIR/run" 0; }
release_run_lock()  { unlock "$LOCKDIR/run"; }

spawn_daemon() {
	# ============================================================
	# launch 锁：防"两个调用方同时拉起守护"。
	#
	# ★ v3.5.11 修正：抢锁前先确认持锁者是否还活着。
	#   旧版 try_lock 超时后【无条件】rm -rf + 重建锁，等于不管三七二十一
	#   把别人正在用的锁毁掉。若对方进程只是忙（充电时 fork 慢，
	#   临界区里的 sweep_instances + sleep 1 可能超过 10 秒），
	#   就会出现两个调用方同时进入临界区、各自 spawn 一个守护，
	#   多实例互写节点（历史上 sweep_instances 就是为这个而写的）。
	#   现在：持锁者活着 → 放弃抢锁并直接返回（本次不 spawn，
	#   由对方完成）；只有确认持锁者已死才抢。
	# ============================================================

	if ! try_lock "$LOCKDIR/launch" 10; then
		if [ -n "$LOCK_HOLDER" ] && kill -0 "$LOCK_HOLDER" 2>/dev/null; then
			log "启动锁被 pid $LOCK_HOLDER 持有（仍在启动中），本次放弃拉起以免多实例"
			return 0
		fi
		rm -rf "$LOCKDIR/launch" 2>/dev/null
		mkdir "$LOCKDIR/launch" 2>/dev/null
		echo $$ > "$LOCKDIR/launch/pid" 2>/dev/null
	fi

	# ---- 临界区内：清扫所有旧实例（含"进程活着但 pidfile 丢了"的）----
	sweep_instances ""

	local self="$0"
	case "$self" in
		/*) ;;
		*) self="$(cd "$(dirname "$self")" 2>/dev/null && pwd)/$(basename "$self")" ;;
	esac
	[ -f "$self" ] || self="$0"

	if command -v setsid >/dev/null 2>&1; then
		setsid sh "$self" __daemon </dev/null >/dev/null 2>&1 &
	else

		sh "$self" __daemon </dev/null >/dev/null 2>&1 &
	fi
	echo $! > "$PIDFILE"

	sleep 1
	sweep_instances "$(cat "$PIDFILE" 2>/dev/null)"

	# ---- 退出临界区 ----
	unlock "$LOCKDIR/launch"
}

# ============================================================
# ★ v3.5.11：全配置落盘【唯一出口】
# ------------------------------------------------------------
# 旧版有 4 份几乎逐字相同的整文件写出逻辑：
#   write_profile() / _vote_set() / _cfg_set() / set_cal()
# 任何一处漏写某个键，用户保存别的项时就会把那个键"重置回默认"
# （历史上 LADDER_VER / IBAT_VER 就各栽过一次：漏写 → 下次
#   load_profile 误判旧版 → 迁移 → 用户刚保存的值被弹回去）。
# 有了 4 个发生点，下一次一定会再犯。
#
# 现在统一走 save_profile()，键清单只有这一份。
# ★ 新增可配置项时只需改这里 + load_profile 的读取循环 +
#   profile_fingerprint 白名单 + emit_json 输出（见文件头"同步四处"）。
# ============================================================
save_profile() {
	local _tmp="${PROFILE_FILE}.tmp.$$"

	{
		echo "# vivo 充电加速 · 档位配置（由界面生成，可手动编辑）"
		echo "ACTIVE=$ACTIVE"
		echo "VER=3511"
		# ★ 必须写 LADDER_VER：漏写会让下次 load_profile 误判"旧版阶梯"
		#   而触发迁移，把用户刚保存的电流值重置回默认（表现为"保存不了"）。
		echo "LADDER_VER=$LADDER_VER"
		# ★ 必须写 IBAT_VER：漏写会让下次 load_profile 误判"旧默认"，
		#   把用户刚保存的总闸值又抬回 IBAT_DEFAULT（表现为"改低了却弹回去"）。
		echo "IBAT_VER=$IBAT_VER"
		echo "I_LOW=$I_LOW"
		echo "I_MID=$I_MID"
		echo "I_PEAK=$I_PEAK"
		echo "I_MID2=$I_MID2"
		echo "I_LOW2=$I_LOW2"
		echo "VOTE_MODE=$VOTE_MODE"
		echo "VOTE_TARGETS=$VOTE_TARGETS"
		echo "VOTE_IBAT=$VOTE_IBAT"
		echo "VOTE_T1=$VOTE_T1"
		echo "VOTE_T2=$VOTE_T2"
		echo "VOTE_T3=$VOTE_T3"
		echo "VOTE_T4=$VOTE_T4"
		echo "VOTE_T5=$VOTE_T5"
		echo "THERM_EN=$THERM_EN"
		echo "THERM_START=$THERM_START"
		echo "THERM_STOP=$THERM_STOP"
		# ★ v3536：停止介入电量。必须写，否则下次 load_profile 读不到，
		#   SOC_MAX 会退回硬编码默认 90 —— 用户设的值就白设了。
		echo "SOC_STOP=$SOC_MAX"
		echo "SAFE_EN=$SAFE_EN"
		echo "SAFE_CAP=$SAFE_CAP"
		echo "CAL_OC=$CAL_OC"
		echo "LOG_EN=$LOG_EN"
	} > "$_tmp" 2>/dev/null || return 1

	mv -f "$_tmp" "$PROFILE_FILE" 2>/dev/null || {
		rm -f "$_tmp" 2>/dev/null
		return 1
	}
	return 0
}

write_profile() {
	local a=$1

	case "$a" in
		1|2|3) ;;
		*) return 1 ;;
	esac

	# 先读现有配置，保住温控/注入等用户设置；再按目标档铺 I_* 默认。
	#   ★ v3516：调用 load_profile 之前先置「保留用户 I_*」标志。
	#
	#   【为什么】write_profile 有两个调用场景：
	#     ① 用户主动切档（profile write 1|2|3）→ 应该铺该档的新默认值
	#     ② load_profile 内部的「阶梯/总闸迁移收尾」→ 只是想把迁移结果落盘，
	#        绝不该顺手把用户的 I_* 复位
	#   靠 MIGRATING 标志区分：迁移收尾时 MIGRATING=1。
	#   原来两者共用同一条路径，导致每次重载都把用户值抹回上限 ——
	#   这就是「设置好会自动弹回」的真正来源。
	if [ "$MIGRATING" = "1" ]; then
		APPLY_DEFAULTS_KEEP_I=1
		load_profile
		apply_defaults "$a"
		APPLY_DEFAULTS_KEEP_I=0
	else
		load_profile
		apply_defaults "$a"
	fi

	save_profile || return 1

	if [ "$a" = "3" ]; then

		rwhat=$(restore_to_system)
		sweep_instances ""
		rm -f "$PIDFILE" 2>/dev/null
		# ★ v3524：只清运行期锁，保留 service 单实例锁
		rm -rf "$LOCKDIR/run" "$LOCKDIR/launch" 2>/dev/null
		log "档位切换 -> 原厂(3)：已清扫全部实例，交回系统方式=${rwhat:-未知}"

		# ============================================================
		#  ★★ v3533 修：切原厂后主动重写 status.json ★★
		# ------------------------------------------------------------
		#   【问题】status.json 的唯一写入者是守护进程的 refresh_cache。
		#   切到原厂档会把守护杀掉，于是这个文件【冻结在切档前那一轮】，
		#   里面的 active 还是 1、"running":true。
		#   前端每 2 秒轮询读的就是它：
		#     · 前 12 秒（CACHE_MAX_AGE）内缓存被判"新鲜" → 不直读
		#     · 于是界面拿旧值把刚画好的「原厂」选中态刷回「激进」
		#     · 用户看到的就是"点了原厂、跳回激进、过一会儿又对了"
		#   【修法】既然守护已经不在了，就由切换命令自己写一次，
		#   把真实状态（active=3 / running=false）立刻落盘。
		#   前端下一次轮询（≤2 秒）拿到的就是真值，不再需要等缓存过期。
		# ============================================================
		local _ct="${CACHE_FILE}.sw.$$"
		emit_json > "$_ct" 2>/dev/null
		[ -s "$_ct" ] && mv -f "$_ct" "$CACHE_FILE" 2>/dev/null || rm -f "$_ct" 2>/dev/null
	elif daemon_running; then

		# ★ v3533：切到 1/2 档时也立刻刷一次 status.json。
		#   守护虽在跑，但这一轮 do_once 可能正卡在协议等待里（5~15 秒），
		#   期间前端读到的 active 还是旧档 —— 界面先显示新档、2 秒后
		#   又被旧值刷回去，然后再过十几秒才稳定。用户观感就是"弹回"。
		#   这里由切换命令自己写一次真值，把那段窗口抹掉。
		local _ct2="${CACHE_FILE}.sw.$$"
		emit_json > "$_ct2" 2>/dev/null
		[ -s "$_ct2" ] && mv -f "$_ct2" "$CACHE_FILE" 2>/dev/null || rm -f "$_ct2" 2>/dev/null

	else

		spawn_daemon
		# 守护刚拉起，第一轮跑完前 status.json 可能还是旧档，同样补写一次
		local _ct3="${CACHE_FILE}.sw.$$"
		emit_json > "$_ct3" 2>/dev/null
		[ -s "$_ct3" ] && mv -f "$_ct3" "$CACHE_FILE" 2>/dev/null || rm -f "$_ct3" 2>/dev/null
	fi

	return 0
}

profile_name_of() {
	case "$1" in
		1) echo "激进" ;;
		2) echo "温和" ;;
		3) echo "原厂" ;;
		*) echo "未知" ;;
	esac
}

ST_SOC=""; ST_TEMP=""; ST_VBAT=""; ST_IBAT=""; ST_ONLINE=""
ST_CUR=""; ST_GEAR=""; ST_PWR=""; ST_PSRC=""
ST_THERM=""; ST_CAP=""; ST_TMED=""

do_once() {
	[ -e "$NODE" ] || return 1

	# ★★ v3559：未插电【短路】，省掉 60%% 的无效读数 ★★
	#   【为什么能省】原来不管插没插线，都先把 soc / 板温 / 电池温 / vbat / ibat /
	#     输入功率全部读一遍（含嵌在 read_ibat 里的功率交叉验证），读完之后才在
	#     下面判 online=0 -> return 4。未插电这 6 个读数【没有任何人使用】。
	#   【为什么安全】
	#     · emit_json 不读 ST_SOC/ST_TEMP/ST_IBAT/ST_ONLINE（只读 ST_THERM 系列），
	#       前端数据全部由 emit_json 自己现读，不依赖这里。
	#     · safe_guard_sync 只吃 online，这里先调它，拔线解压制的时机不变。
	#     · 未插电时本来就在 return 4 之前不改 ST_CUR/ST_GEAR（下面会清零），
	#       短路后这些全局保持上一轮的值 = 空，与原来清空后的结果一致。
	#   【收益】实测 do_once 563ms -> 约 210ms，单轮少 ~350ms。
	local _ol
	# ★ v3572：改用零 fork 探测（原来 $(read_charger_online) 要 fork 一次，
	#   而它内部还要遍历十几个 sysfs 路径，是本轮最贵的一句）。
	probe_fast
	_ol="$PF_ONLINE"
	ST_ONLINE="$_ol"
	if [ "$_ol" = "0" ]; then
		CHG_OK_CNT=0
		ST_VBAT=""; ST_CUR=""; ST_GEAR=""; ST_PWR=""; ST_PSRC=""
		ST_THERM=""; ST_CAP=""; ST_TMED=""
		ST_TB=""; ST_TC=""; ST_TB_MED=""; ST_TC_MED=""
		return 4
	fi


	local soc temp ibat vbat cur_set online
	local tb tc
	# ★ v3572：上面 probe_fast 已经读过 battery/capacity，直接复用，
	#   省一次 $(read_soc) 的 fork。
	soc="$PF_SOC"

	# ★★ v3552：同 emit_json，read_temp 内部已读 board+batt，不再重复 fork。
	tb=$(read_temp_board)
	tc=$(read_temp_batt)
	if [ -n "$tb" ] && [ -n "$tc" ]; then
		[ "$tb" -lt "$tc" ] && temp="$tb" || temp="$tc"
	elif [ -n "$tb" ]; then
		temp="$tb"
	else
		temp="$tc"
	fi
	ST_TB="$tb"; ST_TC="$tc"
	# ★ v3.5.11：先读 vbat 再读 ibat。
	#   read_ibat 用 vbat 做功率交叉验证来消解"µA 还是 mA"的歧义
	#   （否则 9720µA 这种空闲读数会被当成 9.72A，见函数内注释）。
	vbat=$(read_vbat)
	ibat=$(read_ibat "$vbat")
	# ★★ v3573-fix：恢复原版语义 ★★
	#   这里原来是 online=1（硬编码），很危险：
	#   原版 online 可能是 ""（读不到），下面 "if [ "$online" != "1" ]"
	#   会走“连续 3 轮确认”分支；硬编码成 1 就直接跳过了。
	#   现在改用 probe_fast 的结果，与原版完全等价（含 ""），
	#   同时仍然零 fork（不再重复调 read_charger_online）。
	online="$PF_ONLINE"

	ST_SOC="$soc"
	ST_TEMP="$temp"
	ST_IBAT="$ibat"
	ST_ONLINE="$online"

	# ---- 防掉档：仅充电时压制 + 定期自愈重压（照 120w 模块）----
	# 【位置很关键】必须放在下面那些"未插电/未确认"的 return 之前，
	#   否则拔电时会在上面就 return 掉，解除压制永远执行不到。
	ST_VBAT=""
	ST_CUR=""; ST_GEAR=""; ST_PWR=""; ST_PSRC=""
	ST_THERM=""; ST_CAP=""; ST_TMED=""
	ST_TB=""; ST_TC=""; ST_TB_MED=""; ST_TC_MED=""
	local vbat_mv=""
	if [ -n "$vbat" ]; then

		vbat_mv=$vbat
		ST_VBAT="$vbat_mv"
	fi

	local _pw
	_pw=$(read_input_power)
	if [ -n "$_pw" ]; then
		set -- $_pw
		[ "$#" -ge 3 ] && ST_PWR="$3"
		[ "$#" -ge 4 ] && ST_PSRC="$4"
	fi

	local absi=0
	if [ -n "$ibat" ]; then
		absi=$ibat
		[ "$absi" -lt 0 ] && absi=$((-absi))
	fi

	if [ "$online" = "0" ]; then

		CHG_OK_CNT=0
		# 拔线 -> rc=4，由主循环统一做 vot_release（见 daemon 循环里
		# 「rc != 0 且 VOT_WROTE != 0」那段）。这里不再重复释放。
		return 4
	fi

	if [ "$absi" -lt "$IBAT_MIN" ]; then
		CHG_OK_CNT=0
		return 4
	fi

	if [ "$online" != "1" ]; then
		CHG_OK_CNT=$((CHG_OK_CNT + 1))
		[ "$CHG_OK_CNT" -lt "$CHG_CONFIRM" ] && return 4
	else
		CHG_OK_CNT=$CHG_CONFIRM
	fi

	[ -n "$soc" ] || return 7

	[ -n "$tb$tc" ] || return 7

	if [ -n "$tb" ] && [ "$tb" -lt "$TEMP_MIN" ]; then return 2; fi
	if [ -n "$tc" ] && [ "$tc" -lt "$TEMP_MIN" ]; then return 2; fi

	push_temp "$tb" "$tc"
	ST_TB_MED="$THERM_TB_MED"; ST_TC_MED="$THERM_TC_MED"
	ST_TMED="$THERM_TB_MED"

	update_therm "$THERM_TB_MED" "$tb" "$THERM_TC_MED" "$tc"
	ST_THERM="$THERM_STATE"

	[ "$THERM_STATE" -eq 4 ] && return 3

	if ! protocol_ready; then
		return 8
	fi

	# ---- 计算最终申请值 ----
	#   1. 按 SOC 查表（骁龙机型此表仅作 voter 注入的基值）
	#   2. 温度退档 + 温度封顶（两路取 min，保证温度只让值变小）
	#   3. 防掉压安全上限（静态 + 反应式）
	cur_set=$(target_current "$soc")
	[ "$cur_set" -eq 0 ] && return 5

	local foldn
	foldn=$(therm_fold_n "$THERM_STATE")
	[ "$foldn" -gt 0 ] && cur_set=$(fold_down "$cur_set" "$foldn")

	local cap
	cap=$(therm_cap "$THERM_STATE")
	[ -n "$cap" ] || cap=999999
	ST_CAP="$cap"
	if [ "$cur_set" -gt "$cap" ]; then
		cur_set="$cap"
	fi

	cur_set=$(apply_safe_ceiling "$cur_set" "$soc")

	if ! cur_value_ok "$cur_set"; then
		cur_set=$(clamp_to_cap "$cur_set" 2>/dev/null)
		case "$cur_set" in
			''|*[!0-9]*) cur_set=$(restore_ma) ;;
		esac
	fi

	ST_CUR="$cur_set"
	ST_GEAR=$(gear_name "$cur_set")

	# ============================================================
	#  机型分流（核心）
	# ------------------------------------------------------------
	#  骁龙（qcom）：主逻辑 = PMIC voter 判决层注入。
	#    判决层是"强制通道"，直接接管充电 IC 投票，不进入
	#    USER_FCC_EVENT 二次裁定，因此不会触发协议重协商掉档。
	#    注入值取自【电量分段电流（用户自定义）】，"电流总闸"作上限。
	#    注入目标固定 USER_IBAT + USER_IBUS（120 机型实测定标，
	#      当初就是为解决「稳不住」才选定的，不做自动改判）。
	#    原 sysfs 申请层逻辑在此机型上【完全不走】。
	#  天玑（mtk）：本机无 voter 通道，走 sysfs 申请层 fchg_fcc_ma，
	#    并叠加防降流安全封顶。
	# ============================================================
	if [ "$DEV_CLASS" = "qcom" ] || [ "$DEV_CLASS" = "" ]; then
		# ★ v3514 修复：VOTE_MODE 此前是【死开关】。
		#   现象：WebUI 里把「启用硬件直控」关掉，电流照样被注入 ——
		#   因为这个变量只在 set_cal 里被写入、在 emit_json 里被读出显示，
		#   主循环 do_once 从头到尾【没有任何一处判断它】。
		#   现在真正接入：VOTE_MODE=0 时释放判决层并交回系统，
		#   与「无判决层」分支走同一条安全路径（不写 sysfs，只 vot_release）。
		if [ "$VOTE_MODE" != "1" ]; then
			ST_GEAR="已关闭直控"
			ST_CAP="VOTE_MODE=0"
			vot_release
			return 1
		fi
		if votable_ready; then
			# 【注入值 = 电量分段电流（自定义），总闸只作上限】
			#   旧实现直接注入 vot_calc()（完全由 VOTE_IBAT 派生），
			#   于是骁龙机上"电量分段电流"保存得进去、却从不参与注入 ——
			#   现象就是"可以保存但没有用"。现在改为：
			#       注入值 = min(分段电流 cur_set, 总闸×温度降额)
			#   分段电流不可用时退回总闸，保证仍有注入、不裸奔；
			#   默认档（分段 11500、总闸 11500）取小后 = 11500，
			#   即默认放开到本机 DT 上限；分段设到更低时由分段主导。
			_vot_ib=$cur_set
			case "$_vot_ib" in
				''|*[!0-9]*) _vot_ib="" ;;
			esac
			_vot_gate=$(vot_calc)
			case "$_vot_gate" in
				''|*[!0-9]*) _vot_gate="" ;;
			esac
			[ -n "$_vot_ib" ] || _vot_ib=$_vot_gate
			if [ -n "$_vot_ib" ] && [ -n "$_vot_gate" ] && \
			   [ "$_vot_ib" -gt "$_vot_gate" ]; then
				_vot_ib="$_vot_gate"
			fi
			if [ -n "$_vot_ib" ] && [ "$_vot_ib" -lt "$VOTE_FLOOR_MIN" ]; then
				_vot_ib=$VOTE_FLOOR_MIN
			fi
			if [ -n "$_vot_ib" ]; then
				if vot_inject "$_vot_ib"; then
					ST_CUR="$_vot_ib"
					ST_GEAR="判决层注入"
					ST_CAP="$_vot_ib"
					return 0
				fi
				ST_CAP="注入熔断"
				return 1
			fi
		fi
		#   原因：sysfs 申请层会走 USER_FCC_EVENT 二次裁定，
		#   驱动可能把值改回去并触发协议重协商 —— 表现就是
		#   "18V 跑一会自动回 9V、功率反复跳变"。
		#   宁可这一轮不干预（交回系统），也不要制造掉压。
		ST_GEAR="交回系统(无判决层)"
		ST_CAP="判决层不可用"
		vot_release
		return 1
	fi

	write_node "$cur_set"
	return 0
}

write_node() {
	local val=$1 cur

	save_original

	cur=$(cat "$NODE" 2>/dev/null)
	[ "$cur" = "$val" ] && return 0

	MOD_WROTE=1
	mark_session_wrote
	echo "$val" > "$NODE" 2>/dev/null || return 1

	[ "$WRITE_VERIFY" = "1" ] || return 0
	cur=$(cat "$NODE" 2>/dev/null)
	[ "$cur" = "$val" ] || return 1
	return 0
}

read_input_power() {
	# ---- 第 1 优先：输入侧 vbus × ibus ----

	local v a vc ac vunit aunit
	v=""; a=""
	for vc in \
		/sys/class/cms_class/chg_voltage \
		/sys/class/cms_class/vbus_voltage \
		/sys/class/cms_class/vbus \
		/sys/class/power_supply/usb/voltage_now \
		/sys/class/power_supply/usb/voltage_max
	do
		[ -r "$vc" ] || continue
		vv=$(cat "$vc" 2>/dev/null)
		case "$vv" in ''|*[!0-9]*) continue ;; esac

		vunit="mv"
		case "$vc" in
			*/power_supply/usb/*)
				vunit="uv" ;;
		esac
		if [ "$vunit" = "uv" ] || [ "${#vv}" -ge 6 ]; then
			[ "$vv" -gt 100000 ] && vv=$((vv / 1000))
		fi

		if [ "$vv" -lt 3000 ] || [ "$vv" -gt 20000 ]; then continue; fi
		for ac in \
			/sys/class/cms_class/ibus \
			/sys/class/cms_class/ibus_ma \
			/sys/class/cms_class/input_current_now \
			/sys/class/power_supply/usb/current_now \
			/sys/class/power_supply/usb/input_current_now
		do
			[ -r "$ac" ] || continue
			aa=$(cat "$ac" 2>/dev/null)
			case "$aa" in ''|*[!0-9-]*) continue ;; esac
			[ "$aa" -lt 0 ] && aa=$((-aa))

			aunit="ma"
			case "$ac" in
				*/power_supply/usb/*)
					aunit="ua" ;;
			esac
			if [ "$aunit" = "ua" ] || [ "${#aa}" -ge 6 ]; then
				aa=$((aa / 1000))
			fi
			[ "$aa" -lt 100 ] && continue
			a="$aa"
			break
		done
		[ -n "$a" ] || continue
		v="$vv"
		break
	done
	if [ -n "$v" ] && [ -n "$a" ]; then

		if [ "$v" -lt 3000 ] || [ "$v" -gt 20000 ] || \
		   [ "$a" -lt 100 ]  || [ "$a" -gt 15000 ]; then
			v=""; a=""
		fi
	fi
	if [ -n "$v" ] && [ -n "$a" ]; then
		local mw=$((v * a / 1000))
		if [ "$mw" -gt 0 ] && [ "$mw" -le 300000 ]; then
			echo "$v $a $mw in"
			return
		fi
	fi

	local vb_mv ib_ua ib_ma
	vb_mv=$(read_vbat)
	ib_ua=$(read_batt_current "$vb_mv")
	case "$vb_mv" in ''|*[!0-9]*) echo ""; return ;; esac
	case "$ib_ua" in ''|*[!0-9-]*) echo ""; return ;; esac

	[ "$ib_ua" -lt 0 ] && ib_ua=$((-ib_ua))
	ib_ma=$((ib_ua / 1000))
	if [ "$vb_mv" -eq 0 ] || [ "$ib_ma" -eq 0 ]; then
		echo "$vb_mv $ib_ma 0 bat"
		return
	fi

	local mw=$((vb_mv * ib_ma / 1000))
	if [ "$mw" -le 0 ] || [ "$mw" -gt 300000 ]; then
		echo ""
		return
	fi
	echo "$vb_mv $ib_ma $mw bat"
}

SESSION_FILE="/data/adb/v2352a_charge_boost.session"

MOD_FINGERPRINTS="9720 11500 15600 11720 7720 5765 4600 4631"

read_boot_id() {
	cat /proc/sys/kernel/random/boot_id 2>/dev/null
}

is_mod_fingerprint() {
	local v=$1 f
	for f in $MOD_FINGERPRINTS; do
		[ "$v" = "$f" ] && return 0
	done
	return 1
}

mark_session_wrote() {
	local bid
	bid=$(read_boot_id)
	[ -z "$bid" ] && bid="unknown"
	echo "$bid:written" > "$SESSION_FILE" 2>/dev/null
}

session_wrote_this_boot() {
	[ -s "$SESSION_FILE" ] || return 1
	local rec bid_have flag bid_now
	rec=$(cat "$SESSION_FILE" 2>/dev/null)
	bid_have=${rec%%:*}
	flag=${rec##*:}
	bid_now=$(read_boot_id)
	[ -z "$bid_now" ] && bid_now="unknown"
	[ "$flag" = "written" ] || return 1
	[ "$bid_have" = "$bid_now" ] || return 1
	return 0
}

save_original() {
	[ -s "$ORIG_FILE" ] && return 0
	[ "$MOD_WROTE" = "1" ] && return 1
	[ -e "$NODE" ] || return 1
	local v
	v=$(cat "$NODE" 2>/dev/null)
	case "$v" in ''|*[!0-9]*) return 1 ;; esac
	[ "$v" -eq 0 ] && return 1

	if session_wrote_this_boot; then
		log "拒绝备份节点值 $v：本开机会话模块已写过节点，该值不可信（防跨版本污染）"
		return 1
	fi

	if is_mod_fingerprint "$v"; then
		local dcv
		dcv=$(dt_restore_value 2>/dev/null)
		case "$dcv" in ''|*[!0-9]*) dcv="" ;; esac
		if [ -n "$dcv" ] && [ "$dcv" = "$v" ]; then
			:
		else
			log "拒绝备份节点值 $v：命中模块指纹且与 DT 原厂值(${dcv:-未知})不符，疑为历史写入残留"
			return 1
		fi
	fi

	echo "$v" > "$ORIG_FILE" 2>/dev/null || return 1
	log "已备份节点原始值: $v -> $ORIG_FILE"
	return 0
}

read_original() {
	[ -s "$ORIG_FILE" ] || { echo ""; return; }
	local v
	v=$(cat "$ORIG_FILE" 2>/dev/null)
	case "$v" in ''|*[!0-9]*) echo "" ;; *) echo "$v" ;; esac
}

restore_to_system() {
	local stage mv bval orig back

	# ---- ⓪ 注入通道：先解除 force（判决层不留残值）----
	#   骁龙机主逻辑走注入，交回时必须先把 force_active 关掉，
	#   否则判决层仍被模块钉住，恢复不彻底。
	vot_release

	# ============================================================
	#  ★★★ V2352A 本机适配：本机「交回系统」= 把节点归 0，不是写推算值 ★★★
	# ------------------------------------------------------------
	#  本机实测（fchg_fcc_ma / V2352A）：
	#    出厂静止态：  cat fchg_fcc_ma = 0
	#                  DCHG_FCC effective = FCHG_DEFAULT_EVENT v=14100
	#    写 9000：     cat fchg_fcc_ma = 9000
	#                  DCHG_FCC effective = DEBUG_FORCE_CLIENT v=9000  ← 接管
	#    写回 0：      cat fchg_fcc_ma = 0
	#                  DCHG_FCC effective = FCHG_DEFAULT_EVENT v=14100 ← 交回
	#
	#  也就是说：本机 fchg_fcc_ma 的 0 是【不参与/未申请】的语义，
	#  不是"申请 0mA"。原实现按"只进不出的申请额度"建模，
	#  恢复时一定要写一个推算值（DT 表 / 原值 / 9720）进去 ——
	#  在本机这等于【主动把系统钉在一个模块算出来的值上】，
	#  而且是 DEBUG_FORCE_CLIENT 优先级最高，比出厂态还硬。
	#  这正是"恢复原厂后反而不如不装"的成因。
	#
	#  所以本机分支：只要当前是 0 就保持 0（真正的交回），
	#  只有模块确实写过非 0 值时才需要决定"写回什么"。
	# ============================================================
	local _cur=""
	[ -e "$NODE" ] && _cur=$(cat "$NODE" 2>/dev/null)
	case "$_cur" in ''|*[!0-9]*) _cur="" ;; esac

	if [ -e "$NODE" ] && [ "$_cur" = "0" ]; then
		echo "0 (本机出厂静止态 —— fchg_fcc_ma=0 表示不参与申请，0 即已交回系统)"
		return 0
	fi

	# ============================================================
	#  ★★ v3530 修（实测发现的决定性 bug）★★
	# ------------------------------------------------------------
	#  旧逻辑在「节点当前非 0」时会继续往下走 ORIG / DT / 兜底三条链，
	#  在本机这两条链都是【错的】：
	#
	#   · read_original 无备份时 -> read_vbat -> dt_baseline_for
	#     本机实测算出 5950（= 表值 238 × 25）
	#     那个 ×25 是 iQOO13 (V2408A) 的标定系数，本机根本不用，
	#     dt_cur_scale 自己都在打告警「表值=238 x25 与上限 14100 反算
	#     k=59 偏差较大」—— 它知道算错了，但结果照样被写进节点。
	#
	#   · 后果：卸载后 fchg_fcc_ma=5950，DCHG_FCC 的 effective 变成
	#     DEBUG_FORCE_CLIENT v=5950，把系统钉死在 5950mA 的申请额度上。
	#     本机出厂态是 0（不参与申请，由 FCHG_DEFAULT_EVENT 给 14100），
	#     所以写 5950 = 卸载反而限速，比不装还差。
	#
	#  【正确语义】本机的「交回」只有一个值：0。
	#    0 = 不参与申请 = 系统按自己的 DT/协议裁定，这才是出厂行为。
	#    任何非 0 值都是 DEBUG_FORCE_CLIENT 接管，比出厂更硬。
	#  所以这里直接写 0，不再走 ORIG / DT / 兜底。
	# ============================================================
	if [ -e "$NODE" ]; then
		echo 0 > "$NODE" 2>/dev/null
		if [ "$(cat "$NODE" 2>/dev/null)" = "0" ]; then
			echo "0 (本机交回语义 = 不参与申请；原值 ${_cur} 已撤销)"
			return 0
		fi
		echo "0 写入失败（节点当前 ${_cur}）"
		return 1
	fi
	echo "节点不存在，无需交回"
	return 0
}

dt_u32_at() {
	local f=$1 idx=$2
	[ -r "$f" ] || { echo ""; return 1; }
	od -An -tu1 -v "$f" 2>/dev/null | awk -v n="$idx" '
		{
			for (i = 1; i <= NF; i++) b[++c] = $i
		}
		END {
			p = n * 4 + 1
			if (c < p + 3) { print ""; exit }
			printf "%d\n", b[p]*16777216 + b[p+1]*65536 + b[p+2]*256 + b[p+3]
		}
	'
}

# ★ v3534：DT 表探测缓存文件路径。
#   【为什么定义在这里】read_aging_stage() 会用它读缓存里的 stage，
#   必须保证【赋值先于函数调用执行】。放这里即整个脚本靠前位置，
#   后续 dt_ensure / dt_cache_load 都复用它，不再重复定义。
DT_CACHE_FILE="/data/adb/v2352a_charge_boost.dtcache"

read_aging_stage() {
	local v f stage="" cyc derived

	# ★ v3534：进程内结果缓存。
	#   【问题】本函数被 dt_ensure() / dt_probe() 反复调用，而它内部有
	#   一句 `find /sys -name aging_stage` —— 实测单次 4495 ms（要遍历
	#   整个 /sys 树，本机有 83 个 thermal_zone + 数百个 power_supply 节点）。
	#   emit_json() 每次至少触发一次 dt_ensure → read_aging_stage，
	#   于是 getjson 即使 DT 表已缓存仍要 5~7 秒。
	#   老化档在一次充电会话里不会变（它由电池循环数决定），
	#   所以进程内缓存、甚至跨进程都是安全的。
	[ -n "$AGING_STAGE_CACHE" ] && { echo "$AGING_STAGE_CACHE"; return 0; }

	for f in \
		/sys/class/vfcs_class/aging_stage \
		/sys/class/cms_class/aging_stage \
		/sys/class/power_supply/battery/aging_stage \
		/sys/class/power_supply/bms/aging_stage
	do
		[ -r "$f" ] || continue
		v=$(cat "$f" 2>/dev/null)
		case "$v" in ''|*[!0-9]*) continue ;; esac
		[ "$v" -lt 0 ] && continue
		[ "$v" -gt 10 ] && continue

		if [ "$v" -gt 0 ]; then
			AGING_STAGE_CACHE="$v"
			echo "$v"; return 0
		fi

		[ -z "$stage" ] && stage="0"
	done

	# ★ v3534：DT 缓存里已经有上次探测到的老化档，直接复用。
	#   比全盘 find 快 4000 倍，且语义等价（同一块电池循环数不变）。
	if [ -n "$DT_CACHE_FILE" ] && [ -f "$DT_CACHE_FILE" ]; then
		local _sc
		_sc=$(sed -n 's/^stage=//p' "$DT_CACHE_FILE" 2>/dev/null | head -n1)
		case "$_sc" in
			''|*[!0-9]*) ;;
			*)
				if [ "$_sc" -gt 0 ] && [ "$_sc" -le 10 ]; then
					AGING_STAGE_CACHE="$_sc"
					echo "$_sc"; return 0
				fi
				;;
		esac
	fi

	# ---- ② 定向搜索（只在上面没拿到非 0 值时跑一次）----
	#   ★ v3534：原实现是 `find /sys -name aging_stage` —— 遍历整棵树，
	#   实测 4495 ms。改成只在 power_supply / class 这两个确实会出现
	#   该节点的子树里搜，并限制深度。范围仍覆盖全部已知布局，
	#   但代价从 4.5 秒降到几十毫秒。
	if [ -z "$stage" ] || [ "$stage" = "0" ]; then
		f=$(find /sys/class/power_supply /sys/class/cms_class /sys/class/vfcs_class \
			-maxdepth 2 -name aging_stage -type f 2>/dev/null | head -n 1)
		if [ -n "$f" ] && [ -r "$f" ]; then
			v=$(cat "$f" 2>/dev/null)
			case "$v" in
				''|*[!0-9]*) ;;
				*)
					[ "$v" -le 10 ] && [ "$v" -ge 0 ] && {
						if [ "$v" -gt 0 ]; then
							AGING_STAGE_CACHE="$v"
							echo "$v"; return 0
						fi
						stage="0"
					}
					;;
			esac
		fi
	fi

	if [ -z "$stage" ] || [ "$stage" = "0" ]; then
		cyc=$(read_aging_cycle 2>/dev/null)
		case "$cyc" in ''|*[!0-9]*) cyc="" ;; esac
		if [ -n "$cyc" ]; then
			derived=$(dt_aging_stage_by_cycle "$cyc" 2>/dev/null)
			case "$derived" in ''|*[!0-9]*) derived="" ;; esac
			if [ -n "$derived" ]; then

				if [ $((DT_LOG_DONE & 128)) -eq 0 ]; then
					DT_LOG_DONE=$((DT_LOG_DONE | 128))
					log "老化档: 节点报 0 不可信; 本机 DT 查表 cycle=$cyc -> 档 $derived"
				fi
				echo "$derived"
				return 0
			fi

			if [ $((DT_LOG_DONE & 256)) -eq 0 ]; then
				DT_LOG_DONE=$((DT_LOG_DONE | 256))
				log "老化档: 节点报 0, 本机 DT 边界表读不到, 保持 0（未改写）"
			fi
		fi
	fi

	# ---- ④ 都拿不到，或确实就是 0 档 ----
	[ -n "$stage" ] && { echo "$stage"; return 0; }
	echo 0
	return 0
}

read_aging_cycle() {
	local f v
	for f in \
		/sys/class/power_supply/battery/cycle_count \
		/sys/class/cms_class/battery_health_cyclecount \
		/sys/class/power_supply/bms/cycle_count
	do
		[ -r "$f" ] || continue
		v=$(cat "$f" 2>/dev/null)
		case "$v" in ''|*[!0-9]*) continue ;; esac
		echo "$v"; return 0
	done
	echo ""
	return 1
}

dt_candidate_dirs() {
	echo "/sys/firmware/devicetree/base/vfcs_cms"
	echo "/sys/firmware/devicetree/base/soc/qcom,pmic_glink/cms_v5/single_charger_board"
	echo "/sys/firmware/devicetree/base/soc/qcom,pmic_glink/cms_v5"
}
AGING_STAGE_TABLE=""

# ★ v3534：老化档进程内缓存。
#   由 read_aging_stage() 写入，避免反复触发 `find /sys`（实测 4495ms）。
#   老化档由电池循环数决定，一次充电会话内不会变化，缓存是安全的。
AGING_STAGE_CACHE=""

dt_aging_boundaries() {
	[ -n "$AGING_STAGE_TABLE" ] && { echo "$AGING_STAGE_TABLE"; return 0; }
	local dir n f sz cnt i v acc=""
	for dir in $(dt_candidate_dirs); do
		for n in \
			"vivo,bat-aging-cycle-range" \
			"vivo,batt-aging-cycle-range"
		do
			f="$dir/$n"
			[ -r "$f" ] || continue
			sz=$(wc -c < "$f" 2>/dev/null)
			case "$sz" in ''|*[!0-9]*) continue ;; esac
			cnt=$((sz / 4))

			[ "$cnt" -lt 2 ] && continue
			acc=""
			i=0
			while [ "$i" -lt "$cnt" ]; do
				v=$(dt_u32_at "$f" "$i")
				i=$((i + 1))
				case "$v" in ''|*[!0-9]*) continue ;; esac
				acc="$acc $v"
			done

			acc=${acc# }
			[ -n "$acc" ] || continue
			AGING_STAGE_TABLE="$acc"
			echo "$acc"
			return 0
		done
	done
	echo ""
	return 1
}

dt_aging_stage_by_cycle() {
	local cyc="$1" tbl r k i n last
	case "$cyc" in ''|*[!0-9]*) echo ""; return 1 ;; esac

	tbl=$(dt_aging_boundaries 2>/dev/null)
	[ -n "$tbl" ] || { echo ""; return 1; }

	k=""; i=0; last=""
	for r in $tbl; do
		case "$r" in ''|*[!0-9]*) i=$((i + 1)); continue ;; esac
		last=$i
		if [ -z "$k" ] && [ "$cyc" -lt "$r" ]; then k=$i; fi
		i=$((i + 1))
	done
	[ -z "$last" ] && { echo ""; return 1; }

	[ -z "$k" ] && { echo 11; return 0; }

	n=$k
	[ "$n" -lt 0 ] && n=0
	[ "$n" -gt 11 ] && n=11
	echo "$n"
	return 0
}

# >>> DT-CONST-BEGIN
DT_MAGIC=4294958408
DT_HDR_LEN=11
DT_MIN_ROWS=4
DT_SEG_ROW=200
DT_SEG_MAX=5
DT_VBAT_UNREACH=10000
DT_TC_NODE=""
DT_PROBED=""
DT_PLATFORM=""
DT_PROBE_HOW=""
# <<< DT-CONST-END

dt_is_soc_bound() {
	# ★★★ V2352A 本机适配补丁 ★★★
	#   原表只有 250:349 / 200:249 两段，而本机（V2352A / cms_v5 /
	#   single_charger_board）的 DT 表实际分段是【200:349】—— 一段覆盖
	#   250~349 与 200~249 两个区间。
	#   后果（实测）：dt_is_valid_table 的结构自证在第二行就 break，
	#   cnt=1 < DT_MIN_ROWS(4) -> 整张 440 字节、完全合法的表被判 INVALID
	#   -> dt_probe 三轮全灭 -> 原厂档 / 卸载还原 / 电流上限校准
	#   全部退到兜底常量（9720），而不是本机真实的 DT 口径。
	#   这里把 200:349 加进白名单，同时【保留】原有两段，其它机型不受影响。
	case "$1:$2" in
		450:549|400:449|350:399|250:349|200:349|200:249|150:199|100:149|0:99)
			return 0
			;;
	esac
	return 1
}

dt_is_valid_table() {
	local f=$1 magic i lo hi cnt
	[ -r "$f" ] || return 1

	i=$DT_HDR_LEN
	while [ "$i" -lt 200 ]; do
		lo=$(dt_u32_at "$f" "$i")
		case "$lo" in ''|*[!0-9]*) break ;; esac
		if [ "$lo" = "$DT_MAGIC" ]; then
			hi=$(dt_u32_at "$f" $((i + 1)))
			[ "$hi" = "4294967295" ] && return 0
		fi
		i=$((i + DT_HDR_LEN))
	done

	# ---- 路径 B：结构自证（兼容任意长度 / 无哨兵档）----
	cnt=0
	i=$DT_HDR_LEN
	while [ "$cnt" -lt 32 ]; do
		lo=$(dt_u32_at "$f" "$i")
		hi=$(dt_u32_at "$f" $((i + 1)))
		case "$lo$hi" in ''|*[!0-9]*) break ;; esac
		dt_is_soc_bound "$lo" "$hi" || break
		cnt=$((cnt + 1))
		i=$((i + DT_HDR_LEN))
	done
	[ "$cnt" -ge "$DT_MIN_ROWS" ] && return 0

	return 1
}

_dt_set_probe() {
	local dir=$1 f=$2 stage=$3 how=$4
	DT_BASE="$dir"
	DT_TC_NODE="$f"
	DT_PROBED="$f"
	DT_PROBE_HOW="$how"
	case "$dir" in
		*vfcs_cms*)             DT_PLATFORM="mtk"  ;;
		*single_charger_board*) DT_PLATFORM="qcom" ;;
		*cms_v5*)               DT_PLATFORM="qcom" ;;
		*)                      DT_PLATFORM="unk"  ;;
	esac
	case "$how" in
		exact)

			if [ $((DT_LOG_DONE & 8)) -eq 0 ]; then
				DT_LOG_DONE=$((DT_LOG_DONE | 8))
				log "DT 探测成功: ${f##*/}  (平台=${DT_PLATFORM}, 老化档=${stage})"
			fi
			;;
		fallback0)

			if [ $((DT_LOG_DONE & 16)) -eq 0 ]; then
				DT_LOG_DONE=$((DT_LOG_DONE | 16))
				log "DT 探测⚠: 老化档 ${stage} 的表不存在，已退回 ${f##*/}（平台=${DT_PLATFORM}）"
				log "         -> 恢复值为【未老化档口径】，仅作兜底，不代表本机原厂标定"
			fi
			;;
		scanall)

			if [ $((DT_LOG_DONE & 32)) -eq 0 ]; then
				DT_LOG_DONE=$((DT_LOG_DONE | 32))
				log "DT 探测⚠: 常规路径均未命中，全盘搜到 ${f}（平台=${DT_PLATFORM}）"
			fi
			;;
	esac
}

dt_probe() {
	local stage=${1:-}
	local dir name f cyc
	[ -z "$stage" ] && stage=$(read_aging_stage)

	cyc=$(read_aging_cycle)
	case "$cyc" in
		''|*[!0-9]*) cyc="" ;;
	esac
	if [ -n "$cyc" ] && [ "$stage" = "0" ] && [ "$cyc" -gt 100 ]; then

		if [ $((DT_LOG_DONE & 64)) -eq 0 ]; then
			DT_LOG_DONE=$((DT_LOG_DONE | 64))
			log "DT 探测⚠: 老化档读数为 0，但循环数=${cyc}（明显已老化）"
			log "         -> power_supply/aging_stage 在本机可能不准；"
			log "            若恢复值偏高，请核对 cms_v5 dmesg 里的 aging_stage"
		fi
	fi

	if [ -n "$DT_PROBED" ] && [ -r "$DT_PROBED" ]; then
		DT_TC_NODE="$DT_PROBED"
		return 0
	fi

	# ---- 第一轮：只匹配【本老化档】的表名（精确命中）----
	for dir in $(dt_candidate_dirs); do
		[ -d "$dir" ] || continue
		for name in \
			"vivo,aging-normal-tc-data-$stage" \
			"vivo,aging1-normal-tc-data-$stage" \
			"vivo,normal-tc-data-$stage"
		do
			f="$dir/$name"
			if dt_is_valid_table "$f"; then
				_dt_set_probe "$dir" "$f" "$stage" "exact"
				return 0
			fi
		done
	done

	# ---- 第二轮：退回档 0 / 无编号表（兜底，会告警）----
	for dir in $(dt_candidate_dirs); do
		[ -d "$dir" ] || continue
		for name in \
			"vivo,aging-normal-tc-data-0" \
			"vivo,aging1-normal-tc-data-0" \
			"vivo,normal-tc-data-0" \
			"vivo,normal-tc-data"
		do
			f="$dir/$name"
			if dt_is_valid_table "$f"; then
				_dt_set_probe "$dir" "$f" "$stage" "fallback0"
				return 0
			fi
		done
	done

	# ---- 第三轮：全 DT 树扫描（最后兜底，代价高）----
	#  ★ v3534：只在【前两轮全未命中】时才会走到这里，而这一步
	#  `find /sys/firmware/devicetree/base -type f` 要遍历整个 DT 树
	#  （本机数千个节点），实测会把 dt_probe 从 8.7 秒推到十几秒。
	#  加 -maxdepth 限制：本机的表都在 cms_v5/single_charger_board 下，
	#  深度不超过 8。超过这个深度基本不可能是正常布局，
	#  继续深挖只会白烧 CPU。
	for f in $(find /sys/firmware/devicetree/base -maxdepth 8 -type f \
			-name 'vivo,*normal-tc-data*' 2>/dev/null); do
		[ -r "$f" ] || continue
		if dt_is_valid_table "$f"; then
			_dt_set_probe "$(dirname "$f")" "$f" "$stage" "scanall"
			return 0
		fi
	done

	if [ $((DT_LOG_DONE & 512)) -eq 0 ]; then
		DT_LOG_DONE=$((DT_LOG_DONE | 512))
		log "DT 探测失败：所有候选目录与表名均未命中"
	fi
	return 1
}

dt_detect_unit() {
	local f=${1:-$DT_TC_NODE}
	local v1 mx
	[ -r "$f" ] || { echo "mv"; return; }

	v1=$(dt_seg_field "$f" 400 1)
	case "$v1" in ''|*[!0-9]*) v1=0 ;; esac

	if [ "$v1" -ge 100000 ]; then
		echo "uv"; return
	fi
	if [ "$v1" -gt 0 ]; then
		echo "mv"; return
	fi

	mx=$(dt_max_value "$f")
	if [ "$mx" -ge 1000000 ]; then echo "uv"; else echo "mv"; fi
}

dt_max_value() {
	local f=$1
	od -An -tu1 -v "$f" 2>/dev/null | awk '
		{ for(i=1;i<=NF;i++) b[++c]=$i }
		END {
			n=int(c/4); mx=0
			for(k=0;k<n;k++){
				p=k*4+1
				v=b[p]*16777216+b[p+1]*65536+b[p+2]*256+b[p+3]
				if(v==4294967295) continue
				if(v>mx) mx=v
			}
			print mx
		}'
}

dt_to_mv() {
	local v=$1 unit=$2
	case "$v" in ''|*[!0-9]*) echo 0; return ;; esac
	if [ "$unit" = "uv" ] && [ "$v" -gt 100000 ]; then
		echo $((v / 1000))
	else
		echo "$v"
	fi
}

dt_auto_segs() {
	local f=${1:-$DT_TC_NODE}
	local unit i1 p pts prev out n
	[ -r "$f" ] || return 1
	unit=$(dt_detect_unit "$f")

	pts=""
	i1=1
	while [ "$i1" -le 7 ]; do
		p=$(dt_seg_field "$f" "$DT_SEG_ROW" "$i1")
		case "$p" in ''|*[!0-9]*) break ;; esac
		p=$(dt_to_mv "$p" "$unit")
		case "$p" in ''|*[!0-9]*) break ;; esac

		if [ "$p" -le 0 ]; then p=$DT_VBAT_UNREACH; fi
		pts="$pts $p"
		i1=$((i1 + 2))
	done
	[ -n "$pts" ] || return 1

	prev=""
	for p in $pts; do
		if [ -n "$prev" ] && [ "$p" -le "$prev" ]; then return 1; fi
		prev=$p
	done

	set -- $pts
	case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac

	[ "$1" -lt 3000 ] && return 1
	[ "$1" -gt 10000 ] && return 1

	out=""
	n=0
	local lo=0 hi
	for hi in "$@"; do
		n=$((n + 1))
		out="${out}${out:+ }seg${n}:${lo}:$((hi - 1))"
		lo=$hi
	done
	n=$((n + 1))
	out="${out}${out:+ }seg${n}:${lo}:9999"

	echo "$out"
	return 0
}

dt_seg_field() {
	local f=$1 want=$2 fi=$3
	[ -r "$f" ] || return 1

	od -An -tu1 -v "$f" 2>/dev/null | awk -v want="$want" -v fi="$fi" '
		BEGIN {
			PL[1]=450; PH[1]=549
			PL[2]=400; PH[2]=449
			PL[3]=350; PH[3]=399
			PL[4]=250; PH[4]=349
			# ★ V2352A 本机适配：本机 DT 的实际分段是 200:349
			#   （不是 250:349 / 200:249 两段）。不补这一条，按 want=200
			#   去定位时 isb() 全部失败 —— 循环会把整张表扫完却一次都
			#   不进匹配分支，最后 print ""，表现为「表明明存在却读不到
			#   电流」，原厂档与 setcal 上限校准全部拿不到本机口径。
			#   保留 250:349 / 200:249 是为了不影响其它机型。
			PL[5]=200; PH[5]=349
			PL[6]=200; PH[6]=249
			PL[7]=150; PH[7]=199
			PL[8]=100; PH[8]=149
			PL[9]=0;   PH[9]=99
			NP=9
		}
		function isb(a,b2,  q){ for(q=1;q<=NP;q++) if(a==PL[q]&&b2==PH[q]) return 1; return 0 }
		{ for(i=1;i<=NF;i++) b[++c]=$i }
		END {
			n=int(c/4)
			for(k=0;k<n;k++){ p=k*4+1; v[k+1]=b[p]*16777216+b[p+1]*65536+b[p+2]*256+b[p+3] }
			i=12
			while (i<=n-1) {
				if (isb(v[i],v[i+1])) {
					if (v[i]==want) { print v[i+2+fi]; exit }
					j=i+2
					while (j<=n-1 && !isb(v[j],v[j+1])) j++
					i=j
				} else i++
			}
			print ""
		}'
}

dt_restore_value() {
	local stage=${1:-}
	local f raw unit

	[ -z "$stage" ] && stage=$(read_aging_stage)

	dt_probe "$stage" || return 1
	f="$DT_TC_NODE"

	raw=$(dt_seg_field "$f" 200 0)
	case "$raw" in ''|*[!0-9]*|0) raw="" ;; esac
	if [ -z "$raw" ]; then
		raw=$(dt_seg_field "$f" 400 0)
		case "$raw" in ''|*[!0-9]*|0) return 1 ;; esac
	fi

	unit=$(dt_detect_unit "$f")
	dt_cur_scale "$raw" "$unit" "$f"
	return 0
}

dt_cur_scale() {
	local raw=$1 unit=$2 f=$3
	local cap k_auto k_use

	case "$raw" in ''|*[!0-9]*) echo ""; return ;; esac

	[ "$raw" -eq 0 ] && { echo 0; return; }

	# ---- 定值：按电压体系判机型流派 ----
	#
	# ★ v3521 关键修复：探测到偏差时【采纳反算系数】，不再死守 25。
	#
	#   【本机实测的 DT 表真实结构】（440 字节，大端 32 位序列）
	#     v23=400  v24=449        <- 分段边界 [SOC 下限 : 上限]
	#     v25=224  v26=4180000    <- 电流 224 @ 电压 4180mV
	#     v27=189  v28=4240000
	#     v29=157  v30=4290000
	#     v31=126  v32=4440000
	#     v33=94                  <- 最后一段
	#   每段是 [电流 : 电压uV] 交替，结构已通过字节级解码确认。
	#
	#   【旧逻辑的错】
	#     raw<2000 时无条件 k_use=25。本机 raw=224，
	#     224 x 25 = 5600mA —— 只有 DT 上限 14100 的 40%。
	#     反算真实系数：14100/224 = 62.9，日志里 k_auto 算得 59
	#     （因为用的 raw=238 是另一段的第二个字段，略有偏差），
	#     但无论 59 还是 63，都远大于 25。
	#     旧代码算出 k_auto=59 后只在偏差>40% 时【打一条警告】，
	#     然后继续用 25 —— 典型"发现错了但不改"。
	#
	#   【新逻辑】
	#     ① 有 DT 上限可反算时，优先相信反算值（它在物理上必须自洽：
	#        表里最大值对应驱动设计上限，这是 vivo 自己的标定关系）
	#     ② 反算值与定值偏差在 40% 以内 -> 两者等价，用定值（省一次除法误差）
	#     ③ 反算值离谱（<1 或 >500）才回退定值，防止 DT 上限读到垃圾值
	#
	#   注意 k_auto 用的是"最大值那一段"，而 dt_cur_scale 是逐段调用的。
	#   所以这里不按单段反算，而是用【表内最大值】反算一次并缓存，
	#   避免各段算出不同的 k 导致整张表被按段拉伸。
	if [ "$unit" = "uv" ] && [ "$raw" -lt 2000 ]; then
		k_use=25
	else
		k_use=1
	fi

	cap=$(dt_cur_max)
	case "$cap" in ''|*[!0-9]*) cap="" ;; esac

	# 只有 uv 域才需要换算，且只在 k_use=25 这种"小值域"时校对
	if [ -n "$cap" ] && [ "$cap" -gt 0 ] && [ "$k_use" -gt 1 ]; then

		# 表内最大值（只解一次，缓存）
		if [ -z "$DT_SCALE_RAWMAX" ]; then
			DT_SCALE_RAWMAX=$(dt_seg_max_raw "$f" 2>/dev/null)
			case "$DT_SCALE_RAWMAX" in ''|*[!0-9]*) DT_SCALE_RAWMAX="" ;; esac
		fi
		local _base="$DT_SCALE_RAWMAX"
		[ -n "$_base" ] || _base="$raw"

		if [ "$_base" -gt 0 ]; then
			k_auto=$(( (cap + _base / 2) / _base ))

			if [ "$k_auto" -ge 1 ] && [ "$k_auto" -le 500 ]; then
				# 与定值偏差超 40% -> 采纳反算值
				if [ $(( (k_auto - k_use) * 100 / k_use )) -gt 40 ] || \
				   [ $(( (k_use - k_auto) * 100 / k_use )) -gt 40 ]; then
					[ "$LOG_PREV_SCALE" = "$_base:$k_use:$k_auto:$cap" ] || {
						LOG_PREV_SCALE="$_base:$k_use:$k_auto:$cap"
						log "电流换算: 表值max=${_base} 定值x${k_use} 反算x${k_auto}（上限${cap}mA），采纳反算值"
					}
					k_use=$k_auto
				fi
			fi
		fi
	fi

	echo $((raw * k_use))
}

# 取 DT 表里所有"电流段"的最大值（不按分段匹配，只扫全部 u32 找合理电流）
# 用途：给 dt_cur_scale 做反算基准。单独扫而不复用 dt_seg_field，
# 是因为后者依赖 SOC 分段匹配，拿到的 raw 可能是段内的第二个字段。
dt_seg_max_raw() {
	local f=$1
	[ -r "$f" ] || return 1
	od -An -tu1 -v "$f" 2>/dev/null | awk '
		{ for(i=1;i<=NF;i++) b[++c]=$i }
		END {
			n=int(c/4)
			for(k=0;k<n;k++){ p=k*4+1; v[k+1]=b[p]*16777216+b[p+1]*65536+b[p+2]*256+b[p+3] }
			# 电流候选：介于 50~1500 且后面紧跟一个 3000000~5000000 的电压值
			mx=0
			for(i=1;i<=n-1;i++){
				if(v[i]>=50 && v[i]<=1500 && v[i+1]>=3000000 && v[i+1]<=5000000){
					if(v[i]>mx) mx=v[i]
				}
			}
			if(mx>0) print mx
		}'
}

dt_load_table() {
	local f=$DT_TC_NODE unit i cur vol out="" seg
	[ -r "$f" ] || return 1

	unit=$(dt_detect_unit "$f")

	i=0
	while [ "$i" -lt "$DT_SEG_MAX" ]; do
		cur=$(dt_seg_field "$f" "$DT_SEG_ROW" $((i * 2)))
		case "$cur" in ''|*[!0-9]*) return 1 ;; esac

		if [ "$i" -ge 4 ]; then

			vol=9999
		else
			vol=$(dt_seg_field "$f" "$DT_SEG_ROW" $((i * 2 + 1)))
			case "$vol" in ''|*[!0-9]*) return 1 ;; esac
			vol=$(dt_to_mv "$vol" "$unit")

			if [ "$vol" -le 0 ]; then vol=$DT_VBAT_UNREACH; fi
		fi

		cur=$(dt_cur_scale "$cur" "$unit" "$f")
		case "$cur" in ''|*[!0-9]*) return 1 ;; esac

		seg="seg$((i + 1))=$cur:$vol"
		out="${out}${out:+ }$seg"
		i=$((i + 1))
	done

	[ -n "$out" ] || return 1
	echo "$out"
	return 0
}

DT_CUR_MAX_HIT=""
dt_cur_max() {
	local p v

	if [ -n "$DT_CUR_MAX_HIT" ]; then
		if [ -r "$DT_CUR_MAX_HIT" ]; then
			v=$(dt_u32_at "$DT_CUR_MAX_HIT" 0)
			case "$v" in ''|*[!0-9]*) ;; *) echo "$v"; return ;; esac
		fi

		DT_CUR_MAX_HIT=""
	fi

	for p in $DT_CUR_MAX_NODES; do
		[ -r "$p" ] || continue
		v=$(dt_u32_at "$p" 0)
		case "$v" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$v" -le 0 ] && continue
		DT_CUR_MAX_HIT="$p"
		echo "$v"
		return
	done
	echo ""
}

DT_TABLE=""
DT_TABLE_STATE=""

DT_LOG_DONE=0

# ============================================================
#  ★★ v3534：DT 表探测结果持久化缓存（性能修复）★★
# ------------------------------------------------------------
#  【问题】dt_ensure() 无缓存时走 dt_probe()，而 dt_probe 要做：
#    3 个候选目录 × 3 种表名 × dt_is_valid_table
#    dt_is_valid_table 内部又是「最多 200 步、每步一次 dt_u32_at」的循环，
#    每次 dt_u32_at 都要 od 整个 DT 文件再 awk 解析。
#    实测单次 dt_ensure = 8723 ms。
#
#  emit_json() 每次都调 dt_ensure + 5 次 dt_table_get，
#  于是 getjson 单次 8~12 秒 —— 这是「切原厂档后 WebUI 变卡」的根因链条：
#    切原厂 → 守护被杀 → status.json 冻结 → 12 秒后缓存超龄
#    → 前端【每轮轮询】都改走 getjson 直读 → 每 2 秒卡一次，每次 8~12 秒
#
#  【为什么可以缓存】/sys/firmware/devicetree 是内核启动时把 DT 展开成的
#  只读快照，运行期内容永不变化；老化档由电池循环数决定，也不会在两次
#  轮询之间跳变。所以「探测一次 → 落盘 → 后续读文件」与原语义等价。
#
#   【缓存失效条件】任一命中才重新付一次 8 秒：
#    · 缓存文件不存在（首次 / 升级后）
#    · 记录的 node 路径已不可读（换 ROM / OTA 改了 DT 布局）
#    · 老化档与缓存不一致（换电池 / 循环数跨档）
#   （DT_CACHE_FILE 已在 read_aging_stage 之前定义，此处不重复）

dt_cache_load() {
	local _stage="$1" _s_node _s_table _s_segs _s_stage
	[ -f "$DT_CACHE_FILE" ] || return 1

	_s_node=$(sed -n 's/^node=//p' "$DT_CACHE_FILE" 2>/dev/null | head -n1)
	_s_table=$(sed -n 's/^table=//p' "$DT_CACHE_FILE" 2>/dev/null | head -n1)
	_s_segs=$(sed -n 's/^segs=//p' "$DT_CACHE_FILE" 2>/dev/null | head -n1)
	_s_stage=$(sed -n 's/^stage=//p' "$DT_CACHE_FILE" 2>/dev/null | head -n1)

	[ -n "$_s_node" ] && [ -r "$_s_node" ] || return 1
	[ -n "$_s_table" ] || return 1
	[ "$_s_stage" = "$_stage" ] || return 1

	DT_TC_NODE="$_s_node"
	DT_TABLE="$_s_table"
	DT_PROBED="$_s_node"
	[ -n "$_s_segs" ] && BASELINE_SEGS_AUTO="$_s_segs"
	DT_TABLE_STATE="ok"
	return 0
}

dt_cache_save() {
	local _stage="$1"
	{
		echo "stage=$_stage"
		echo "node=$DT_TC_NODE"
		echo "table=$DT_TABLE"
		echo "segs=${BASELINE_SEGS_AUTO:-}"
	} > "${DT_CACHE_FILE}.tmp" 2>/dev/null && \
		mv -f "${DT_CACHE_FILE}.tmp" "$DT_CACHE_FILE" 2>/dev/null
	return 0
}

dt_ensure() {
	[ "$DT_TABLE_STATE" = "ok" ] && return 0
	[ "$DT_TABLE_STATE" = "fail" ] && return 1

	# ★ v3534：先试持久化缓存 —— 命中即返回，跳过 8.7 秒探测。
	#   老化档要先读出来（它是缓存有效性的判据之一），
	#   read_aging_stage 只是几次 cat，约 100ms，可接受。
	local _stage_c
	_stage_c=$(read_aging_stage 2>/dev/null)
	if dt_cache_load "$_stage_c"; then
		return 0
	fi

	dt_probe "$_stage_c" || {
		DT_TABLE_STATE="fail"

		if [ $((DT_LOG_DONE & 1)) -eq 0 ]; then
			DT_LOG_DONE=$((DT_LOG_DONE | 1))
			log "原厂档: DT 表探测失败（三台候选路径均未命中），将退回节点原值"
		fi
		return 1
	}

	local t segs
	t=$(dt_load_table 2>/dev/null)
	if [ -z "$t" ]; then
		DT_TABLE_STATE="fail"

		if [ $((DT_LOG_DONE & 2)) -eq 0 ]; then
			DT_LOG_DONE=$((DT_LOG_DONE | 2))
			log "原厂档: DT 表读取失败（$DT_TC_NODE 不可读或格式异常），将退回节点原值"
		fi
		return 1
	fi
	DT_TABLE="$t"
	DT_TABLE_STATE="ok"

	segs=$(dt_auto_segs "$DT_TC_NODE" 2>/dev/null)
	if [ -n "$segs" ]; then
		BASELINE_SEGS_AUTO="$segs"
	fi

	# ★ v3534：探测成功后立刻落盘缓存，后续 getjson 直接命中，不再付 8.7 秒
	dt_cache_save "$_stage_c"

	if [ $((DT_LOG_DONE & 4)) -eq 0 ]; then
		DT_LOG_DONE=$((DT_LOG_DONE | 4))
		if [ -n "$segs" ]; then
			log "原厂档: 分段边界(自动) -> $segs"
		else
			log "原厂档: 分段边界(自动)读取失败"
		fi
		log "原厂档: 已从 DT 载入档位表 -> $t"
	fi
	return 0
}

dt_table_get() {
	local want=$1 e name val
	for e in $DT_TABLE; do
		name=${e%%=*}
		[ "$name" = "$want" ] || continue
		val=${e#*=}
		val=${val%%:*}
		case "$val" in ''|*[!0-9]*) echo "" ;; *) echo "$val" ;; esac
		return
	done
	echo ""
}

baseline_field_of() {
	local mv=$1 seg name lo hi
	local segs="${BASELINE_SEGS_AUTO}"
	case "$mv" in ''|*[!0-9]*) return 1 ;; esac
	for seg in $segs; do
		name=${seg%%:*}; rest=${seg#*:}
		lo=${rest%%:*}; hi=${rest##*:}
		if [ "$mv" -ge "$lo" ] && [ "$mv" -le "$hi" ]; then
			echo "$name"; return 0
		fi
	done
	return 1
}

dt_clamp() {
	local v=$1 cap
	case "$v" in ''|*[!0-9]*) echo ""; return 1 ;; esac
	[ "$v" -le 0 ] && { echo ""; return 1; }
	cap=$(dt_cur_max)
	if [ -n "$cap" ] && [ "$v" -gt "$cap" ]; then
		echo "$cap"
		return 0
	fi
	echo "$v"
	return 0
}

dt_baseline_for() {
	local mv=$1 f v
	dt_ensure || { echo ""; return 1; }
	f=$(baseline_field_of "$mv") || { echo ""; return 1; }
	v=$(dt_table_get "$f")
	if [ -z "$v" ]; then
		echo ""; return 1
	fi
	dt_clamp "$v"
	return 0
}

gear_name() {

	local v=$1
	case "$v" in ''|*[!0-9]*) echo "—"; return ;; esac
	[ "$v" -eq 0 ] && { echo "停"; return; }

	# ---- 第 1 步：直接匹配档位表的语义名 ----
	[ "$v" = "$I_LOW"  ] && { echo "$SEG_LOW_NAME";  return; }
	[ "$v" = "$I_MID"  ] && { echo "$SEG_MID_NAME";  return; }
	[ "$v" = "$I_PEAK" ] && { echo "$SEG_PEAK_NAME"; return; }
	[ "$v" = "$I_MID2" ] && { echo "$SEG_MID2_NAME"; return; }
	[ "$v" = "$I_LOW2" ] && { echo "$SEG_LOW2_NAME"; return; }

	# ---- 第 2 步：用户自定义值 -> 按在阶梯中的位置给相对名 ----
	local ladder i n
	ladder=$(gear_ladder)
	n=0
	for x in $ladder; do n=$((n + 1)); done
	[ "$n" -eq 0 ] && { echo "${v}mA"; return; }

	i=0
	for x in $ladder; do
		i=$((i + 1))
		if [ "$x" = "$v" ]; then

			if [ "$i" -eq 1 ]; then echo "自定义高档"
			elif [ "$i" -eq "$n" ]; then echo "自定义低档"
			else echo "自定义第$((n - i + 1))级"
			fi
			return
		fi
	done
	echo "${v}mA"
}

# ---------------- 现场描述 ----------------
fmt_state() {
	local rc=$1
	local t=""

	if [ -n "$ST_TB" ] || [ -n "$ST_TC" ]; then
		t=" 板级=$(f10s "$ST_TB")C 电池=$(f10s "$ST_TC")C"
	elif [ -n "$ST_TEMP" ]; then
		t=" 温度=$((ST_TEMP/10)).$((ST_TEMP%10))C"
	fi
	local tm=""
	local v=""
	[ -n "$ST_VBAT" ] && v=" 电压=${ST_VBAT}mV"
	local s=""
	[ -n "$ST_SOC" ] && s=" SOC=${ST_SOC}%"

	local o=""
	case "$ST_ONLINE" in
		1) o=" 插线=是" ;;
		0) o=" 插线=否" ;;
		*) o=" 插线=?" ;;
	esac

	local p=""
	if [ -n "$ST_PWR" ]; then
		p=" 功率=$((ST_PWR / 1000)).$(((ST_PWR % 1000) / 100))W"
		case "$ST_PSRC" in
			in)  p="${p}(输入侧)" ;;
			bat) p="${p}(电池侧)" ;;
		esac
	fi

	local th=""
	case "$ST_THERM" in
		1) th=" 【预警·表退一档】" ;;
		2) th=" 【热降档A·封顶${CAP_A}】" ;;
		3) th=" 【热降档B·封顶${CAP_B}】" ;;
	esac

	case "$rc" in
		0) echo "充电中${th} |${s}${v}${t}${tm}${o}${p} | 当前档位: ${ST_GEAR} ${ST_CUR}mA" ;;
		2) echo "温度过低 |${s}${v}${t}${tm}${o}${p}" ;;
		3) echo "过热撒手(交回系统)${th} |${s}${v}${t}${tm}${o}${p}" ;;
		4) echo "未充电 |${s}${v}${t}${tm}${o}${p}" ;;
		5) echo "SOC不在生效区间 |${s}${v}${t}${tm}${o}${p}" ;;
		7) echo "读数缺失(静默) |${s}${v}${t}${o}" ;;
		*) echo "节点不可用 rc=$rc" ;;
	esac
}

# ★★ v3546：空闲态返回码判定 —— 决定是否降频轮询 ★★
#   rc=0 正在干预，必须保持 2 秒节奏；其余返回码模块都不动手，
#   2 秒一轮纯属空转（实测 emit_json+do_once 一轮 2.7 秒，CPU 55%）。
#   【必须定义在 loop() 之前】否则函数体内的调用会拿到 127（未定义）。
is_idle_rc() {
	case "$1" in
		# ★★ v3556 修正：只把【长期静止】的状态当空闲 ★★
		#   旧版把 1/7/8/2/3 也算空闲 -> 降频到 10s，副作用：
		#     rc=1  vot_inject 熔断失败 -> 恢复被拖慢 5 倍
		#     rc=7  读不到 soc/温度   -> 传感器恢复被拖慢 5 倍
		#     rc=8  协议未就绪        -> 协商就绪检测被拖慢 5 倍
		#     rc=2/3 温度异常         -> 回到正常温度后迟迟不恢复干预
		#   这些都是【会自己好的瞬时状态】，必须保持 2 秒快速重试。
		#   真正该降频的只有两个「模块无事可做且不会很快变化」的：
		#     4 = 未插电 / 电流不足   5 = SOC 超出生效区间
		4|5) return 0 ;;
		# ★★ v3556：rc=1 有【两种来源】，靠 ST_GEAR 区分 ★★
		#   ① VOTE_MODE != 1 → ST_GEAR="已关闭直控"：用户主动关了直控，
		#      这是持续状态，永远不会自己变好 → 该降频。
		#   ② vot_inject 失败 → ST_GEAR 保持注入档但 ST_CAP="注入熔断"：
		#      瞬时故障，下一轮可能就好了 → 必须保持 2 秒快速重试。
		1) [ "$ST_GEAR" = "已关闭直控" ] && return 0 ; return 1 ;;
	esac
	return 1
}

loop() {

	exec </dev/null >/dev/null 2>&1

	if ! acquire_run_lock; then
		log "已有守护实例在运行 (pid ${LOCK_HOLDER:-未知})，本实例退出"
		exit 0
	fi

	load_profile   # 内部已含 load_safe_table（安全表随配置重算）

	profile_fingerprint_fast
	PROF_FP="$PROF_FP_NOW"

	if [ "$ACTIVE" = "3" ]; then
		rwhat=$(restore_to_system)
		rm -f "$PIDFILE" 2>/dev/null
		release_run_lock
		log "档位=原厂(3)，守护进程退出，不干预（交回系统方式=${rwhat:-未知}）"
		exit 0
	fi

	log "启动 SOC加速守护 [档位=$PROFILE_NAME]"
	log "  生效区间: 温度 ${TEMP_MIN}~${TEMP_RELEASE}(0.1C)  SOC ${SOC_MIN}~${SOC_MAX}%"
	log "  申请值: I_LOW=$I_LOW I_MID=$I_MID I_PEAK=$I_PEAK I_MID2=$I_MID2 I_LOW2=$I_LOW2"
	log "  热保护: 预警=${TEMP_WARN} 降A=${TEMP_CAP_A}(封顶${CAP_A}) 降B=${TEMP_CAP_B}(封顶${CAP_B})"
	log "          撒手=${TEMP_RELEASE} 恢复≤${TEMP_RECOVER}持续${TEMP_RECOVER_SEC}s 温度取${TEMP_HIST_N}点中位"

	# ★★★ v3569：三合一状态机（本轮核心重构）★★★
	#   【改造前】loop() 开头有三个独立循环，层层嵌套：
	#      A. 初始协议等待   while [_pw_i < 180]  → sleep 2  （最多 90 轮）
	#      B. 待机监听       while [PROTO_STANDBY] → sleep 10
	#           └ 内层协议等待 while [_pw_i < 180] → sleep 2
	#           └ 内层在线维持 while [online]      → sleep 5
	#      C. 主循环         while true            → sleep 2/20
	#   【它们其实是重复的】do_once() 自己会：
	#      · 读 online，未插电立即 return 4
	#      · 调 protocol_ready，未就绪 return 8
	#    也就是说 C 循环本来就能完整覆盖 A 和 B 的全部职责。
	#    A/B 存在的唯一历史原因是"早期 do_once 没有这两项检查"。
	#   【为什么这是大问题】
	#    1. 未插电时守护停在 B 循环，而 B 里每轮还有一个 sleep 10
	#       外加内层的 sleep 5 —— 多层嵌套让"到底哪条路径在跑"根本无法推理，
	#       之前几次改 CPU 占用改错地方，根因就在这。
	#    2. A/B 里重复实现了档位热重载、refresh_cache 降频、原厂档退出，
	#       与 C 里的实现不同步（比如 A 里每 4 轮 refresh，C 里每 3 轮），
	#       导致行为难以预测。
	#   【改造后】
	#     只保留 C 一个循环 + sleep 统一走 interval_now()。
	#     未插电 → do_once 返回 4 → 睡 INTERVAL_IDLE(20s)
	#     协议未就绪 → 返回 8 → 睡 INTERVAL(2s) 快速重试
	#     正常干预 → 返回 0 → 睡 INTERVAL(2s)
	#   【行为差异（可接受）】
	#     · 未插电时不再做"跳过 180 秒协商等待"的优化 —— 因为根本没有等待阶段了
	#     · save_original 由 write_node 在首次真正写节点时调用，比原来更精确
	#       （原地是协议就绪就调，即使这一轮没写任何节点）
	#     · 插电瞬间的最长响应从 10 秒变为 20 秒（按用户要求把 10s 调成 20s）
	log "启动 SOC加速守护（v3569 单循环架构）[档位=$PROFILE_NAME]"



	local last_rc=-1 last_gear="-" last_therm="" rc
	local pend_rc=-1 pend_cnt=0
	local PAUSED_ON=0
	# 上一次观察到的"充电器是否在线"，用于识别【拔线->重新插线】这个会话边界。
	#   初值给 "0"：守护启动时若本来就插着线，首轮会被当作"新会话"处理 ——
	#   这正是想要的（带线重启/重装后不该继承上一个会话的记忆）。
	local last_online="0" _ol

	while true; do
		# ★ v3568：每轮先打一次心跳（内建重定向，零 fork）
		beat

		# ---- 临时解除加速（照 120w 模块的 paused 机制）----
		#   标记存在 -> 把干预全部撤掉后【空转】（进程保留，随时可恢复）。
		#   与 ACTIVE=3 的区别：那是彻底停手并退出、重启也不回来；
		#   这里只是暂停，拔掉标记立刻接着干预。
		if [ -f "$PAUSE_FLAG" ]; then
			if [ "$PAUSED_ON" != "1" ]; then
				PAUSED_ON=1
				# 撤掉干预：判决层解 force + sysfs 交回 + 属性/场景回原值
				restore_to_system
				log "临时解除加速：已撤掉注入/节点/属性/场景，守护转入空转"
			fi
			# ★ v3569：暂停态同样不刷 status.json（理由同上，前端直读）
			sleep "$INTERVAL_IDLE"
			beat
			continue
		fi
		if [ "$PAUSED_ON" = "1" ]; then
			PAUSED_ON=0
			log "恢复加速：临时解除标记已清除，重新按档位干预"
			profile_fingerprint_fast
	PROF_FP="$PROF_FP_NOW"
			last_rc=-1; last_gear="-"; last_therm=""
			pend_rc=-1; pend_cnt=0
		fi

		# ---- 充电会话边界：拔线 -> 重新插线 ----
		#   【为什么每轮都要看】守护不像 120w 那样"每次插线都重开"，它是一直
		#     跑着的主循环；"拔线再插"这个动作只能靠自己观察 online 边沿发现。
		#   【为什么必须复位】上一次充电末期留下的温度档位、门禁记忆不会自己
		#     消失（未充电时主循环在 `online=0 -> return 4` 就返回了，压根走不到
		#     更新分支），于是第二次插线时干预被这些残留挡在门外。用户实测
		#     "重开一次守护（恢复原厂+重选档位）就好了"，正是因为重开是唯一会
		#     清空它们的操作。这里把同一个"清空"搬到插线时刻，就不必再手动操作。
		# ★★★ v3567：未插电极速休眠（本轮核心改造）★★★
		#   【改造前】主循环每一轮的顺序是：
		#       检查 pause → 检查拔插线 → 检查档位指纹 → do_once → refresh_cache → sleep
		#     也就是说，为了"知道没插电"这件事，模块先把所有活儿干了一遍：
		#     do_once 读十几个 sysfs + 遍历 DT 表 + 算五段电流（~1.6s CPU），
		#     然后每 3 轮再 fork 一次 refresh_cache（~900ms）。
		#   【改造后】先花 1 次内建 read（零 fork）问一句"插电了吗"，
		#     没插电就立刻 continue —— do_once 和 refresh_cache 一次都不跑。
		#     真正做到了"未充电时约等于 0 后台"。
		#   【安全性】拔线那一刻仍会完整撤一次干预（vot_release +
		#     vot_release），不会留下 force_active=1 挂在判决层。
		read_online_fast
		if [ "$ONLINE_FAST" != "1" ]; then
			if [ "$last_online" = "1" ]; then
				# 刚拔线：这一轮负责把干预撤干净，然后才进休眠
				VOT_SWEEP_ALL=0
				vot_release
				refresh_cache
				last_online="0"
				log "充电器已拔出：撤销全部干预，转入深度休眠（未插电时零轮询）"
			fi
			# ★★★ v3569：未插电时【完全停止】 status.json 轮询 ★★★
			#   用户要求"日常使用约等于 0 后台"，而这份缓存在未插电时毫无价值：
			#     WebUI 每次刷新都是先调 getjson【现场直读】（20 秒超时），
			#     读不到缓存它会自己走直读路径，用户体验完全一样。
			#   原来每 5 分钟 fork 几十次跑一遍 emit_json，纯属白烧 CPU。
			#   【唯一代价】KernelSU 管理器刚打开 WebUI 的第一帧可能显示
			#    上一次的旧数据（最多滞后到上次拔线那一刻），刷新一次即正确。
			interval_now 4
			sleep "$SLEEP_NOW"
			continue
		fi
		_ol=$ONLINE_FAST
		if [ "$_ol" = "1" ] && [ "$last_online" != "1" ]; then
			session_reset
			last_rc=-1; last_gear="-"; last_therm=""
			pend_rc=-1; pend_cnt=0
			log "检测到新的充电会话（充电器重新上线），已复位上次会话残留的协议/温度状态"
		fi
		last_online="$_ol"

		# ---- 档位热重载 ----

		profile_fingerprint_fast
		local m="$PROF_FP_NOW"
		[ -z "$m" ] && m=0
		if [ "$m" != "$PROF_FP" ]; then
			load_profile
			PROF_FP="$m"

			if [ "$ACTIVE" = "3" ]; then
				rwhat=$(restore_to_system)
				rm -f "$PIDFILE" 2>/dev/null
				release_run_lock
				log "档位热重载 -> 原厂(3)，停止干预并退出（交回系统方式=${rwhat:-未知}）"
				exit 0
			fi

			log "档位热重载 -> $PROFILE_NAME (I_LOW=$I_LOW I_MID=$I_MID I_PEAK=$I_PEAK I_MID2=$I_MID2 I_LOW2=$I_LOW2)"

			do_once >/dev/null 2>&1

			last_rc=-1; last_gear="-"; last_therm=""; pend_rc=-1; pend_cnt=0
		fi

		do_once
		rc=$?

		# ★ v3543：未插电时不做 emit_json。
		#   【为什么】refresh_cache 的唯一作用是写 status.json 给前端读，
		#     而 emit_json 单次要 ~900ms（要读十几个 sysfs 节点 + 遍历 DT 表）。
		#     可未插电时前端显示的 soc/温度这些，2 秒刷一次和 10 秒刷一次
		#     对用户毫无区别 —— 反正模块也不干预，界面上的数字本来就在变。
		#   【代价】拔线后再插线，status.json 最多滞后 INTERVAL_IDLE 秒；
		#     但 WebUI 每轮先 getjson 现场直读（有 20 秒超时），不吃这个缓存。
		# ★★★ v3569：只有【正在干预】时才刷 status.json ★★★
		#   rc=0 才是模块真正在工作的状态，此时前端的功率/档位/温度
		#   都是用户最关心的，必须保持新鲜。
		#   rc≠0（未插电/过热/SOC超范围/协议未就绪）时模块不干预，
		#   前端每轮刷新本来就是 getjson 现场直读，不需要这份缓存，
		#   再轮询写它纯属白烧 CPU。这就是"待机约等于 0 后台"的最后一块。
		# ★★★ v3572：refresh_cache 降频 ★★★
		#   【原来的问题】rc=0（正在干预）时每一轮都调
		#     refresh_cache → emit_json，实测单次 1160ms。
		#     而主循环间隔只有 2 秒（INTERVAL=2），
		#     do_once 880ms + emit_json 1160ms = 2040ms，几乎填满 2 秒。
		#     实测插电时 daemon 占用 43%，就是这么来的。
		#     （上游旧版在 emit_json 里写过：“折算下来常驻 70% CPU，
		#      用户感受就是‘没插电、手机却一直发烫’”。）
		#   【为什么可以降】
		#     status.json 只是给 WebUI 轮询读的缓存；
		#     WebUI 每次刷新都会先 getjson 现场直读（不吃这份缓存），
		#     所以缓存降到 10 秒一次对界面几乎无感。
		#   【代价】界面上的功率/温度数字最多迟 10 秒，
		#     但用户点开 WebUI 看到的第一帧仍然是现读的真实值。
		if [ "$rc" -eq 0 ]; then
			CACHE_TICK=$((CACHE_TICK + 1))
			if [ "$CACHE_TICK" -ge "$CACHE_EVERY" ]; then
				CACHE_TICK=0
				refresh_cache
			fi
		fi

		# ★ v3523 修复：任何"模块没有在干预"的返回码，都必须把判决层交回系统。
		#
		#   【为什么放在这里统一处理，而不是散在各个 return 前面】
		#   do_once 里有 6 条路径会走到"不干预"：
		#     rc=1  节点缺失 / 注入熔断
		#     rc=2  温度过低
		#     rc=3  热保护封顶到 0
		#     rc=4  未插线 / 电流不足 IBAT_MIN / 未确认（3 条子路径）
		#     rc=5  分段电流算出来是 0
		#     rc=7  读不到 soc 或温度
		#     rc=8  协议门禁未就绪
		#   原先只有 rc=8 之后会在下一轮被 VOTE_MODE 分支或 votable 失败兜底
		#   调用 vot_release，其余路径全靠"下一次注入覆盖"。
		#   于是拔线后 force_active=1、fv=15600 一直挂着（实测到这个状态）。
		#
		#   【放这里的好处】
		#     · 一个判断点覆盖全部路径，不需要改动 do_once 里的 6 处 return
		#       —— 那些 return 前面还有大量局部变量作用域，分散加容易漏
		#     · vot_release 内部把 VOT_WROTE 归零，天然幂等：
		#       连续 2 秒一次的空转不会反复写 sysfs
		#
		#   注意 rc=0 是"正在干预"，rc=6 等其它码先按不干预处理也没坏处
		#   （vot_release 只对 active=1 的目标动手，本身是安全的）。
		if [ "$rc" != "0" ] && [ "$VOT_WROTE" != "0" ]; then
			vot_release
			log "交回系统：rc=$rc $(fmt_state "$rc")（末次注入 ${VOT_LAST_WANT:-未知}mA 已撤销）"
		fi

		# ---- 静默状态也要留痕（修诊断盲区）----
		#   rc=7/1/8 原本在下面的日志块【之前】就 continue 了，
		#   所以"协议门禁没过"(rc=8) 从来不落日志 —— 用户看到的现象是
		#   "这次什么记录都没有"，根本分不清是没充电、还是被门禁挡住了。
		#   rc=8 正是"第二次插线不加速"最可能的拦路者，必须能看见它。
		#   只在【状态变化】时记一行，避免每 2 秒刷一条冲垮日志。
		if [ "$rc" -eq 7 ] || [ "$rc" -eq 1 ] || [ "$rc" -eq 8 ]; then
			if [ "$rc" -ne "$last_rc" ]; then
				if [ "$rc" -eq 8 ]; then
					log "干预被门禁挡下 -> 协议未就绪(rc=8) [工作电压=${PROTO_UV_LAST:-读不到}uV 协议节点缺失=${PROTO_NODE_MISSING:-0}]"
				else
					log "静默状态 -> $(fmt_state "$rc")"
				fi
				last_rc=$rc
				last_gear="-"
			fi
			# ★ v3543：未插电时降频（同主流程理由）。
			interval_now "$rc"
			sleep "$SLEEP_NOW"
			continue
		fi

		local gear=""
		[ "$rc" -eq 0 ] && gear="$ST_GEAR"

		if [ "$ST_THERM" != "$last_therm" ]; then
			[ "$LOG_PREV_THERM" = "$ST_THERM" ] || {
				LOG_PREV_THERM="$ST_THERM"
				log "热保护状态 -> $(therm_name "$ST_THERM") [板级=$(f10s "$ST_TB_MED") 电池=$(f10s "$ST_TC_MED")]"
			}
			last_therm="$ST_THERM"

			log "  $(fmt_state "$rc")"
			last_rc=$rc
			last_gear="$gear"
			# ★ v3543：未插电时降频（同主流程理由）。
			interval_now "$rc"
			sleep "$SLEEP_NOW"
			continue
		fi

		# ---- 防抖：同一状态需连续 STABLE_N 次才落盘 ----
		if [ "$rc" -eq "$pend_rc" ]; then
			pend_cnt=$((pend_cnt + 1))
		else
			pend_rc=$rc
			pend_cnt=1
		fi

		if [ "$pend_cnt" -lt "$STABLE_N" ] && [ "$rc" -ne "$last_rc" ]; then
			# ★ v3543：未插电时降频（同主流程理由）。
			interval_now "$rc"
			sleep "$SLEEP_NOW"
			continue
		fi

		# ---- 只在【充电状态变化】或【档位变化】时记录 ----
		if [ "$rc" -ne "$last_rc" ] || [ "$gear" != "$last_gear" ]; then

			if [ "$last_rc" -ne -1 ] || [ "$rc" -ne 4 ]; then
				log "$(fmt_state "$rc")"
			fi
			last_rc=$rc
			last_gear="$gear"
		fi
		# ★ DBG
		# ★ v3543：未插电时降频轮询（理由见 INTERVAL_IDLE 定义处）。
		#   rc=4 是"未插线/电流不足/未确认"的统称，此时模块无事可做，
		#   2 秒一轮纯属空转（实测占 70%~80% CPU）。插电后第一轮立刻切回 2 秒。
		interval_now "$rc"
		sleep "$SLEEP_NOW"
	done
}

emit_json() {
	load_profile

	local _soc _temp _ibat _vbat _online _nv _vfl _ocv _pw _tb _tc
	local _chv="" _ibs="" _pwr="" _psrc=""

	# ★ v3572：用零 fork 探测复用 soc / vbat / online。
	#   原来 _soc=$(read_soc) / _vbat=$(read_vbat) / _online=$(read_charger_online)
	#   三次 $( ) 各 fork 一个子 shell（实测 ~31ms/次），
	#   而 probe_fast 一次就把它们全读完，全部 read 内建零 fork。
	probe_fast
	_soc="$PF_SOC"
	# ★★ v3551：read_temp 内部就是「读 board + 读 batt 取小」，
	#   原来又单独 $(read_temp_board) / $(read_temp_batt) 各 fork 一次，
	#   等于同一批节点读两遍，多 2 次 fork ≈ 50ms（本机 fork 实测 24ms/次）。
	#   这里改成「各读一次，temp 就地取小」，语义完全等价。
	_tb=$(read_temp_board)
	_tc=$(read_temp_batt)
	if [ -n "$_tb" ] && [ -n "$_tc" ]; then
		[ "$_tb" -lt "$_tc" ] && _temp="$_tb" || _temp="$_tc"
	elif [ -n "$_tb" ]; then
		_temp="$_tb"
	else
		_temp="$_tc"
	fi
	# vbat 先读，供 read_ibat 的功率交叉验证使用（见 read_ibat 注释）
	_vbat=$(read_vbat)
	_ibat=$(read_ibat "$_vbat")
	_online="$PF_ONLINE"
	# ★ v3543：read 内建，三处 cat → 零 fork。
	_nv="";  read -r _nv  < "$NODE"                                  2>/dev/null
	_vfl=""; read -r _vfl < /sys/class/cms_class/vfloat_voltage      2>/dev/null
	_ocv=""; read -r _ocv < /sys/class/power_supply/battery/voltage_ocv 2>/dev/null
	_pw=$(read_input_power)

	if [ -n "$_pw" ]; then
		set -- $_pw
		_pwr="$3"; _psrc="$4"
		case "$_psrc" in
			in)
				_chv="$1"; _ibs="$2"
				;;
			bat)
				;;
		esac
	fi

	# ★ v3543：read 内建，去掉 $(cat "$PIDFILE") 的 fork。
	local _run="false" _run_pid=""
	if [ -f "$PIDFILE" ]; then
		read -r _run_pid < "$PIDFILE" 2>/dev/null
		case "$_run_pid" in
			''|*[!0-9]*) ;;
			*) kill -0 "$_run_pid" 2>/dev/null && _run="true" ;;
		esac
	fi
	# 「临时解除加速」当前是否生效（供界面显示与按钮态）
	local _paused="false"
	[ -f "$PAUSE_FLAG" ] && _paused="true"

	# ★ v3543：无 fork 的数值清洗。
	#   【为什么必须有这个】原实现每个字段都写成 "$(jnum "$x")"，
	#     emit_json 里共有约 95 个命令替换 —— 每一个都会 fork 一个子进程。
	#     实测单次 emit_json：1417ms、读取 22MB、1.1 万次 syscall，
	#     其中绝大部分就是 fork/exec 的固定开销，跟真正要读的 sysfs 无关。
	#     守护进程每 2 秒调一次（refresh_cache 里），折算下来常驻 70% CPU，
	#     用户感受就是"没插电、手机却一直发烫"。
	#   【改法】jset 只是同 shell 内的 case 赋值，不产生子进程；
	#     结果落在 $JR，调用方直接取用。
	#     95 次 fork → 0 次，耗时从 1417ms 掉到百毫秒级。
	JR=""
	jset() {
		case "$1" in
			''|*[!0-9-]*) JR=null ;;
			*) JR="$1" ;;
		esac
	}

	local _cells=1
	_cells=$(read_cells 2>/dev/null)
	case "$_cells" in 1|2) ;; *) _cells=1 ;; esac

	local _vbat_disp=""
	if [ -n "$_vbat" ]; then
		_vbat_disp=$((_vbat / _cells))
	fi
	local _vbat_uv=""
	[ -n "$_vbat" ] && _vbat_uv=$((_vbat * 1000))

	# ---- DT 出厂分段表 ----
	#   ★ v3543：改成一次遍历全部取出。
	#     原来是 5 次 $(dt_table_get segN)，每次 fork 一个子 shell
	#     （子 shell 还得把整个 6000 行脚本再解析一遍），实测这 5 次贡献 ~70ms。
	#     现在直接在同一个循环里把 5 个值一次拿齐，零 fork。
	local _src="none" _d1="" _d2="" _d3="" _d4="" _d5=""
	if dt_ensure 2>/dev/null; then
		_src="dt"
		local _e _n _v
		for _e in $DT_TABLE; do
			_n=${_e%%=*}
			_v=${_e#*=}
			_v=${_v%%:*}
			case "$_v" in ''|*[!0-9]*) continue ;; esac
			case "$_n" in
				seg1) _d1="$_v" ;;
				seg2) _d2="$_v" ;;
				seg3) _d3="$_v" ;;
				seg4) _d4="$_v" ;;
				seg5) _d5="$_v" ;;
			esac
		done
	fi

	# ★ v3518/v3519：开关类状态一律【现读 profile】，不用内存缓存。
	#   原因见 _prof_flag() 处的长注释。缓存会导致：
	#     · status.json 写旧值 → 前端弹回
	#     · log() 用旧值判断 → 日志开关不生效
	local _caloc_live
	prof_live_flags
	_caloc_live="$PLF_CAL_OC"

	# 按 live 的 oc 值现算上限（与 cal_max() 同一规则）
	# ★ v3543：cal_dt_max 内部本来就有 CAL_DT_MAX_CACHE 全局缓存，
	#   但 $( ) 仍然会 fork 一个子 shell（~60ms）。这里直接调函数
	#   （同 shell 执行，不 fork），然后读它的全局缓存。
	local _dt_live _cap_live
	cal_dt_max >/dev/null 2>&1
	_dt_live="$CAL_DT_MAX_CACHE"
	case "$_dt_live" in ''|*[!0-9]*) _dt_live="" ;; esac
	if [ -n "$_dt_live" ]; then
		if [ "$_caloc_live" = "1" ]; then
			_cap_live="$_dt_live"
			[ "$CAL_OC_MAX" -gt "$_cap_live" ] 2>/dev/null && _cap_live="$CAL_OC_MAX"
		else
			_cap_live="$_dt_live"
		fi
	else
		_cap_live="$(cal_max 2>/dev/null)"
		case "$_cap_live" in ''|*[!0-9]*) _cap_live=14100 ;; esac
	fi

	# ★ v3543：复用上面 prof_live_flags 的结果，不再单独 fork 一次。
	local _logen_live="$PLF_LOG_EN"

	local _vr=0
	votable_ready >/dev/null 2>&1 && _vr=1

	local _why _active
	_why=$(why_inactive "$_soc" "$_tb" "$_tc" "$_online" "$ST_THERM")
	_active="true"
	[ -n "$_why" ] && _active="false"

	local _B _L1 _L2 _L3 _L4 _LF
	_B=$VOTE_IBAT
	case "$_B" in ''|*[!0-9]*) _B=6400 ;; esac
	_L1=$(( _B * VOTE_PCT1 / 100 ))
	_L2=$(( _B * VOTE_PCT2 / 100 ))
	_L3=$(( _B * VOTE_PCT3 / 100 ))
	_L4=$(( _B * VOTE_PCT4 / 100 ))
	_LF=$(( _B * VOTE_PCT_FLOOR / 100 ))

	# ---- 字符串清洗：一次性去引号/反斜杠/换行，避免逐字段 fork ----
	local _S_name _S_devc _S_devm _S_vt _S_vwhy _S_why _S_valid
	# ★ v3543：零 fork 版本。原来 7 次 $(printf | tr) = 14 个进程，
	#   现在用 shell 参数展开纯内建完成，零 fork。
	_S_name=${PROFILE_NAME//\"/}
	_S_name=${_S_name//\\/}
	_S_devc=${DEV_CLASS//\"/}
	_S_devc=${_S_devc//\\/}
	_S_devm=${DEV_MODEL//\"/}
	_S_devm=${_S_devm//\\/}
	_S_vt=${VOTE_TARGETS//\"/}
	_S_vt=${_S_vt//\\/}
	_S_vwhy=${VOT_WHY//\"/}
	_S_vwhy=${_S_vwhy//\\/}
	_S_why=${_why//\"/}
	_S_why=${_S_why//\\/}
	_S_valid=${VALID_CURRENTS//\"/}
	_S_valid=${_S_valid//\\/}

	local _psrc_j="null"
	case "$_psrc" in in|bat) _psrc_j="\"$_psrc\"" ;; esac

	# ---- 批量清洗（全部同 shell 内完成，零 fork）----
	local _j_soc _j_temp _j_tb _j_tc _j_ibat _j_vbat _j_online _j_vbatuv
	local _j_vbatcell _j_cells _j_node _j_vfloat _j_ocv _j_chgv _j_ibus _j_power
	local _j_active _j_d1 _j_d2 _j_d3 _j_d4 _j_d5
	local _j_therm _j_tmed _j_tbmed _j_tcmed
	local _j_low _j_mid _j_peak _j_mid2 _j_low2
	local _j_bmin _j_bt1 _j_bt2 _j_bt3 _j_bt4 _j_bmax _j_smin _j_smax
	local _j_calmax _j_caldanger _j_caldt _j_calabs _j_caloc _j_calocmax _j_logen
	local _j_vrmode _j_vribat _j_vt1 _j_vt2 _j_vt3 _j_vt4 _j_vt5
	local _j_l1 _j_l2 _j_l3 _j_l4 _j_lf
	local _j_ten _j_tstart _j_tstop _j_warn _j_capa _j_capb _j_rel _j_rec
	local _j_tcwarn _j_tccapa _j_tccapb _j_tcrel _j_tcrec
	local _j_sfen _j_sfcap _j_sfdrop
	local _j_cwarn _j_ccapa _j_ccapb _j_crel _j_crec _j_capaV _j_capbV

	jset "$_soc";        _j_soc=$JR
	jset "$_temp";       _j_temp=$JR
	jset "$_tb";         _j_tb=$JR
	jset "$_tc";         _j_tc=$JR
	jset "$_ibat";       _j_ibat=$JR
	jset "$_vbat";       _j_vbat=$JR
	jset "$_online";     _j_online=$JR
	jset "$_vbat_uv";    _j_vbatuv=$JR
	jset "$_vbat_disp";  _j_vbatcell=$JR
	jset "$_cells";      _j_cells=$JR
	jset "$_nv";         _j_node=$JR
	jset "$_vfl";        _j_vfloat=$JR
	jset "$_ocv";        _j_ocv=$JR
	jset "$_chv";        _j_chgv=$JR
	jset "$_ibs";        _j_ibus=$JR
	jset "$_pwr";        _j_power=$JR
	jset "$ACTIVE";      _j_active=$JR
	jset "$_d1";         _j_d1=$JR
	jset "$_d2";         _j_d2=$JR
	jset "$_d3";         _j_d3=$JR
	jset "$_d4";         _j_d4=$JR
	jset "$_d5";         _j_d5=$JR
	jset "$ST_THERM";    _j_therm=$JR
	jset "$ST_TMED";     _j_tmed=$JR
	jset "$ST_TB_MED";   _j_tbmed=$JR
	jset "$ST_TC_MED";   _j_tcmed=$JR
	jset "$I_LOW";       _j_low=$JR
	jset "$I_MID";       _j_mid=$JR
	jset "$I_PEAK";      _j_peak=$JR
	jset "$I_MID2";      _j_mid2=$JR
	jset "$I_LOW2";      _j_low2=$JR
	jset "$SOC_MIN";     _j_bmin=$JR
	jset "$SOC_T1";      _j_bt1=$JR
	jset "$SOC_T2";      _j_bt2=$JR
	jset "$SOC_T3";      _j_bt3=$JR
	jset "$SOC_T4";      _j_bt4=$JR
	jset "$SOC_MAX";     _j_bmax=$JR
	# ★ v3536：把可调范围一起发出去，前端滑动条的 min/max 直接用它，
	#   避免前后端各写一份上下限导致漂移（历史上有过三处口径不一致的坑）。
	jset "$SOC_STOP_MIN"; _j_smin=$JR
	jset "$SOC_STOP_MAX"; _j_smax=$JR
	jset "$_cap_live";   _j_calmax=$JR
	jset "$CAL_DANGER";  _j_caldanger=$JR
	jset "$_dt_live";    _j_caldt=$JR
	jset "$CAL_ABS_HARD"; _j_calabs=$JR
	jset "$_caloc_live"; _j_caloc=$JR
	jset "$CAL_OC_MAX";  _j_calocmax=$JR
	jset "$_logen_live"; _j_logen=$JR
	jset "$VOTE_MODE";   _j_vrmode=$JR
	jset "$VOTE_IBAT";   _j_vribat=$JR
	jset "$VOTE_T1";     _j_vt1=$JR
	jset "$VOTE_T2";     _j_vt2=$JR
	jset "$VOTE_T3";     _j_vt3=$JR
	jset "$VOTE_T4";     _j_vt4=$JR
	jset "$VOTE_T5";     _j_vt5=$JR
	jset "$_L1";         _j_l1=$JR
	jset "$_L2";         _j_l2=$JR
	jset "$_L3";         _j_l3=$JR
	jset "$_L4";         _j_l4=$JR
	jset "$_LF";         _j_lf=$JR
	jset "$THERM_EN";    _j_ten=$JR
	jset "$THERM_START"; _j_tstart=$JR
	jset "$THERM_STOP";  _j_tstop=$JR
	jset "$TEMP_WARN";   _j_warn=$JR
	jset "$TEMP_CAP_A";  _j_capa=$JR
	jset "$TEMP_CAP_B";  _j_capb=$JR
	jset "$TEMP_RELEASE"; _j_rel=$JR
	jset "$TEMP_RECOVER"; _j_rec=$JR
	jset "$TC_WARN";     _j_tcwarn=$JR
	jset "$TC_CAP_A";    _j_tccapa=$JR
	jset "$TC_CAP_B";    _j_tccapb=$JR
	jset "$TC_RELEASE";  _j_tcrel=$JR
	jset "$TC_RECOVER";  _j_tcrec=$JR
	jset "$SAFE_EN";     _j_sfen=$JR
	jset "$SAFE_CAP";    _j_sfcap=$JR
	jset "$SAFE_DROP_TOTAL"; _j_sfdrop=$JR
	jset "$TEMP_WARN";   _j_cwarn=$JR
	jset "$TEMP_CAP_A";  _j_ccapa=$JR
	jset "$TEMP_CAP_B";  _j_ccapb=$JR
	jset "$TEMP_RELEASE"; _j_crel=$JR
	jset "$TEMP_RECOVER"; _j_crec=$JR
	jset "$CAP_A";       _j_capaV=$JR
	jset "$CAP_B";       _j_capbV=$JR

	# ★★★ v3572：emit_json 输出段改造为「一次拼接 + 一次 echo」 ★★★
	#   【原来的问题】这里有 30 次 printf，而 mksh 里 printf 是
	#     /system/bin/printf（外部程序，`type printf` 显示 tracked alias），
	#     每一次都要 fork + exec 一个进程。实测：
	#       30 次 printf        = 530ms
	#       30 次拼接 + echo -n =  20ms     （快 26 倍）
	#     emit_json 单次 1410ms 里，光这一段的 printf 就占了 530ms，
	#     而真正读传感器（read_soc/read_vbat/read_ibat/read_input_power）
	#     加起来才 200ms 左右 —— 也就是说这个函数 4 成的时间
	#     只是在生成 JSON 文本。
	#   【改法】全部改用 shell 内建：变量拼接（零成本）+ 末尾一次 echo -n。
	#     echo / print 在本机都是 shell builtin（`type echo` 已确认），
	#     不产生任何子进程。
	#   【注意】这里用 echo -n 只输出一次，不再逐段 flush；
	#     内容与原 printf 逐字节等价（逗号/引号位置完全保留）。
	#     唯一的 $(date +%s) 仍然 fork 一次，但只有 1 次，可接受。
	local _J=""
	_J="${_J}{\"soc\":${_j_soc},\"temp\":${_j_temp},\"tempBoard\":${_j_tb},\"tempBatt\":${_j_tc},"
	_J="${_J}\"ibat\":${_j_ibat},\"vbat\":${_j_vbat},\"online\":${_j_online},\"vbatUv\":${_j_vbatuv},"
	_J="${_J}\"vbatCell\":${_j_vbatcell},\"cells\":${_j_cells},"
	_J="${_J}\"node\":${_j_node},\"vfloat\":${_j_vfloat},\"ocv\":${_j_ocv},"
	_J="${_J}\"chgV\":${_j_chgv},\"ibus\":${_j_ibus},\"power\":${_j_power},\"powerSrc\":${_psrc_j},"
	_J="${_J}\"active\":${_j_active},\"profileName\":\"${_S_name}\",\"running\":${_run},\"paused\":${_paused},"
	_J="${_J}\"factorySrc\":\"${_src}\",\"dtSeg1\":${_j_d1},\"dtSeg2\":${_j_d2},\"dtSeg3\":${_j_d3},\"dtSeg4\":${_j_d4},\"dtSeg5\":${_j_d5},"
	_J="${_J}\"thermState\":${_j_therm},\"thermMed\":${_j_tmed},"
	_J="${_J}\"thermBoardMed\":${_j_tbmed},\"thermBattMed\":${_j_tcmed},"
	_J="${_J}\"cal\":{\"low\":${_j_low},\"mid\":${_j_mid},\"peak\":${_j_peak},\"mid2\":${_j_mid2},\"low2\":${_j_low2}},"
	_J="${_J}\"bounds\":{\"min\":${_j_bmin},\"t1\":${_j_bt1},\"t2\":${_j_bt2},\"t3\":${_j_bt3},\"t4\":${_j_bt4},\"max\":${_j_bmax},"
	_J="${_J}\"stopMin\":${_j_smin},\"stopMax\":${_j_smax}},"
	_J="${_J}\"intervening\":${_active},\"whyInactive\":\"${_S_why}\","
	_J="${_J}\"valid\":\"${_S_valid}\","
	_J="${_J}\"calMax\":${_j_calmax},\"calDanger\":${_j_caldanger},\"calDt\":${_j_caldt},\"calAbsHard\":${_j_calabs},"
	# ★ v3515：把超频档状态一起发给前端，界面据此显示开关与红色警示
	_J="${_J}\"calOc\":${_j_caloc},\"calOcMax\":${_j_calocmax},"
	# ★ v3517/v3519：日志开关状态一起发给前端。同样现读 profile。
	_J="${_J}\"logEn\":${_j_logen},"
	_J="${_J}\"voter\":{\"ready\":${_vr},\"mode\":${_j_vrmode},\"target\":\"${_S_vt}\",\"ibat\":${_j_vribat},"
	_J="${_J}\"t1\":${_j_vt1},\"t2\":${_j_vt2},\"t3\":${_j_vt3},\"t4\":${_j_vt4},\"t5\":${_j_vt5},"
	_J="${_J}\"lvl1\":${_j_l1},\"lvl2\":${_j_l2},\"lvl3\":${_j_l3},\"lvl4\":${_j_l4},\"floor\":${_j_lf},"
	_J="${_J}\"pct1\":${VOTE_PCT1},\"pct2\":${VOTE_PCT2},\"pct3\":${VOTE_PCT3},\"pct4\":${VOTE_PCT4},\"pctFloor\":${VOTE_PCT_FLOOR},"
	_J="${_J}\"why\":\"${_S_vwhy}\"},"
	# ---- 温控 / 防掉档 / 设备类别（WebUI 可读写）----
	#   therm.start/stop 单位 0.1C；safe.cap 单位 mA（0=反应式不静态封顶）
	_J="${_J}\"therm\":{\"en\":${_j_ten},\"start\":${_j_tstart},\"stop\":${_j_tstop},"
	_J="${_J}\"warn\":${_j_warn},\"capA\":${_j_capa},\"capB\":${_j_capb},\"release\":${_j_rel},\"recover\":${_j_rec},"
	# 电池侧固定保护线（不可调）：界面要如实告诉用户还有这一路，
	#   所以由后端输出，避免前端硬编码与脚本常量漂移。
	_J="${_J}\"tcWarn\":${_j_tcwarn},\"tcCapA\":${_j_tccapa},\"tcCapB\":${_j_tccapb},\"tcRelease\":${_j_tcrel},\"tcRecover\":${_j_tcrec}},"
	_J="${_J}\"safecap\":{\"en\":${_j_sfen},\"cap\":${_j_sfcap},\"dropTotal\":${_j_sfdrop}},"
	_J="${_J}\"dev\":{\"class\":\"${_S_devc}\",\"model\":\"${_S_devm}\"},"
	_J="${_J}\"caps\":{\"warn\":${_j_cwarn},\"capA\":${_j_ccapa},\"capB\":${_j_ccapb},\"release\":${_j_crel},\"recover\":${_j_crec},\"capAVal\":${_j_capaV},\"capBVal\":${_j_capbV}}"
	_J="${_J},\"ts\":$(date +%s 2>/dev/null)}"
	echo "$_J"
}

refresh_cache() {
	# ★ v3518 关键修复：写缓存前必须确保内存与 profile 一致。
	#
	#   【为什么这是「弹回」的最后一环】
	#     主循环的写法是：
	#         do_once          ← 用【进来时】的内存值算一轮（可能耗时十几秒）
	#         refresh_cache    ← 把这一轮的结果（含 calOc）写进 status.json
	#     热重载检查在 do_once 之前，但 do_once 本身很慢。
	#     如果你在 do_once 跑到一半时点了超频开关：
	#       · do_once 手里还是旧的 CAL_OC
	#       · refresh_cache 把这个旧值写进 status.json
	#       · 前端轮询立刻读到旧值 → 界面弹回
	#       · 要等下一轮 do_once 才纠正（5~15 秒）
	#     这正是「点完弹回、过一会又好了」的完整链路。
	#
	#   【修法】在写缓存【之前】再比一次指纹。变了就先 load_profile，
	#     让这一轮写出去的已经是新值。
	#   成本：一次 profile_fingerprint（读 20 行小文件，约 1~2ms），
	#     相对每轮几百毫秒的 do_once 可以忽略。
	profile_fingerprint_fast
	local _fp_now="$PROF_FP_NOW"
	[ -z "$_fp_now" ] && _fp_now=0
	if [ "$_fp_now" != "$PROF_FP" ]; then
		load_profile
		PROF_FP="$_fp_now"
	fi

	emit_json > "$CACHE_TMP" 2>/dev/null

	[ -s "$CACHE_TMP" ] && mv -f "$CACHE_TMP" "$CACHE_FILE"
	return 0
}

_vote_set() {
	local _k=$1 _v=$2

	# 先读回现有配置，保证只覆盖被修改的那一项，其余（含 I_*/温控）保持不变。
	load_profile

	case "$_k" in
		vote_target)
			# 目标已固定为 USER_IBAT + USER_IBUS（对齐 120w），不再可切换。
			# 保留这个键只为兼容旧版 WebUI 的调用，收到即回成功。
			VOT_OK=""
			return 0
			;;
		vote_mode|vote_ibat|vote_t1|vote_t2|vote_t3|vote_t4|vote_t5)
			case "$_v" in
				''|*[!0-9]*) echo "ERR: 值必须是非负整数（收到 '$_v'）"; return 1 ;;
			esac
			;;
		*)
			echo "ERR: 未知的硬件直控参数 $_k"
			return 1
			;;
	esac

	case "$_k" in
		vote_mode)

			if [ "$_v" = "1" ]; then
				load_profile
				votable_ready
				if [ "$VOT_OK" != "1" ]; then
					echo "ERR: 本机不支持硬件直控（$VOT_WHY）"
					echo "HINT: 骁龙机型（V2408A/V2463A）实测可用；V2405A 等 MTK 机型不可用"
					return 1
				fi
			fi
			VOTE_MODE=$_v
			;;
		vote_target)
			: ;;
		vote_ibat)

			if [ "$_v" -lt "$VOTE_FLOOR_MIN" ]; then
				echo "ERR: 电流总闸 $_v 低于安全下限 ${VOTE_FLOOR_MIN}mA（低于此值会掉进约13W 死区，0 等于掐死充电）"
				return 1
			fi

			if [ "$_v" -gt "$CAL_ABS_HARD" ]; then
				echo "ERR: 电流总闸 $_v 超过 ${CAL_ABS_HARD}mA，疑似误填（本机当前可用上限 $(cal_max)）"
				return 1
			fi
			VOTE_IBAT=$_v
			;;
		vote_t1|vote_t2|vote_t3|vote_t4|vote_t5)

			if [ "$_v" -gt 1200 ]; then
				echo "ERR: 温度门限 $_v 超过 1200（=120.0℃），请检查是否误填了摄氏度数"
				return 1
			fi
			case "$_k" in
				vote_t1) VOTE_T1=$_v ;;
				vote_t2) VOTE_T2=$_v ;;
				vote_t3) VOTE_T3=$_v ;;
				vote_t4) VOTE_T4=$_v ;;
				vote_t5) VOTE_T5=$_v ;;
			esac
			;;
		*)
			echo "ERR: 未知的硬件直控参数 $_k"
			return 1
			;;
	esac

	# 落盘统一出口（v3.5.11 起只有 save_profile 一处写 profile）
	save_profile || { echo "ERR: 写配置失败"; return 1; }

	echo "OK $_k=$_v"
	return 0
}

# ---- 温控 / 防掉档参数写入（WebUI 调用）----
#   单位：therm_start/therm_stop = 0.1C；safe_cap = mA（0=反应式，不静态封顶）
_cfg_set() {
	local _k=$1 _v=$2

	# 先读回现有配置，保证只覆盖被修改的那一项，其余保持不变。
	load_profile

	case "$_v" in
		''|*[!0-9]*) echo "ERR: 值必须是非负整数（收到 '$_v'）"; return 1 ;;
	esac

	case "$_k" in
		therm_en)
			case "$_v" in 0|1) THERM_EN=$_v ;; *) echo "ERR: 温控开关只能是 0/1"; return 1 ;; esac
			;;
		therm_start)
			# 合理区间 30.0~100.0C
			[ "$_v" -lt 300 ] && { echo "ERR: 开始降流温度 $_v 低于 30.0℃"; return 1; }
			[ "$_v" -gt 1000 ] && { echo "ERR: 开始降流温度 $_v 高于 100.0℃（是否误填摄氏度数？）"; return 1; }
			THERM_START=$_v
			;;
		therm_stop)
			[ "$_v" -lt 300 ] && { echo "ERR: 停止干预温度 $_v 低于 30.0℃"; return 1; }
			[ "$_v" -gt 1000 ] && { echo "ERR: 停止干预温度 $_v 高于 100.0℃（是否误填摄氏度数？）"; return 1; }
			THERM_STOP=$_v
			;;
		safe_en)
			case "$_v" in 0|1) SAFE_EN=$_v ;; *) echo "ERR: 防掉档开关只能是 0/1"; return 1 ;; esac
			;;
		safe_cap)
			# 0 = 反应式（跟随观测掉档，不静态封顶）
			if [ "$_v" -gt 0 ]; then
				[ "$_v" -lt 1000 ] && { echo "ERR: 安全上限 $_v 低于 1000mA（会掉进约13W 死区）"; return 1; }
				[ "$_v" -gt 20000 ] && { echo "ERR: 安全上限 $_v 超过 20000mA，疑似误填"; return 1; }
			fi
			SAFE_CAP=$_v
			;;
		soc_stop)
			# ★ v3536：停止介入电量（%）。
			#   语义：SOC 超过这个值后模块不再写节点，把控制权交回系统。
			#   100 = 一直管到满。
			[ "$_v" -lt "$SOC_STOP_MIN" ] && {
				echo "ERR: 停止介入电量 $_v% 低于下限 ${SOC_STOP_MIN}%（再低模块基本不介入）"
				return 1
			}
			[ "$_v" -gt "$SOC_STOP_MAX" ] && {
				echo "ERR: 停止介入电量 $_v% 超过上限 ${SOC_STOP_MAX}%"
				return 1
			}
			[ "$_v" -le "$SOC_MIN" ] && {
				echo "ERR: 停止介入电量 $_v% 必须高于介入下限 ${SOC_MIN}%"
				return 1
			}
			SOC_MAX=$_v
			;;
		cal_oc)
			# ★ v3515：超频档开关（默认 0）
			case "$_v" in
				0|1) ;;
				*) echo "ERR: 超频档开关只能是 0（关）或 1（开）"; return 1 ;;
			esac

			# 记录切换前的旧上限，用于判断「段位值是否恰好等于旧上限」
			local _oldcap _newcap
			_oldcap=$(cal_max 2>/dev/null)
			case "$_oldcap" in ''|*[!0-9]*) _oldcap=0 ;; esac

			CAL_OC=$_v
			# 上限缓存必须失效：cal_max() 依赖 CAL_OC，不刷新会继续吐旧值
			cal_max_refresh

			_newcap=$(cal_max 2>/dev/null)
			case "$_newcap" in ''|*[!0-9]*) _newcap=0 ;; esac

			# 【为什么要把段位一起抬/降】
			#   如果只改上限而不动段位，用户点「开启超频档」后会发现
			#   段位表还是 14100、总闸还是 14100 —— 因为 profile 里存着旧值，
			#   load_profile 读回旧值就不再套默认。表现为「开关点了没反应」。
			#   迁移条件很保守：只动「恰好等于旧上限」的项 ——
			#   这说明它是跟着上限自动铺的值，不是用户手动选的。
			#   用户手动设过更低值的，一律保留。
			if [ "$_oldcap" -gt 0 ] && [ "$_newcap" -gt 0 ] && \
			   [ "$_oldcap" != "$_newcap" ]; then
				[ "$I_LOW"  = "$_oldcap" ] && I_LOW="$_newcap"
				[ "$I_MID"  = "$_oldcap" ] && I_MID="$_newcap"
				[ "$I_PEAK" = "$_oldcap" ] && I_PEAK="$_newcap"
				[ "$I_MID2" = "$_oldcap" ] && I_MID2="$_newcap"
				[ "$I_LOW2" = "$_oldcap" ] && I_LOW2="$_newcap"
				[ "$VOTE_IBAT" = "$_oldcap" ] && VOTE_IBAT="$_newcap"

				# 新上限比旧的低（关超频）时，超出的值必须压回来，
				# 否则 profile 里会留下越界值，下次 load_profile 才钳制，
				# 中间窗口内 emit_json 会报出与实际不符的数字。
				[ "$I_LOW"  -gt "$_newcap" ] && I_LOW="$_newcap"
				[ "$I_MID"  -gt "$_newcap" ] && I_MID="$_newcap"
				[ "$I_PEAK" -gt "$_newcap" ] && I_PEAK="$_newcap"
				[ "$I_MID2" -gt "$_newcap" ] && I_MID2="$_newcap"
				[ "$I_LOW2" -gt "$_newcap" ] && I_LOW2="$_newcap"
				[ "$VOTE_IBAT" -gt "$_newcap" ] && VOTE_IBAT="$_newcap"

				log "超频档切换 CAL_OC=$CAL_OC：上限 $_oldcap -> $_newcap mA，段位与总闸已同步"
			fi
			;;
		log_en)
			# ★ v3517：日志总开关
			case "$_v" in
				0|1) LOG_EN=$_v ;;
				*) echo "ERR: 日志开关只能是 0（关）或 1（开）"; return 1 ;;
			esac
			;;
		*)
			echo "ERR: 未知参数 $_k"
			return 1
			;;
	esac

	# 交叉校验：停止温度必须高于开始温度
	if [ "$THERM_EN" = "1" ] && [ "$THERM_STOP" -le "$THERM_START" ]; then
		echo "ERR: 停止干预温度(${THERM_STOP}) 必须高于 开始降流温度(${THERM_START})"
		return 1
	fi

	save_profile || { echo "ERR: 写配置失败"; return 1; }

	# ★ v3519：开关类参数（cal_oc / log_en）落盘后立刻同步 status.json。
	#
	#   理由与 setoc 那段相同：守护进程的 do_once 在充电时要跑十几秒，
	#   前端每 2 秒轮询 status.json，会读到旧值 → 界面「弹回」。
	#   这里就地改掉对应字段，前端立刻看到正确状态。
	#   只处理会影响 UI 开关状态的键，其余键不动（避免无谓改写）。
	case "$_k" in
		cal_oc)
			if [ -f "$CACHE_FILE" ]; then
				local _tc="${CACHE_FILE}.cfg.$$"
				sed -e "s/\"calOc\":[0-9]*/\"calOc\":$CAL_OC/" \
				    -e "s/\"calMax\":[0-9]*/\"calMax\":$(cal_max)/" \
				    "$CACHE_FILE" > "$_tc" 2>/dev/null
				[ -s "$_tc" ] && mv -f "$_tc" "$CACHE_FILE" 2>/dev/null || rm -f "$_tc" 2>/dev/null
			fi
			;;
		log_en)
			if [ -f "$CACHE_FILE" ]; then
				local _tl="${CACHE_FILE}.cfg.$$"
				sed "s/\"logEn\":[0-9]*/\"logEn\":$LOG_EN/" \
				    "$CACHE_FILE" > "$_tl" 2>/dev/null
				[ -s "$_tl" ] && mv -f "$_tl" "$CACHE_FILE" 2>/dev/null || rm -f "$_tl" 2>/dev/null
			fi
			;;
	esac

	echo "OK $_k=$_v"
	return 0
}

# 批量写入：setcal k1 v1 k2 v2 ...
# 逐项先做校验并更新内存变量，全部合法才落盘一次。
# 目的：前端一次保存多个参数时，把 N 次进程 fork 压成1 次——
#       旧实现每项都 fork 一遍完整脚本再各自写一次 profile，
#       在 WebUI 上表现为"每次保存都卡一下"。
# 任一项非法则回显是哪个键出错（前面的项已按单项语义落盘，
# 与用户"改一项保存一项"的直觉一致，不做静默回滚）。
_cal_batch() {
	local _n=$# _i=1 _k _v _err="" _done=0

	while [ "$_i" -lt "$_n" ]; do
		_k=$1
		_v=$2
		shift 2
		_i=$((_i + 2))

		[ -z "$_k" ] && continue

		if ! _out=$(set_cal "$_k" "$_v" 2>&1); then
			_err="$_k -> $(echo "$_out" | sed 's/^ERR: *//' | head -1)"
			break
		fi
		_done=$((_done + 1))
	done

	if [ -n "$_err" ]; then
		echo "ERR: $_err"
		return 1
	fi

	# 让守护进程尽快看到新配置（指纹变化即热重载）
	echo "OK batch=$_done"
	return 0
}

set_cal() {
	local _seg=$1 _val=$2

	case "$_seg" in
		vote_mode|vote_target|vote_ibat|vote_t1|vote_t2|vote_t3|vote_t4|vote_t5)
			_vote_set "$_seg" "$_val"
			return $?
			;;
		therm_en|therm_start|therm_stop|safe_en|safe_cap|cal_oc|log_en|soc_stop)
			_cfg_set "$_seg" "$_val"
			return $?
			;;
	esac

	case "$_seg" in
		low|mid|peak|mid2|low2) ;;
		*) echo "ERR: 段名必须是 low|mid|peak|mid2|low2（或对应的高级设置项）"; return 1 ;;
	esac

	local _cap
	_cap=$(cal_max)
	case "$_val" in
		''|*[!0-9]*) echo "ERR: 值必须是非负整数（收到 '$_val'）"; return 1 ;;
	esac
	if [ "$_val" -gt "$_cap" ]; then
		echo "ERR: 值 $_val 超过本机上限 $_cap mA"
		return 1
	fi

	load_profile
	case "$_seg" in
		low)  I_LOW=$_val  ;;
		mid)  I_MID=$_val  ;;
		peak) I_PEAK=$_val ;;
		mid2) I_MID2=$_val ;;
		low2) I_LOW2=$_val ;;
	esac

	save_profile || { echo "ERR: 写配置失败"; return 1; }

	echo "OK $_seg=$_val"
	return 0
}

# ---------------- 入口 ----------------
case "$1" in
	start)
		if daemon_running; then
			echo "已在运行 (pid $(cat "$PIDFILE"))"
			exit 0
		fi
		spawn_daemon
		echo "已启动 (pid $(cat "$PIDFILE"))"
		;;
	__daemon)

		loop
		;;
	__alive)

		daemon_running
		;;
	restore)
		# 一键恢复原厂 —— 照 120w 模块 restore_all() 的对称做法：
		#   「模块改过什么，就按同样的范围逐一还原」，不依赖可能缺失的
		#   原值备份，也不靠"强杀进程"这种会被看门狗撤销的手段。
		#
		# ★ 关键修复：必须把档位写成 3（原厂）。
		#   loop() 与 service.sh 都【只认这个开关】才会自我退出；
		#   不写的话看门狗每 15 秒就会把守护重新拉起来继续注入 ——
		#   用户看到的就是"点了恢复原厂却没有任何作用"。
		if write_profile 3; then
			ACTIVE=3
			log "一键恢复原厂：档位已切到原厂(3)，守护与看门狗都会停止干预"
		else
			echo "警告: 档位写盘失败，看门狗可能仍会保活（请到界面手动切到原厂档）"
		fi

		# ① 停守护：先发信号等它自己退，超时再兜底清扫，
		#    避免"刚恢复完又被重启的守护写回去"。
		P=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$P" ] && kill "$P" 2>/dev/null
		_w=0
		while [ "$_w" -lt 10 ]; do
			daemon_running || break
			sleep 1
			_w=$((_w + 1))
		done
		sweep_instances ""
		rm -f "$PIDFILE" "$CACHE_TMP" "$HIGHV_FLAG_FILE" 2>/dev/null
		# ★ v3533 修：不再 rm -f "$CACHE_FILE"。
		#   【为什么】status.json 是前端唯一的数据来源。删掉它之后前端
		#   readCache 读到空 → parseJsonOut 失败 → 走现场 getjson 直读；
		#   而 getjson 的 active 确实会是 3，看似无害。但实际有两处坑：
		#     a) 直读要走一次完整 ksu.exec（≈300~500ms），而恢复原厂这条
		#        命令本身就要 6~10 秒，两者叠加会更容易撞上 exec 超时；
		#     b) 文件不存在时 fastRead 返回 null，前端会多打一次 cat 兜底
		#        exec，等于一次刷新里有两次 fork。
		#   正确做法：留着文件并【立刻写入真值】，前端下一次轮询就拿到
		#   active=3 / running=false，既快又不会误判"读取失败"。
		# ★ v3524：只清运行期锁，保留 service 单实例锁
		rm -rf "$LOCKDIR/run" "$LOCKDIR/launch" 2>/dev/null

		# ② 判决层：解除 force（只写 force_active=0，绝不写 force_val=0）
		# ★★ v3565：restore 是"彻底交回"，必须扫全表 VOTE_TARGETS_KNOWN，
		#   把历史上任何一代模块可能留下的 force_active=1 都清干净。
		#   这与 do_once 里的常规 vot_release 不同 —— 那里只清自己写过的目标。
		VOT_SWEEP_ALL=1
		vot_release
		VOT_SWEEP_ALL=0

		# ③ sysfs 申请层：交回系统（天玑机唯一可用通道）
		rwhat=$(restore_to_system)

# ④ （v3562：防掉档已移除，无需还原属性/场景）

		# ⑤ 清状态标记与台账（顺序必须在还原之后，否则取不到原值）

		# ⑥ ★ v3533：主动重写 status.json 为真值。
		#   此时守护已死，文件不会再被更新；不写的话前端读到的还是
		#   恢复前那份（active=1 / running=true），界面把「原厂」刷回「激进」。
		local _ctr="${CACHE_FILE}.rs.$$"
		emit_json > "$_ctr" 2>/dev/null
		[ -s "$_ctr" ] && mv -f "$_ctr" "$CACHE_FILE" 2>/dev/null || rm -f "$_ctr" 2>/dev/null

		echo "已恢复原厂：档位=原厂(3) + 停守护 + 交回系统 + 撤掉全部压制"
		echo "方式: ${rwhat:-未知}"
		echo "当前节点值: $(cat "$NODE" 2>/dev/null)"
		echo "提示: 档位已停在原厂，重启后也不会再干预。"
		echo "      只想临时停手、之后还要接着用 -> 用 pause 而不是 restore。"
		;;
	pause)
		# 「临时解除加速」——照 120w 模块的 paused 机制。
		#   打标记后守护会在下一轮把干预全部撤掉并空转（进程不退出），
		#   拔掉标记立刻恢复。跨重启有效。
		#   与 restore 的区别：restore 是彻底停手（写 ACTIVE=3，不再自动回来）。
		printf '%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" > "$PAUSE_FLAG" 2>/dev/null || {
			echo "ERR: 无法写入暂停标记 $PAUSE_FLAG"
			exit 1
		}
		log "用户触发：临时解除加速（等待守护下一轮撤掉干预）"

		# 等守护把注入/属性/场景撤干净（最多 10 秒）
		_w=0
		# ★★ v3558：这里原来等的是 USER_IBAT，但注入通道早已改为 DCHG_FCC，
		#   该节点在本机根本不存在 -> cat 拿到空 -> 立刻 break -> 等于没等。
		#   改成读实际注入目标（VOTE_TARGETS 里的第一个），找不到就退化成不等待。
		_PT="$VOT_ROOT/${VOTE_TARGETS%% *}/force_active"
		while [ "$_w" -lt 10 ]; do
			_v=$(cat "$_PT" 2>/dev/null)
			case "$_v" in ''|1) ;; *) break ;; esac
			sleep 1
			_w=$((_w + 1))
		done
		if daemon_running; then
			echo "已临时解除加速：守护已撤掉干预并转入空转（进程保留，随时可恢复）"
		else
			echo "已临时解除加速：标记已写入（守护当前未运行；启动后会自动保持解除）"
		fi
		# ★★ v3558：立即刷新 status.json。守护的 refresh_cache 空闲态是 30 秒一次，
		#   不主动刷的话，WebUI 里 paused 会滞后 20~30 秒才变 true（实测）。
		refresh_cache >/dev/null 2>&1
		echo "恢复: $0 resume"
		;;
	resume)
		rm -f "$PAUSE_FLAG" 2>/dev/null
		log "用户触发：恢复加速（已清除临时解除标记）"
		# ★★ v3558：同 pause，立即刷新 status.json，否则 paused 会滞后 20~30 秒。
		refresh_cache >/dev/null 2>&1
		# 沿用统一的启动路径（含存活判定与实例清扫）
		if daemon_running; then
			echo "已恢复加速：守护仍在运行，下一轮（约 2 秒）即重新生效"
		else
			spawn_daemon
			echo "已恢复加速：守护已拉起"
		fi
		;;
	stop)

		if [ -f "$PIDFILE" ] || [ -d "$LOCKDIR/run" ] || [ -d "$LOCKDIR/launch" ]; then
			P=$(cat "$PIDFILE" 2>/dev/null)
			[ -n "$P" ] && kill "$P" 2>/dev/null
			sweep_instances ""
			rm -f "$PIDFILE"

			# ★ v3524 修复：不能 rm -rf 整个 LOCKDIR。
			#   原实现在这里把 $LOCKDIR 整个删掉，而 service.sh 的单实例锁
			#   就在 $LOCKDIR/service 下面 —— 于是每执行一次 stop，
			#   看门狗的单实例保护就被拆掉一次，下次重复启动时
			#   mkdir 又能成功，多实例重新叠加（就是之前抓到 10 个
			#   service.sh 并存的直接成因之一）。
			#   现在只清理运行期锁，保留 service 锁。
			rm -rf "$LOCKDIR/run" 2>/dev/null
			rm -rf "$LOCKDIR/launch" 2>/dev/null

			rm -f "$CACHE_FILE" "$CACHE_TMP" 2>/dev/null

			rm -f "$HIGHV_FLAG_FILE" 2>/dev/null
			# ★★ v3565：stop 是"彻底停手并交回"，扫全表清掉所有历史残留
			VOT_SWEEP_ALL=1
			rwhat=$(restore_to_system)
			VOT_SWEEP_ALL=0
			echo "已停止干预，交回系统。方式: ${rwhat:-未知}"
			echo "当前节点值: $(cat "$NODE" 2>/dev/null)"
			echo "提示: 节点是只进不出的，不显式交还的话会一直生效。"
		else

			echo "未在运行（仍执行一次交回，确保节点不残留干预值）"
			VOT_SWEEP_ALL=1
			rwhat=$(restore_to_system)
			VOT_SWEEP_ALL=0
			echo "交回系统。方式: ${rwhat:-未知}"
			echo "当前节点值: $(cat "$NODE" 2>/dev/null)"
		fi
		;;
	profile)

		case "$2" in
			get)
				load_profile
				echo "$ACTIVE"
				;;
			name)
				load_profile
				echo "$PROFILE_NAME"
				;;
			write)
				if write_profile "$3"; then
					load_profile
					echo "已切换到: $PROFILE_NAME 档"
					echo "配置文件: $PROFILE_FILE"
					echo "  I_LOW  = $I_LOW    (${SOC_MIN}~${SOC_T1}%)"
					echo "  I_MID  = $I_MID    (${SOC_T1}~${SOC_T2}%)"
					echo "  I_PEAK=$I_PEAK   (${SOC_T2}~${SOC_T3}%)"
					echo "  I_MID2=$I_MID2   (${SOC_T3}~${SOC_T4}%)"
					echo "  I_LOW2=$I_LOW2   (${SOC_T4}~${SOC_MAX}%)"

					if [ "$3" = "3" ]; then
						echo "守护进程已停止干预（交回系统自管）"
						echo "  节点复位方式: ${rwhat:-未知}"
						echo "  ★ 若显示「申请额度」字样，说明模块没拿到干预前的原值备份，"
						echo "    写回的是 DT 表的额度上限（合法但偏激进），不是出厂原值。"
					else
						# ★★ v3560 修复：切回 1/2 档时必须【主动拉起守护】★★
						# 【原缺陷（实测）】write_profile 只写文件，从不启动进程，
						#   却无条件打印「守护进程运行中，将在 2 秒内热重载」。
						#   而从原厂档(3)切回来时，守护早已 exit 0、service.sh 也
						#   一起退出了 —— 此刻系统里没有任何人会拉起它。
						#   用户看到的现象：点了「激进」，档位显示对了，但模块完全不工作，
						#   要等 KernelSU 偶然重启 service.sh 才恢复（实测等 25 秒以上，且不保证发生）。
						# 【修法】原地拉起。spawn_daemon 内部有 launch 锁 + sweep_instances，
						#   service.sh 也有 mkdir 单实例锁，重复调用是安全的。
						# 【核对结果】write_profile 内部【已有】spawn_daemon（见 3397 行），
						#   所以这一步通常已经为真。这里只是把结论如实报出来，
						#   不再像旧版那样无条件打印"将在 2 秒内热重载"。
						if daemon_running; then
							echo "守护进程运行中，将在 2 秒内热重载（PID 不变）"
						else
							echo "警告: 守护进程未能拉起，请把本条输出反馈到模块发布页"
							echo "  可手动执行: $0 start"
						fi
						
						# ★★ v3560 修复：切回 1/2 档时【叫醒看门狗】★★
						# 【原缺陷（实测）】从原厂档(3)切走后，service.sh 早已执行
						#   "档位=原厂(3)，跳过启动守护进程" 并 exit 0 —— 看门狗没了。
						#   write_profile 虽然会 spawn_daemon 一次，但那是【一次性】的：
						#     守护之后若因任何原因退出（协议等待异常、被系统杀、脚本报错），
						#   就没有任何人再把它拉起来，模块就此永久静默。
						#   用户看到的现象：切了激进、档位显示对，但模块一直不工作，
						#   且重启前怎么切都救不回来。
						# 【修法】这里判断 service.sh 是否在跑，不在就跑起来。
						#   service.sh 开头有 mkdir 原子单实例锁（见其 take_svc_lock），
						#   重复调用时会自己判重退出，所以无条件调用是安全的。
						# 注意：这里在 case 分支内、不在任何函数里，不能用 local。
						_wd=""; _mod=""; _alive=""
						for _wp in /proc/[0-9]*; do
								case "$(tr '\0' ' ' < "$_wp/cmdline" 2>/dev/null)" in
									*service.sh*) _alive=1; break ;;
								esac
							done
							if [ -z "$_alive" ]; then
								_mod=$(cd "${0%/*}/../.." 2>/dev/null && pwd)
								_wd="$_mod/service.sh"
								[ -f "$_wd" ] || _wd="${0%/*}/service.sh"
								if [ -f "$_wd" ]; then
									nohup /system/bin/sh "$_wd" >/dev/null 2>&1 &
									echo "已唤醒看门狗（service.sh），后续守护异常退出会自动保活"
								fi
							fi
					fi
				else
					echo "用法: $0 profile write 1|2|3"
					exit 1
				fi
				;;
			*)
				load_profile
				echo "=== 档位状态 ==="
				echo "配置文件: $PROFILE_FILE"
				if [ -f "$PROFILE_FILE" ]; then
					echo "           (存在)"
				else
					echo "           (不存在，使用内置默认)"
				fi
				echo "当前档位: $ACTIVE ($PROFILE_NAME)"
				echo ""
				echo "SOC 段        申请值      说明"
				echo "  ${SOC_MIN}~${SOC_T1}%    $I_LOW mA   低 SOC 段"
				echo "  ${SOC_T1}~${SOC_T2}%    $I_MID mA"
				echo "  ${SOC_T2}~${SOC_T3}%    $I_PEAK mA"
				echo "  ${SOC_T3}~${SOC_T4}%    $I_MID2 mA"
				echo "  ${SOC_T4}~${SOC_MAX}%    $I_LOW2 mA"
				echo ""
				echo "可用档位:"
				echo "  1 = 激进档（正常写入，档内不预降）"
				echo "  2 = 温和档（同样申请 ${I_LOW}mA，热保护更保守）"
				echo "  3 = 原厂档（停止干预，交还系统自管）"
				echo ""
				echo "切换: $0 profile write 1|2|3"
				;;
		esac
		;;
	status)
		echo "=== vivo 充电加速模块 v3.5.11 ==="
		load_profile
		SOC=$(read_soc); TEMP=$(read_temp); V=$(read_vbat); I=$(read_ibat "$V")
		TBD=$(read_temp_desc)
		echo "控制节点: $NODE"
		echo "当前档位: $ACTIVE ($PROFILE_NAME)"
		echo "SOC     : ${SOC}%"
		echo "温度    : ${TBD}"
		echo "          热保护输入=min(板级,电池) 档位判定用两路各自查表取更保守"
		echo "热保护  : 板级 预警$(f10 $TB_WARN) 降A$(f10 $TB_CAP_A)(≤${CAP_A}) 降B$(f10 $TB_CAP_B)(≤${CAP_B}) 撒手$(f10 $TB_RELEASE)"
		echo "          电池 预警$(f10 $TC_WARN) 降A$(f10 $TC_CAP_A)(≤${CAP_A}) 降B$(f10 $TC_CAP_B)(≤${CAP_B}) 撒手$(f10 $TC_RELEASE)"
		echo "          恢复 板级≤$(f10 $TB_RECOVER)/电池≤$(f10 $TC_RECOVER) 持续 ${TEMP_RECOVER_SEC}s，温度取 ${TEMP_HIST_N} 点中位"

		case "$I" in
			-*) echo "电池电流: +${I#-} uA（正=充电 负=放电）" ;;
			''|*[!0-9]*) echo "电池电流: 读取失败" ;;
			0) echo "电池电流: 0 uA" ;;
			*) echo "电池电流: -${I} uA（正=充电 负=放电）" ;;
		esac
		echo "电池电压: ${V} uV"
		_pw=$(read_input_power)
		if [ -n "$_pw" ]; then
			set -- $_pw

			echo "输入电压: ${1} mV"
			echo "输入电流: ${2} mA"
			echo "输入功率: $(( $3 / 1000 )).$(( ($3 % 1000) / 100 )) W   <-- 模块是否生效看这里"
		fi
		echo "节点当前: $(cat "$NODE" 2>/dev/null)"
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "运行状态: 运行中 (pid $(cat "$PIDFILE"))"
		else
			echo "运行状态: 未运行"
		fi
		;;
	power)

		echo "采样 12 次（每次 2 秒），观察功率:"
		i=1
		while [ $i -le 12 ]; do
			_pw=$(read_input_power)
			if [ -n "$_pw" ]; then
				set -- $_pw
				printf "  [%2d] %d mV x %d mA = %d.%d W  (节点=%s)\n" \
					"$i" "$(( $1 / 1000 ))" "$(( $2 / 1000 ))" "$(( $3 / 1000 ))" "$(( ($3 % 1000) / 100 ))" "$(cat "$NODE" 2>/dev/null)"
			else
				printf "  [%2d] 读不到功率\n" "$i"
			fi
			i=$((i + 1))
			sleep 2
		done
		;;
	once)
		do_once
		_rc=$?
		fmt_state "$_rc"
		echo "rc=$_rc"
		;;
	table)
		load_profile
		echo "控制节点: $NODE"
		echo "          (vfcs_class/fchg_fcc_ma —— vivo 快充正式接口)"

		_tsrc=$(read_temp_source)
		echo "温度源  : $(_tname_of "$_tsrc") + 电池 battery/temp"
		echo "          两路各自查表，取更保守的档位（谁先报警听谁的）"
		echo "当前档位: $ACTIVE ($PROFILE_NAME)"
		echo ""
		echo "SOC 加速表 (板级温度 ${TEMP_MIN}/10~$((${TEMP_RELEASE}/10)).$((TEMP_RELEASE%10))C 生效, 纯 SOC 决策):"
		echo "  SOC 段        申请值      实测功率（按工况）"
		printf "  %-12s  %-9s  按本段申请值\n" \
			"${SOC_MIN}~${SOC_T1}%" "$I_LOW"
		printf "  %-12s  %-9s  实际功率由系统裁定\n" \
			"${SOC_T1}~${SOC_T2}%" "$I_MID"
		printf "  %-12s  %-9s\n" "${SOC_T2}~${SOC_T3}%" "$I_PEAK"
		printf "  %-12s  %-9s\n" "${SOC_T3}~${SOC_T4}%" "$I_MID2"
		printf "  %-12s  %-9s\n" "${SOC_T4}~${SOC_MAX}%" "$I_LOW2"
		printf "  %-12s  %-9s\n" "${SOC_MAX}%以上" "不动（交回系统）"
		echo ""
		echo "热保护阶梯（两路独立，取更保守的档位）："
		echo "  档位      板级温度     电池温度     动作"
		printf "  正常      < %sC     < %sC    按上表申请\n" "$(f10 "$TB_WARN")" "$(f10 "$TC_WARN")"
		printf "  预警     >= %sC    >= %sC    SOC 表退一档\n" "$(f10 "$TB_WARN")" "$(f10 "$TC_WARN")"
		printf "  降档A    >= %sC    >= %sC    封顶 %d\n" "$(f10 "$TB_CAP_A")" "$(f10 "$TC_CAP_A")" "$CAP_A"
		printf "  降档B    >= %sC    >= %sC    封顶 %d\n" "$(f10 "$TB_CAP_B")" "$(f10 "$TC_CAP_B")" "$CAP_B"
		printf "  撒手     >= %sC    >= %sC    停止写节点，交回系统\n" "$(f10 "$TB_RELEASE")" "$(f10 "$TC_RELEASE")"
		printf "  恢复     <= %sC    <= %sC    两路都满足且持续 %d 秒\n" "$(f10 "$TB_RECOVER")" "$(f10 "$TC_RECOVER")" "$TEMP_RECOVER_SEC"
		echo ""
		echo "  板级：防内核在 80.0C 硬切快充（触到即 fchg_disable，功率断崖）"
		echo "  电池：防电芯本身过热（析锂/鼓包）"
		echo ""
		echo "=== 档位说明 ==="
		echo "  激进/温和/原厂 三档的电流值相同（统一 ${I_LOW}mA），"
		echo "  区别在于是否干预与写入时机；原厂档停止干预、交还系统自管。"
		echo ""
		echo "★ 热保护状态机 (v2.8 双源) ★"
		echo "  两路温度各自查表，取更保守的档位："
		echo "  档位      板级温度    电池温度    动作"
		echo "  正常      <65.0C     <40.5C     按 SOC 表申请"
		echo "  预警      65~70C     40.5~41C   SOC 表整体退一档"
		echo "  降档A     ≥70.0C     ≥41.0C     封顶 ${CAP_A}"
		echo "  降档B     ≥75.0C     ≥42.0C     封顶 ${CAP_B}"
		echo "  撒手      ≥79.0C     ≥43.0C     停止写节点，交回系统"
		echo "  恢复      ≤60.0C     ≤39.0C     两路都满足持续 ${TEMP_RECOVER_SEC}s"
		echo ""
		echo "  运行时读数: $(read_temp_desc)"
		echo "  板级硬门限: 80.0C（内核 fchg_disable，功率断崖，非协商）"
		echo ""
		echo "  规则: 实际写入 = min(温度处理后的值, 温度封顶值)"
		echo "        → 温度只允许让申请值变小，绝不因温度而升档"
		echo ""
		echo "  防抖: 温度取近 ${TEMP_HIST_N} 次中位数（抗 ±0.6C 毛刺）"
		echo "        恢复需 ≤60.0C 且持续 ${TEMP_RECOVER_SEC}s（防边界开合）"
		echo ""
		echo "  切换方式: KernelSU 里按 Action 按钮，用音量键选择"
		echo "            或执行 $0 profile write 1|2|3"
		echo ""
		echo "★★ 为什么按 SOC 段取不同值 ★★"
		echo "  同一节点值，功率随 SOC 变化 13W 以上："
		echo "    11720 -> SOC50% 时 52W / SOC65% 时 39W"
		echo "  fchg_fcc_ma 是【申请额度】，最终给多少由 SOC 二次裁定。"
		echo "  SOC 越低，系统越愿意接受大额度。"
		echo ""
		echo "★ 实测响应曲线（2026-09-26 复测，SOC 40~46%）:"
		echo "    节点=0     -> 13W   (灾难，等同不充电)"
		echo "    节点=3000  -> 13W   (死区)"
		echo "    节点=4765  -> 18.5W"
		echo "    节点=5765  -> 22.8W"
		echo "    节点=7720  -> 31.5W"
		echo "    节点=9720  -> 40.7W (效率最高档 96.2%)"
		echo "    节点=11720 -> 46.4W <-- 此段峰值"
		echo "    节点=15600 -> 41.1W (申请超额但被系统二次裁定)"
		echo ""
		echo "  ★ 关键发现：功率在 SOC 40~46% 段由 SOC 主导，"
		echo "    节点申请值只在【电流台阶】之间跳跃："
		echo "      4765 / 5765 / 7720 / 9720 / 11720 / 15600 mA"
		echo "    所以封顶值要选在台阶上，落在台阶之间等于没降。"
		echo ""
		echo "电压: 不参与决策, 完全交给系统/IC 自管"
		echo "      实测电压随节点值变动 8.5V -> 9.5V，上限 9.5V"
		echo ""
		echo "限制: 本机 90W 需 11V x 8.2A，但档位只到 9.5V，"
		echo "      故 90W 拿不到。9V 档实测 20W(保底)~53W(低SOC)。"
		;;
	factory)

		case "$2" in
			raw)

				echo "=== DT 节点（v3.0 跨平台探测）==="
				dt_probe $(read_aging_stage) >/dev/null 2>&1
				_pv_ok=0
				[ -n "$DT_TC_NODE" ] && [ -r "$DT_TC_NODE" ] && _pv_ok=1
				echo "平台判定:      ${DT_PLATFORM:-未探测}"
				echo "命中方式:      ${DT_PROBE_HOW:-（无）}"
				echo "老化档:        $(read_aging_stage)"
				echo "路径:          ${DT_TC_NODE:-（探测失败）}"
				if [ "$_pv_ok" = "1" ]; then
					echo "电压单位:      $(dt_detect_unit "$DT_TC_NODE")"
					echo "分段边界(自动): $(dt_auto_segs "$DT_TC_NODE" 2>/dev/null || echo '（失败，用兜底）')"
				fi
				echo ""
				if [ "$_pv_ok" = "1" ]; then
					echo "可读: 是"
					echo "大小: $(wc -c < "$DT_TC_NODE" 2>/dev/null) 字节"
					echo ""

					_n=$(wc -c < "$DT_TC_NODE" 2>/dev/null)
					case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
					_uc=$((_n / 4))
					echo "=== 全部 $_uc 个 uint32 (big-endian) ==="
					i=0
					while [ "$i" -lt "$_uc" ]; do
						printf "  [%3d] %s\n" "$i" "$(dt_u32_at "$DT_TC_NODE" "$i")"
						i=$((i + 1))
					done
					echo ""
					echo "=== 档位解析（表头 11 起，每 11 个一档）==="
					i=$DT_HDR_LEN
					_rn=0
					while [ "$i" -lt "$_uc" ]; do
						_lo=$(dt_u32_at "$DT_TC_NODE" "$i")
						_hi=$(dt_u32_at "$DT_TC_NODE" $((i + 1)))
						[ "$_lo" = "$DT_MAGIC" ] && {
							echo "  档$((_rn+1)): idx $_i 哨兵档 [0xFFFFDD48]"
							break
						}
						if dt_is_soc_bound "$_lo" "$_hi"; then
							printf "  档%d: idx %3d  SOC %s-%s  I1=%s V1=%s\n" \
								"$((_rn+1))" "$i" "$_lo" "$_hi" \
								"$(dt_u32_at "$DT_TC_NODE" $((i + 2)))" \
								"$(dt_u32_at "$DT_TC_NODE" $((i + 3)))"
							_rn=$((_rn + 1))
						else
							printf "  档%d: idx %3d  (%s,%s) 不是白名单边界\n" \
								"$((_rn+1))" "$i" "$_lo" "$_hi"
						fi
						i=$((i + DT_HDR_LEN))
					done
					echo "  => 解析出 $_rn 个合法 SOC 档（判据要求 >= $DT_MIN_ROWS）"
					echo ""
					echo "SOC 200~249 档 (白名单定位，5 段 I/V):"
					i=0
					while [ "$i" -lt 5 ]; do
						printf "  段%d: I=%s(raw)  V=%s(raw)\n" "$((i + 1))" \
							"$(dt_seg_field "$DT_TC_NODE" 200 $((i * 2)))" \
							"$(dt_seg_field "$DT_TC_NODE" 200 $((i * 2 + 1)))"
						i=$((i + 1))
					done
					echo ""
					echo "★ 建议恢复值: $(dt_restore_value $(read_aging_stage))"
				else
					echo "可读: 否"
					echo ""
					echo "排查提示："
					echo "  1) 候选目录是否存在："
					for _d in $(dt_candidate_dirs); do
						[ -d "$_d" ] && echo "       [有] $_d" || echo "       [无] $_d"
					done
					echo "  2) 目录里实际有哪些表："
					for _d in $(dt_candidate_dirs); do
						[ -d "$_d" ] || continue
						ls "$_d" 2>/dev/null | grep -i tc-data | head -20 | \
							sed "s|^|       |"
					done
				fi
				;;
			*)
				echo "=== 原厂档来源（v3.2.8: 原值备份优先，DT 表为次选）==="
				echo "平台判定:      ${DT_PLATFORM:-未探测}"
				echo "老化档:        $(read_aging_stage)"

				_orig=$(read_original)
				if [ -n "$_orig" ]; then
					echo "原值备份:      有 -> ${_orig} mA  ($ORIG_FILE)"
					echo "               ★ 切原厂档时将写回此值（这才是出厂原值）"
				else
					echo "原值备份:      无"
					echo "               ⚠ 模块启动时没来得及备份节点原值，"
					echo "                 切原厂档只能退回 DT 表【申请额度】。"
				fi
				echo ""
				DT_PROBED=""; DT_TABLE_STATE=""; DT_TABLE=""
				if dt_ensure 2>/dev/null; then
					echo "表路径:        $DT_TC_NODE"
					echo "电压单位:      $(dt_detect_unit "$DT_TC_NODE")"
					echo "分段边界:      ${BASELINE_SEGS_AUTO:-未读取}"
					case "$DT_PROBE_HOW" in
						exact)
							echo "命中方式:      精确命中本老化档" ;;
						fallback0)
							echo "命中方式:      ⚠ 退回未老化档(-0)"
							echo "              （本老化档的表在本机不存在，恢复值为未老化口径）" ;;
						scanall)
							echo "命中方式:      ⚠ 全盘搜到（非标准路径）" ;;
						*)
							echo "命中方式:      ${DT_PROBE_HOW:-未知}" ;;
					esac
					echo ""
					echo "读取状态: 成功"
					echo ""
					echo "★ 下表是【申请额度】，不是原厂实际电流。"
					echo "  fchg_fcc_ma 只负责申请，最终给多少由 SOC/温度二次裁定。"
					echo ""
					echo "vbat 区间(mV)      段名    额度(mA)"
					for e in $DT_TABLE; do
						name=${e%%=*}; body=${e#*=}
						icur=${body%%:*}; ivol=${body##*:}
						printf "  %-18s %-6s  %s\n" ">=$ivol" "$name" "$icur"
					done
					echo ""
					echo "全局上限(vfcs/fchg-curr-max-ma): $(dt_cur_max) mA"
					echo "（所有取值都会被钳制到此上限）"
					echo "★ DT 额度参考值(老化档 $(read_aging_stage)): $(dt_restore_value $(read_aging_stage))"
					echo "★ 本机兜底常量 restore_ma: $(restore_ma)"
				else
					echo "读取状态: 失败"
					echo "原厂档将退回: ORIG_FILE(节点原值) -> restore_ma($(restore_ma))"
				fi
				echo ""
				echo "用法: $0 factory [raw]"
				;;
		esac
		;;
	getjson)

		load_profile >/dev/null 2>&1
		emit_json
		;;
	setcal)
		# 批量模式：setcal k1 v1 k2 v2 ... （一次进程写完所有键）
		# 旧写法 setcal k v 仍然可用（只有一个键时行为一致）。
		# 前端保存多个参数时用批量，把 N 次 fork 压成 1 次，消除"保存时卡一下"。
		if [ $# -lt 4 ]; then
			set_cal "$2" "$3" || exit 1
		else
			# 剥掉首参 "setcal"，只把 k1 v1 k2 v2 ... 交给批量处理
			shift
			_cal_batch "$@"
		fi
		;;
	setoc)
		# ============================================================
		#  ★ v3516：超频档开关 —— 彻底重做的单一入口
		# ------------------------------------------------------------
		#  【上一版为什么混乱】
		#    v3515e 在脚本顶部塞了一个「前置快速分支」，它自己内联算一遍上限、
		#    自己改 profile、然后 exit。问题在于：
		#      · 它绕开了 load_profile，所以 cal_max 的缓存 / 段位默认 /
		#        IBAT_VER 迁移全都没被正确刷新；
		#      · 守护进程下一轮 load_profile 会按【它自己那套】重算并落盘，
		#        于是用户刚设的值被覆盖 —— 这就是"设好会自动弹回"。
		#      · 两条路径各自维护一份「只同步等于旧上限的项」逻辑，
		#        改一处忘一处，行为必然漂移。
		#
		#  【现在的做法：只留一条路径】
		#    1) 先校验并写入 CAL_OC 到内存 + profile；
		#    2) cal_max_refresh 让 cal_max() 立刻吐新值；
		#    3) 调 load_profile 走完整重载（含 IBAT_VER 迁移、段位钳制、落盘）；
		#    4) load_profile 内部已保证「先读 CAL_OC → 再算上限 → 再钳段位」，
		#       所以它算出来的结果和 cal_max() 永远一致，不会互相对打。
		#    代价是比 v3515e 的野路子慢一点（约 400ms），但换来的是
		#    「点完之后值不会自己变回去」—— 这才是用户真正在意的。
		# ============================================================
		case "$2" in
			0|1) ;;
			*) echo "ERR: 超频档开关只能是 0（关）或 1（开）"; exit 1 ;;
		esac

		load_profile           # 先把当前配置完整载入（含 CAL_OC）
		_oldcap=$(cal_max 2>/dev/null)
		case "$_oldcap" in ''|*[!0-9]*) _oldcap=0 ;; esac

		CAL_OC="$2"
		cal_max_refresh        # 让 cal_max() 立刻反映新开关

		_newcap=$(cal_max 2>/dev/null)
		case "$_newcap" in ''|*[!0-9]*) _newcap=0 ;; esac

		# 段位/总闸同步：只动「恰好等于旧上限」的项。
		#   —— 这些是跟着上限自动铺的值，不是用户手选的。
		#   用户设过更低值（如 9000）的一律保留，这是本功能的核心承诺。
		if [ "$_oldcap" -gt 0 ] && [ "$_newcap" -gt 0 ] && \
		   [ "$_oldcap" != "$_newcap" ]; then
			[ "$I_LOW"  = "$_oldcap" ] && I_LOW="$_newcap"
			[ "$I_MID"  = "$_oldcap" ] && I_MID="$_newcap"
			[ "$I_PEAK" = "$_oldcap" ] && I_PEAK="$_newcap"
			[ "$I_MID2" = "$_oldcap" ] && I_MID2="$_newcap"
			[ "$I_LOW2" = "$_oldcap" ] && I_LOW2="$_newcap"
			[ "$VOTE_IBAT" = "$_oldcap" ] && VOTE_IBAT="$_newcap"
			# 关超频时把越界值压回新上限，避免 profile 留脏值
			[ "$I_LOW"  -gt "$_newcap" ] && I_LOW="$_newcap"
			[ "$I_MID"  -gt "$_newcap" ] && I_MID="$_newcap"
			[ "$I_PEAK" -gt "$_newcap" ] && I_PEAK="$_newcap"
			[ "$I_MID2" -gt "$_newcap" ] && I_MID2="$_newcap"
			[ "$I_LOW2" -gt "$_newcap" ] && I_LOW2="$_newcap"
			[ "$VOTE_IBAT" -gt "$_newcap" ] && VOTE_IBAT="$_newcap"
		fi

		# 落盘：走 save_profile（它写全量字段，含 CAL_OC / I_* / VOTE_IBAT）
		save_profile || { echo "ERR: 写配置失败"; exit 1; }

		log "超频档 CAL_OC=$CAL_OC：上限 ${_oldcap} -> ${_newcap} mA，段位已同步"

		# 输出新状态，前端可直接用于点亮界面，不必再等一次 getjson
		# ★ v3518：直接把新值写进 status.json，消除「弹回」的观感
		#
		#   【为什么必须这么做】
		#     status.json 是守护进程每轮写出的快照，前端轮询读的就是它。
		#     守护进程在【充电时】一轮可能要 5~15 秒（协议等待 + sleep 5），
		#     在这段时间里 status.json 还是旧值。
		#     用户点完开关：
		#       · 前端本地推断 → 先显示新值（看起来对了）
		#       · 但 2 秒后轮询读到 status.json 的【旧值】→ 又变回去
		#       · 再等 5~15 秒，守护终于跑完一轮 → 才稳定在新值
		#     用户看到的就是「点了会弹回，过一会又好了」。
		#
		#   【修法】setoc 落盘后，顺手把 status.json 里跟上限相关的
		#     几个字段就地改掉（用同样的键名与类型）。
		#     守护进程下一轮会用真实值覆盖，但这中间前端读到的已经是新值，
		#     视觉上就是「点完立刻稳定」。
		#     只改 calOc / calMax / calDt / calAbsHard / calOcMax 五个字段，
		#     其余字段原样保留，不破坏 JSON 结构。
		_upd_cache() {
			[ -f "$CACHE_FILE" ] || return 0
			local _dtt _tmpc
			_dtt=$(cal_dt_max 2>/dev/null)
			case "$_dtt" in ''|*[!0-9]*) _dtt="";; esac
			_tmpc="${CACHE_FILE}.setoc.$$"
			# 用 sed 逐字段替换，避免整个 JSON 重新生成（会丢字段/改顺序）
			sed -e "s/\"calOc\":[0-9]*/\"calOc\":$CAL_OC/" \
			    -e "s/\"calMax\":[0-9]*/\"calMax\":$_newcap/" \
			    -e "s/\"calOcMax\":[0-9]*/\"calOcMax\":$CAL_OC_MAX/" \
			    "$CACHE_FILE" > "$_tmpc" 2>/dev/null
			# calDt 允许为 null，单独处理
			if [ -n "$_dtt" ]; then
				sed -i "s/\"calDt\":[^,]*/\"calDt\":$_dtt/" "$_tmpc" 2>/dev/null
			fi
			# 文件非空才替换，避免 sed 失败把缓存清空
			if [ -s "$_tmpc" ]; then
				mv -f "$_tmpc" "$CACHE_FILE" 2>/dev/null || rm -f "$_tmpc" 2>/dev/null
			else
				rm -f "$_tmpc" 2>/dev/null
			fi
		}
		_upd_cache

		echo "OK cal_oc=$CAL_OC cap=$_newcap dt=$(cal_dt_max 2>/dev/null)"
		;;
	cells)

		echo "电芯数: $(read_cells)"
		echo "  battery/voltage_now = $(cat /sys/class/power_supply/battery/voltage_now 2>/dev/null)"
		echo "  cms_class/cell1_voltage = $(cat /sys/class/cms_class/cell1_voltage 2>/dev/null)"
		echo "  cms_class/cell2_voltage = $(cat /sys/class/cms_class/cell2_voltage 2>/dev/null)"
		echo "  read_vbat (总压 mV) = $(read_vbat)"
		_c=$(read_cells)
		_v=$(read_vbat)
		if [ -n "$_v" ] && [ "$_c" -gt 0 ]; then
			echo "  单芯显示值 (mV) = $((_v / _c))"
		fi
		;;
	votset)
		# 手动钉住注入目标：votset DCHG_FCC / votset auto
		case "$2" in
			'')
				if [ -s "$VOT_PIN_FILE" ]; then
					echo "当前钉住目标: $(cat "$VOT_PIN_FILE" 2>/dev/null)"
				else
					echo "当前为自适应（未钉住）"
				fi
				echo "用法: $0 votset {auto|目标名}    （目标名用 votdiag 查）"
				;;
			auto|AUTO)
				rm -f "$VOT_PIN_FILE" 2>/dev/null
				echo "已清除钉住，恢复自适应选择"
				;;
			*)
				[ -d "$VOT_ROOT" ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
				if [ ! -d "$VOT_ROOT/$2" ]; then
					echo "ERR: $VOT_ROOT/$2 不存在，请先用 votdiag 查看本机可用目标"
					exit 1
				fi
				printf '%s' "$2" > "$VOT_PIN_FILE" 2>/dev/null || {
					echo "ERR: 写 $VOT_PIN_FILE 失败"
					exit 1
				}
				echo "已钉住注入目标: $2"
				echo "重启守护后生效: $0 stop; $0 start"
				;;
		esac
		;;
	votdiag)
		# 只读诊断：判断「往哪些节点写 force_val 才真的有用」。
		# 不写任何节点。用法: sh /system/bin/vfcs_boost votdiag
		[ -d "$VOT_ROOT" ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
		echo "=== PMIC 判决层（注入通道）诊断 ==="
		echo "机型: $(getprop ro.product.vendor.model 2>/dev/null)  平台: $(getprop ro.board.platform 2>/dev/null)"
		echo "根目录: $VOT_ROOT"
		if [ ! -d "$VOT_ROOT" ]; then
			echo "结果: 不存在 —— 本机无该通道（架构差异），会交回系统控制"
			exit 0
		fi
		echo "默认目标: $VOTE_TARGETS"
		vot_resolve_targets
		echo "自动选中: ${VOTE_TARGETS:-（无）}   [${VOT_SEL_WHY:-未解析}]"
		echo ""
		echo "--- 全部目标 ---"
		for _d in "$VOT_ROOT"/*; do
			[ -d "$_d" ] || continue
			_n=${_d##*/}
			_fa=$(cat "$_d/force_active" 2>/dev/null)
			_fv=$(cat "$_d/force_val" 2>/dev/null)
			echo "[$_n] force_active=${_fa:-?} force_val=${_fv:-?}"
			_st=$(cat "$_d/status" 2>/dev/null)
			if [ -n "$_st" ]; then
				case "$_st" in
					*en=1*) _lv="有 en=1 <-- 有人在投票，写它有希望生效" ;;
					*)      _lv="全部 en=0 <-- 无人投票，写它【不产生效果】" ;;
				esac
				echo "    $_lv"
				printf '%s\n' "$_st" | head -6 | sed 's/^/      /'
			else
				echo "    （无 status 文件）"
			fi
		done
		echo ""
		echo "★ 只有「自动选中」的目标会被写入。"
		echo "  · 若选中目标显示有人投票 -> 通道正常，电流应能跟着配置变"
		echo "  · 若选中目标显示无人投票 -> 请把本段输出反馈到模块发布页；"
		echo "    也可用 $0 votset <目标名> 手动钉住某个目标试一下"
		;;
	health)
		# ============================================================
		#  ★ v3570：一键健康检查（WebUI「检测运行占用」按钮调用）★
		# ------------------------------------------------------------
		#  目的：用户点一下就知道模块当前是否正常；异常时把输出贴给开发者。
		#  只读：不写任何节点、不改任何配置、不启停守护。
		#
		#  【为什么必须在模块里测，不能交给 WebUI 算】
		#    WebUI 每次 exec 都是全新进程，拿不到守护进程的累计 CPU。
		#    这里读 /proc/<pid>/stat 的 utime+stime+cutime+cstime，
		#    才是守护（含它 fork 出去的子进程）的真实总消耗。
		# ============================================================
		load_profile >/dev/null 2>&1

		_dp=$(cat "$PIDFILE" 2>/dev/null)
		_sp=$(pgrep -f "charge_boost/service.sh" 2>/dev/null | head -1)
		_dh=""
		_sh=""

		echo "HEALTH_BEGIN"

		# ---- 1. 进程存活 ----
		if [ -n "$_dp" ] && [ -d "/proc/$_dp" ]; then
			_dh="ok"
			echo "daemon_alive=1"
			echo "daemon_pid=$_dp"
		else
			_dh="dead"
			echo "daemon_alive=0"
			echo "daemon_pid="
		fi
		if [ -n "$_sp" ] && [ -d "/proc/$_sp" ]; then
			_sh="ok"
			echo "watchdog_alive=1"
			echo "watchdog_pid=$_sp"
		else
			_sh="dead"
			echo "watchdog_alive=0"
			echo "watchdog_pid="
		fi

		# ---- 2. 心跳新鲜度 ----
		_now=$(date +%s)
		_beat=$(stat -c %Y "$HEARTBEAT_FILE" 2>/dev/null)
		case "$_beat" in ''|*[!0-9]*) _beat=0 ;; esac
		if [ "$_beat" -gt 0 ]; then
			_beat_age=$((_now - _beat))
		else
			_beat_age=-1
		fi
		echo "heartbeat_age=$_beat_age"

		# ---- 3. 实测 CPU（采样 10 秒，jiffies 精确算）----
		#   ★ v3578：单位口径统一为【百分比 × 10000】，全模块只此一种。
		# ----------------------------------------------------------
		#   【旧公式的 100 倍误差】
		#     旧：_dpct = Δjiffies * 1000000 / _dt / 100
		#     正确推导：Δj*10ms ÷ (_dt*10ms) = 占空分数
		#               分数 × 100 = 百分比
		#               百分比 × 10000 = Δj * 1000000 / _dt
		#     旧代码多除了一个 100 —— 实测 27 jiffies / 10.16s 真实是
		#     2.657%，界面却显示 0.027%，比真实值低 100 倍。
		#     这直接导致「检测运行占用」把一个真在跑 2.6% 的守护报成 0.03%，
		#     任何阈值告警都永远不会触发 —— 属于必须删掉的无效数据。
		# ----------------------------------------------------------
		#   【无效值统一约定】读不到 / 不可能 / 溢出，一律输出 -1，
		#     前端据此显示「—」，绝不把 0 或负数当真实测量值画出来。
		echo "health_schema=2"
		echo "cpu_unit=pct_x10000"
		if [ "$_dh" = "ok" ] || [ "$_sh" = "ok" ]; then
			_d0=0; _s0=0
			[ "$_dh" = "ok" ] && _d0=$(awk '{print $14+$15+$16+$17}' "/proc/$_dp/stat" 2>/dev/null || echo 0)
			[ "$_sh" = "ok" ] && _s0=$(awk '{print $14+$15+$16+$17}' "/proc/$_sp/stat" 2>/dev/null || echo 0)
			_t0=$(awk '{printf "%d", $1*100}' /proc/uptime)
			sleep 10
			_d1=$_d0; _s1=$_s0
			[ "$_dh" = "ok" ] && _d1=$(awk '{print $14+$15+$16+$17}' "/proc/$_dp/stat" 2>/dev/null || echo $_d0)
			[ "$_sh" = "ok" ] && _s1=$(awk '{print $14+$15+$16+$17}' "/proc/$_sp/stat" 2>/dev/null || echo $_s0)
			_t1=$(awk '{printf "%d", $1*100}' /proc/uptime)
			_dt=$((_t1 - _t0))
			[ "$_dt" -le 0 ] && _dt=1

			_dj=$(( _d1 - _d0 ))
			_sj=$(( _s1 - _s0 ))
			# 百分比 × 10000 = Δj * 1000000 / _dt（_dt 为厘秒，等价于 ×10ms）
			_dpct=$(( _dj * 1000000 / _dt ))
			_spct=$(( _sj * 1000000 / _dt ))
			# 合理性钳制：读数异常（负数 / >100% / 非数字）判无效
			case "$_dpct" in ''|*[!0-9]*) _dpct=-1 ;; esac
			case "$_spct" in ''|*[!0-9]*) _spct=-1 ;; esac
			[ "$_dpct" -gt 1000000 ] 2>/dev/null && _dpct=-1
			[ "$_spct" -gt 1000000 ] 2>/dev/null && _spct=-1

			echo "cpu_daemon_x10000=$_dpct"
			echo "cpu_watchdog_x10000=$_spct"
			if [ "$_dpct" -ge 0 ] && [ "$_spct" -ge 0 ]; then
				echo "cpu_total_x10000=$(( _dpct + _spct ))"
			else
				echo "cpu_total_x10000=-1"
			fi
			echo "cpu_daemon_jiffies=$_dj"
			echo "cpu_watchdog_jiffies=$_sj"
			echo "cpu_window_ms=$(( _dt * 10 ))"
			# 窗口内 jiffies 增量为 0 = 这段时间模块没干活（20s 轮询周期的正常现象），
			# 不是「占用 0.000%」。单独给一个标志，前端据此写「本窗口无活动」。
			if [ "$_dj" -eq 0 ] && [ "$_sj" -eq 0 ]; then
				echo "cpu_instant_active=0"
			else
				echo "cpu_instant_active=1"
			fi
		else
			echo "cpu_daemon_x10000=-1"
			echo "cpu_watchdog_x10000=-1"
			echo "cpu_total_x10000=-1"
			echo "cpu_daemon_jiffies=-1"
			echo "cpu_watchdog_jiffies=-1"
			echo "cpu_window_ms=-1"
			echo "cpu_instant_active=0"
		fi

		# ---- 3b. 生命周期平均占用（不假零，最该看的指标）----
		#   【为什么必须加这个】守护空闲时每 20 秒才醒一次、每次仅 ~31ms。
		#     若采样窗口（10 秒）短于轮询周期，很可能整段都落在睡眠期，
		#     瞬时值会读成 0.000% —— 那是「这段时间没干活」，不是「不耗电」。
		#     生命周期平均 = 累计 CPU 时间 / 进程已运行时长，
		#     分母足够大，不会假零，反映的是真实长期成本。
		#   ★ 注意：结果通过全局变量 LIFE_PCT / LIFE_RUNSEC 返回，
		#     不能用 $(...) 取 —— 命令替换会 fork 子 shell，
		#     子 shell 里的变量赋值传不回父进程（这里踩过一次坑，
		#     表现为 runsec 永远是 0）。
		HZ_TICK=100
		LIFE_PCT=-1
		LIFE_RUNSEC=0
		# ★★★ v3573：修正口径 + 拆分自身/子进程 ★★★
		#   【问题 1：单位错误导致小 10 倍】
		#     旧代码：LIFE_PCT = (j/hz*1000) / _rs * 10000
		#       j/hz*1000 = 毫秒；但 _rs = (u - s/hz)*100 是【厘秒】，
		#     毫秒 ÷ 厘秒 差了 10 倍，界面显示的 0.2408% 实际是 2.408%。
		#   【问题 2：把历史账本当成当前水平】
		#     旧代码用 $14+$15+$16+$17（含 cutime/cstime）。
		#     cutime/cstime 是【已回收子进程的累计 CPU】，只增不减，
		#     且记的是子进程【活着期间的全部 CPU】，不是 fork 本身的开销。
		#     本机实测：daemon 运行 12.5h，
		#       utime+stime            =  7,657 jiffies → 0.17%
		#       utime+stime+cutime+cstime = 108,022 jiffies → 2.40%
		#     差了 14 倍，93% 都是历史子进程。用这个当“当前占用”
		#     会让用户看到数字随着运行时间上涨，以为模块在“慢慢爬升”。
		#     （实测当前稳态仅自身 0.013%、含子进程 0.107%，比历史均值低 12 倍。）
		#   【改法】
		#     · LIFE_PCT   = 只算 utime+stime（真正属于模块自身，不会膨胀）
		#     · LIFE_CHILD = cutime+cstime（子进程历史累计，单独标注为“历史”）
		#     · 单位统一成毫秒计算，修正 10 倍误差
		_life_calc() {
			local _pid=$1 _self _all _stt _up _rs_ms
			LIFE_PCT=-1
			LIFE_CHILD=-1
			LIFE_RUNSEC=0
			_self=$(awk '{print $14+$15}' "/proc/$_pid/stat" 2>/dev/null)
			_all=$(awk '{print $14+$15+$16+$17}' "/proc/$_pid/stat" 2>/dev/null)
			_stt=$(awk '{print $22}' "/proc/$_pid/stat" 2>/dev/null)
			case "$_self" in ''|*[!0-9]*) return 0 ;; esac
			case "$_all" in ''|*[!0-9]*) return 0 ;; esac
			case "$_stt" in ''|*[!0-9]*) return 0 ;; esac
			_up=$(awk '{print $1}' /proc/uptime)
			# 运行时长统一用【毫秒】，避免单位混用
			_rs_ms=$(awk -v u="$_up" -v s="$_stt" -v hz="$HZ_TICK" 'BEGIN{printf "%d", (u - s/hz)*1000}')
			[ "$_rs_ms" -le 0 ] && return 0
			LIFE_RUNSEC=$(( _rs_ms / 1000 ))
			# 【精度坑】awk 的 “%d” 会先把整个表达式当双精度算完再截断吗？
			#   不是。mawk/busybox awk 在 (j*10)/r*10000 这种表达式上会先算除法
			#   得到一个小数，再乘 10000 时被当作【整数运算】截断为 0。
			#   实测：j=7665 r=45516000 时，正确值是 1684（即 0.1684%），
			#   但 awk 输出了 16 —— 少了 100 倍。
			#   【修法】先把分子放大 1e6 倍再除，保证中间结果是大整数，
			#   然后才除回来；并且显式用 %.0f 而不是 %d。
			# 【单位口径】★ v3578：与瞬时值统一为【百分比 × 10000】。
			#   旧实现这里存的是【百分比 × 1000】（0.1683% 存成 168），而
			#   瞬时值那一路存的是 ×100 的残废值，字段名却都叫 x10000 ——
			#   同一个面板三套口径，是「检测占用」数据看起来不讲理的主因。
			#   现在统一推导：cpu_ms = j×10；run_ms 为分母；
			#     百分比 = (j×10/run_ms)×100；存储值 = 百分比×10000
			#     => 存储值 = (j×10)×1000000/run_ms
			#   实测校验：j=7665 run_ms=45550000 -> 1683（即 0.1683%）✓
			LIFE_PCT=$(awk -v j="$_self" -v r="$_rs_ms" 'BEGIN{ if(r>0) printf "%.0f", (j*10)*1000000/r }')
			LIFE_CHILD=$(awk -v a="$_all" -v s="$_self" -v r="$_rs_ms" 'BEGIN{ if(r>0) printf "%.0f", ((a-s)*10)*1000000/r }')
			case "$LIFE_PCT" in ''|*[!0-9]*) LIFE_PCT=-1 ;; esac
			case "$LIFE_CHILD" in ''|*[!0-9]*) LIFE_CHILD=-1 ;; esac
			return 0
		}
		_dl=-1; _dch=-1; _drun=0
		if [ "$_dh" = "ok" ]; then
			_life_calc "$_dp"; _dl=$LIFE_PCT; _dch=$LIFE_CHILD; _drun=$LIFE_RUNSEC
		fi
		_sl=-1; _sch=-1; _srun=0
		if [ "$_sh" = "ok" ]; then
			_life_calc "$_sp"; _sl=$LIFE_PCT; _sch=$LIFE_CHILD; _srun=$LIFE_RUNSEC
		fi
		echo "cpu_daemon_life_x10000=$_dl"
		echo "cpu_watchdog_life_x10000=$_sl"
		echo "cpu_daemon_child_x10000=$_dch"
		echo "cpu_watchdog_child_x10000=$_sch"
		echo "daemon_runsec=${_drun:-0}"
		echo "watchdog_runsec=${_srun:-0}"
		# ★ v3578：运行不足 120 秒时，启动开销被摊在很小的分母上，
		#   平均值必然虚高。这种样本属于【无效数据】，必须带标志交给前端，
		#   由前端显示「刚启动·样本不足」，而不是画一个会吓人的数字。
		if [ "$_dh" = "ok" ] && [ "${_drun:-0}" -ge 120 ] && [ "$_dl" -ge 0 ]; then
			echo "cpu_daemon_life_valid=1"
		else
			echo "cpu_daemon_life_valid=0"
		fi
		if [ "$_sh" = "ok" ] && [ "${_srun:-0}" -ge 120 ] && [ "$_sl" -ge 0 ]; then
			echo "cpu_watchdog_life_valid=1"
		else
			echo "cpu_watchdog_life_valid=0"
		fi
		if [ "$_dl" -ge 0 ] && [ "$_sl" -ge 0 ]; then
			echo "cpu_total_life_x10000=$(( _dl + _sl ))"
		else
			echo "cpu_total_life_x10000=-1"
		fi
		if [ "$_dch" -ge 0 ] && [ "$_sch" -ge 0 ]; then
			echo "cpu_total_child_x10000=$(( _dch + _sch ))"
		else
			echo "cpu_total_child_x10000=-1"
		fi

		# ---- 4. 暂停标记 ----
		echo "pause_flag=$([ -f "$PAUSE_FLAG" ] && echo 1 || echo 0)"

		# ---- 5. 充电与档位 ----
		local _ol _st _soc
		_ol=""; read -r _ol < /sys/class/power_supply/usb/online 2>/dev/null
		_st=""; read -r _st < /sys/class/power_supply/battery/status 2>/dev/null
		_soc=$(read_soc 2>/dev/null)
		# ★ v3578：读不到的项一律给 -1，前端显示「—」，
		#   不再出现 "?%" / "usb_online=?" 这种半截数据。
		case "$_ol"  in ''|*[!0-9]*) _ol=-1 ;; esac
		case "$_soc" in ''|*[!0-9]*) _soc=-1 ;; esac
		echo "usb_online=${_ol}"
		echo "bat_status=${_st:-—}"
		echo "soc=${_soc}"
		echo "active=$ACTIVE"

		# ---- 6. 判决层残留（最容易出问题的地方）----
		local _t _fa _fv
		for _t in $VOTE_TARGETS; do
			_fa=""; _fv=""
			read -r _fa < "$VOT_ROOT/$_t/force_active" 2>/dev/null
			read -r _fv < "$VOT_ROOT/$_t/force_val" 2>/dev/null
			echo "vot_${_t}_fa=${_fa:-?}"
			echo "vot_${_t}_fv=${_fv:-?}"
		done

		# ---- 7. 日志大小 ----
		local _lsz
		_lsz=$(stat -c %s "$LOG" 2>/dev/null)
		echo "log_bytes=${_lsz:-0}"

		# ---- 8. 版本 ----
		local _mp
		_mp="${0%/*}/../../module.prop"
		[ -f "$_mp" ] || _mp="/data/adb/modules/v2352a_charge_boost/module.prop"
		echo "version=$(sed -n 's/^version=//p' "$_mp" 2>/dev/null)"

		# ---- 9. 综合判定 ----
		#   只在明确异常时报 warn/fail，避免误报吓人。
		local _verdict="ok" _reason=""
		#   ★ v3570 修正：判定一律用【长期平均】口径，不用瞬时值。
		#     【为什么】瞬时窗口 10 秒 < 轮询周期 20 秒，会假零；
		#       反过来刚重启时 jiffies 全落在小分母上，平均又会虚高。
		#     【怎么处理虚高】进程运行不足 120 秒时，启动开销（脚本解析
		#       ~70ms + 初始化）被摊薄在很小的分母上，平均值没有参考意义。
		#       这段时间内只用绝对阈值放宽判定，不报 warn。
		#   ★ v3578：阈值单位随口径一起校正 —— _dl/_sl 现在是「百分比×10000」，
		#     20000 = 2.00%，10000 = 1.00%，5000 = 0.50%。
		#     reason 里也改成真正的百分比文本，不再把原始整数贴上 ‱ 符号。
		_pct_txt() { awk -v v="$1" 'BEGIN{ if(v<0) printf "—"; else printf "%.2f%%", v/10000 }'; }
		if [ "$_dh" = "dead" ]; then
			_verdict="fail"; _reason="守护进程未运行"
		elif [ "$_sh" = "dead" ]; then
			_verdict="warn"; _reason="看门狗未运行（守护仍活着）"
		elif [ "$_beat_age" -ge 0 ] && [ "$_beat_age" -gt 120 ]; then
			_verdict="fail"; _reason="心跳已停 ${_beat_age}s，守护可能卡死"
		elif [ "${_drun:-0}" -lt 120 ]; then
			# 守护刚启动，平均不可信，只做提示不报 warn
			_verdict="ok"; _reason=""
		elif [ "$_dl" -gt 20000 ]; then
			_verdict="warn"; _reason="守护长期占用 $( _pct_txt "$_dl" )（阈值 2.00%）"
		elif [ "$_sl" -gt 10000 ]; then
			_verdict="warn"; _reason="看门狗长期占用 $( _pct_txt "$_sl" )（阈值 1.00%）"
		elif [ "$_ol" != "1" ] && [ "$_dl" -gt 5000 ]; then
			_verdict="warn"; _reason="未插电但守护长期占用 $( _pct_txt "$_dl" )（阈值 0.50%）"
		fi
		echo "verdict=$_verdict"
		echo "reason=$_reason"
		echo "HEALTH_END"
		;;
	debugdump)
		# ============================================================
		#  ★ 调试版新增：一次性导出完整诊断快照 ★
		# ------------------------------------------------------------
		#  用途：出问题时把这一份贴出来就能定位，不用来回追问。
		#  只读：不写任何节点、不改任何配置、不启停守护。
		# ============================================================
		load_profile >/dev/null 2>&1
		echo "=============================================="
		echo " vivo V2352A 充电加速 · 调试快照"
		echo " 版本: $(sed -n 's/^version=//p' "${0%/*}/../../module.prop" 2>/dev/null)"
		echo " 时间: $(date '+%Y-%m-%d %H:%M:%S')"
		echo " 开机: $(read_boot_id)"
		echo "=============================================="
		echo ""
		echo "---- 1. 设备 ----"
		echo "ro.product.model          = $(getprop ro.product.model 2>/dev/null)"
		echo "ro.product.model.bbk      = $(getprop ro.product.model.bbk 2>/dev/null)"
		echo "ro.product.vendor.model   = $(getprop ro.product.vendor.model 2>/dev/null)"
		echo "ro.build.version.release  = $(getprop ro.build.version.release 2>/dev/null)"
		echo "ro.build.version.sdk      = $(getprop ro.build.version.sdk 2>/dev/null)"
		echo "ro.board.platform         = $(getprop ro.board.platform 2>/dev/null)"
		echo "ro.build.display.id       = $(getprop ro.build.display.id 2>/dev/null)"
		echo "uname                     = $(uname -a 2>/dev/null)"
		echo ""
		echo "---- 2. 模块状态 ----"
		echo "档位 ACTIVE       = $ACTIVE ($(profile_name_of "$ACTIVE" 2>/dev/null))"
		echo "守护进程          = $(daemon_running && echo 运行中 || echo 未运行)"
		echo "守护 PID          = $(cat "$PIDFILE" 2>/dev/null)"
		echo "临时解除标记      = $([ -f "$PAUSE_FLAG" ] && echo 存在 || echo 无)"
		echo "设备类别 DEV_CLASS= ${DEV_CLASS:-未探测}"
		echo "注入目标          = ${VOTE_TARGETS:-无}"
		echo "注入量纲          = $(vot_mode_of 2>/dev/null)"
		echo "通道就绪          = $(votable_ready && echo 是 || echo 否)"
		echo "目标选择理由      = ${VOT_SEL_WHY:-—}"
		echo "VOT_WHY           = ${VOT_WHY:-—}"
		echo "手动钉住文件      = $([ -f "$VOT_PIN_FILE" ] && cat "$VOT_PIN_FILE" 2>/dev/null || echo 无)"
		echo ""
		echo "---- 3. 充电实时读数 ----"
		echo "SOC               = $(read_soc)"
		echo "status            = $(cat /sys/class/power_supply/battery/status 2>/dev/null)"
		echo "present           = $(cat /sys/class/power_supply/battery/present 2>/dev/null)"
		echo "vbat (mV)         = $(read_vbat)"
		echo "ibat (µA)         = $(read_ibat "$(read_vbat)")"
		echo "batt current_now  = $(cat /sys/class/power_supply/battery/current_now 2>/dev/null)"
		echo "fastchg_current   = $(cat /sys/class/cms_class/fastchg_current_now 2>/dev/null)"
		echo "adapter_power     = $(cat /sys/class/cms_class/adapter_power 2>/dev/null)"
		echo "vfloat_voltage    = $(cat /sys/class/cms_class/vfloat_voltage 2>/dev/null)"
		echo "板级温度 (0.1C)   = $(read_temp_board)"
		echo "电池温度 (0.1C)   = $(read_temp_batt)"
		echo "充电在线          = $(read_charger_online)"
		echo "输入功率          = $(read_input_power)"
		echo "usb/voltage_now   = $(cat /sys/class/power_supply/usb/voltage_now 2>/dev/null)"
		echo "usb/current_now   = $(cat /sys/class/power_supply/usb/current_now 2>/dev/null)"
		echo "usb/type          = $(cat /sys/class/power_supply/usb/usb_type 2>/dev/null)"
		echo ""
		echo "---- 4. 温度源 ----"
		echo "板级源 = $(read_temp_source)"
		echo "温度描述 = $(read_temp_desc)"
		echo "THERM_STATE = $THERM_STATE  TB_MED=$THERM_TB_MED TC_MED=$THERM_TC_MED"
		echo "THERM_EN=$THERM_EN START=$THERM_START STOP=$THERM_STOP"
		echo ""
		echo "---- 5. DT 表 ----"
		DT_PROBED=""; DT_TABLE_STATE=""; DT_TABLE=""
		if dt_ensure 2>/dev/null; then
			echo "表路径     = $DT_TC_NODE"
			echo "平台       = $DT_PLATFORM"
			echo "命中方式   = $DT_PROBE_HOW"
			echo "老化档     = $(read_aging_stage)"
			echo "循环数     = $(read_aging_cycle)"
			echo "档位边界   = $(dt_aging_boundaries)"
			echo "电压单位   = $(dt_detect_unit "$DT_TC_NODE")"
			echo "分段边界   = ${BASELINE_SEGS_AUTO:-未读取}"
			echo "载入表     = $DT_TABLE"
			echo "DT 额度    = $(dt_restore_value "$(read_aging_stage)")"
			echo "DT 全局上限= $(dt_cur_max)"
		else
			echo "DT 表读取失败（状态=$DT_TABLE_STATE）"
		fi
		echo "cal_max    = $(cal_max)"
		echo "cal_dt_max = $(cal_dt_max)   （本机 DT 标定值）"
		echo "cal_oc     = $CAL_OC   （超频档 0=关 1=开，开启值上限 $CAL_OC_MAX）"
		echo "cal_abs    = $CAL_ABS_HARD   （绝对保护线）"
		echo "restore_ma = $(restore_ma)"
		echo ""
		echo "---- 6. 配置（profile）----"
		echo "I_LOW=$I_LOW I_MID=$I_MID I_PEAK=$I_PEAK I_MID2=$I_MID2 I_LOW2=$I_LOW2"
		echo "VOTE_IBAT=$VOTE_IBAT VOTE_T1..T5=$VOTE_T1/$VOTE_T2/$VOTE_T3/$VOTE_T4/$VOTE_T5"
		echo "SAFE_EN=$SAFE_EN SAFE_CAP=$SAFE_CAP SAFE_LOW=$SAFE_LOW SAFE_MID=$SAFE_MID SAFE_HIGH=$SAFE_HIGH"
		echo "POWER_CAP_W=$POWER_CAP_W"
		echo "profile 文件 = $PROFILE_FILE"
		if [ -f "$PROFILE_FILE" ]; then
			sed 's/^/    /' "$PROFILE_FILE" 2>/dev/null
		else
			echo "    （不存在，走默认值）"
		fi
		echo ""
		echo "---- 7. 判决层全部目标 ----"
		[ -d "$VOT_ROOT" ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
		if [ -d "$VOT_ROOT" ]; then
			echo "根目录 = $VOT_ROOT"
			for _d in "$VOT_ROOT"/*; do
				[ -d "$_d" ] || continue
				_n=${_d##*/}
				echo "[$_n] fa=$(cat "$_d/force_active" 2>/dev/null) fv=$(cat "$_d/force_val" 2>/dev/null)"
				_st=$(cat "$_d/status" 2>/dev/null)
				[ -n "$_st" ] && printf '%s\n' "$_st" | grep -i 'effective' | sed 's/^/    /'
			done
		else
			echo "pmic-votable 不存在"
		fi
		echo ""
		echo "---- 8. sysfs 关键节点 ----"
		echo "fchg_fcc_ma        = $(cat "$NODE" 2>/dev/null)"
		echo "chg_protocol_support = $(cat /sys/class/vfcs_class/chg_protocol_support 2>/dev/null)"
		echo "debug_chg_protocol_support = $(cat /sys/class/vfcs_class/debug_chg_protocol_support 2>/dev/null)"
		echo "fchg_data          = $(cat /sys/class/vfcs_class/fchg_data 2>/dev/null)"
		echo "htccc_enable       = $(cat /sys/class/cms_class/htccc_enable 2>/dev/null)"
		echo "factory_mode_state = $(cat /sys/class/cms_class/factory_mode_state 2>/dev/null)"
		echo "scene_mode/level   = $(cat /sys/class/cms_class/scene_mode 2>/dev/null)/$(cat /sys/class/cms_class/scene_level 2>/dev/null)"
		echo "persist.vivo.*     :"
		for _k in battery_charge_limit all_bypass_charge_support game_bypass_charge_flag ai_charge_rate_support disable_intell_charge; do
			echo "    $_k = $(getprop "persist.vivo.$_k" 2>/dev/null)"
		done
		echo ""
		echo "---- 9. dmesg 关键行（最近 40 条）----"
		dmesg 2>/dev/null | grep -iE 'cms_check_batt_aging|aging_stage|vfcs_update_batt_aging|fchg_fcc|force_active|USER_FCC' | tail -n 40
		echo ""
		echo "---- 10. voter 最近事件 ----"
		dmesg 2>/dev/null | grep -iE 'vfcs-voter' | tail -n 30
		echo ""
		echo "=============================================="
		echo " 快照结束"
		echo "=============================================="
		;;
	probe)

		case "$2" in
			vbat) echo "$(read_vbat)" ;;
			ibat) echo "$(read_ibat "$(read_vbat)")" ;;
			cells) echo "$(read_cells)" ;;
			power)
				pw=$(read_input_power)
				echo "read_input_power -> [$pw]"
				set -- $pw
				echo "  电压=$1  电流=$2  功率=$3mW  来源=$4"
				;;
			*)
				echo "用法: $0 probe {vbat|ibat|cells|power}"
				;;
		esac
		;;
	*)
		echo "用法: $0 {start|stop|pause|resume|restore|status|once|table|power|profile|factory|getjson|setcal|cells|probe|votdiag|votset|debugdump|logs}"
		;;
esac
